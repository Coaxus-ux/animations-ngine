// A hanging paper lantern with a flickering candle.

use "festival-palette.kdl"

scene paper-lantern palette=festival width=16 height=20 fps=12 duration="1s" loop=#true background=sky.base {
    param color "lantern"
    camera -8 -2

    line 0 0 0 2 paint=ink
    rect -2 2 5 1 paint=wood.shade
    ellipse "body" -4 3 9 8 paint=$color shading=dome outline=selective outline-paint=$color.deep emissive=#true
    ellipse -2 4 5 6 paint=$color.hi emissive=#true tone-shift="=-round(wiggle(0.5, 3))"
    line -3 5 -3 8 paint=$color.shade
    line 3 5 3 8 paint=$color.shade
    rect 0 6 1 2 paint=flame.hi emissive=#true visible="=0.5 + wiggle(0.6, 6)"
    rect -2 11 5 1 paint=wood.shade
    rope 0 12 "=wiggle(0.6, 2)" 15 sway="=osc(1s, -0.5, 0.5)" paint=lantern-gold.lit
}

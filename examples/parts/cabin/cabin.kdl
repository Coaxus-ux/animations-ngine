// A log cabin in the snow, its front left corner on the ground at (0, 0).

use "cabin-palette.kdl"

scene cabin palette=aurora width=96 height=72 fps=12 duration="12s" loop=#true background=sky.base {
    camera -8 -64

    particles 60 -58 4 2 count=30 vx=-3 vy=-10 gravity=-1 life="4s" size=2 wind=6 paint=smoke.lit fade=#true
    particles 60 -56 4 2 count=14 vx=-2 vy=-8 life="3s" size=3 wind=5 paint=smoke.base fade=#true

    rect 0 -34 72 34 paint=log shading=dome outline=selective casts-shadow=#true
    rect 0 "=-34 + $k*6" 72 1 paint=log.shade repeat=6
    ellipse -2 "=-33 + $k*6" 4 5 paint=log.lit outline=full outline-paint=log.deep repeat=5

    rect 56 -58 10 30 paint=stone texture=0.4 texture-scale=1.5 shading=dome outline=selective
    polygon -6 -54 points="0,20 42,0 84,20" paint=log.shade shading=dome outline=selective
    polygon -8 -56 points="0,20 6,22 44,3 82,22 88,20 44,-1" paint=snow.lit shading=dome outline=selective
    rect 55 -60 12 3 paint=snow.hi

    rect 12 -26 20 15 paint=window.lit emissive=#true gradient=down gradient-steps=-2
    group 12 -26 20 15 clip=#true {
        ellipse 24 "=-15 + wiggle(2, 0.6)" 8 9 paint=fire.lit emissive=#true tone-shift="=round(wiggle(3, 1))"
        rounded-rect 13 -20 9 10 radius=3 paint=wool.shade shading=dome
        ellipse 17 "=-22 + round(osc(4s, 0, 0.5))" 6 6 paint=skin shading=dome outline=selective
        rect 17 "=-22 + round(osc(4s, 0, 0.5))" 5 2 paint=log.deep
        rect 21 -17 4 3 paint=snow.hi
    }
    rect 21 -26 2 15 paint=log.deep
    rect 12 -19 20 1 paint=log.deep
    rect 10 -27 24 2 paint=log.lit outline=selective
    rect 10 -11 24 2 paint=snow.lit
    light-rect 12 -26 20 15 reach=46 intensity=2.4 color=warm

    rect 44 -24 12 24 paint=log.deep outline=full outline-paint=ink
    rect 53 -13 1 2 paint=window.hi
    line 60 -26 60 -22 paint=ink
    rounded-rect 58 -22 5 6 radius=1 paint=window.hi emissive=#true outline=full outline-paint=ink
    light-point 60 -19 reach=26 intensity="=1.8 + wiggle(2, 0.2)" color=warm
    ellipse 74 -8 6 6 paint=log.lit outline=full outline-paint=log.deep
    ellipse 79 -8 6 6 paint=log.lit outline=full outline-paint=log.deep
    ellipse 76 -13 6 6 paint=log.lit outline=full outline-paint=log.deep
    polygon 72 -15 points="0,3 8,0 15,3 13,4 2,4" paint=snow.hi
}

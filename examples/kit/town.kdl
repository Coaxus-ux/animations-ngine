// Town pieces, each drawn from the middle of its base at (0, 0). Atoms first, then the molecules and
// organisms they build. Every paint is a param, so a scene with its own palette names its own ramps.

use "town-palette.kdl"

part kit-pane paint=glass frame=wood {
    rect -3 -7 7 8 paint=$frame.deep
    rect -2 -6 5 6 paint=$paint.lit emissive=#true gradient=down gradient-steps=-1
    rect -2 -6 5 1 paint=$paint.hi emissive=#true
    rect 0 -6 1 6 paint=$frame.shade
    rect -2 -4 5 1 paint=$frame.shade
}
part kit-sill paint=stone { rect -4 0 9 1 paint=$paint.lit }
part kit-shutter paint=leaf {
    rect 0 -7 2 8 paint=$paint.shade outline=selective
    rect 0 -5 2 1 paint=$paint.deep
    rect 0 -2 2 1 paint=$paint.deep
}
part kit-flowers paint=bloom {
    rect -3 -1 7 2 paint=wood.shade
    rect -3 -2 7 1 paint=leaf.base
    rect -2 -3 1 1 paint=$paint.lit
    rect 0 -3 1 1 paint=$paint.hi
    rect 2 -3 1 1 paint=$paint.lit
}
part kit-door paint=wood {
    rect -4 -11 9 11 paint=$paint.deep
    rounded-rect -3 -10 7 10 radius=2 paint=$paint shading=dome
    rect 0 -9 1 9 paint=$paint.shade
    rect 2 -5 1 1 paint=glass.hi emissive=#true
    rect -5 0 11 1 paint=stone.lit
}
part kit-wall width height paint=plaster beam=wood {
    rect "=-$width/2" "=-$height" $width $height paint=$paint texture=0.25 texture-scale=3 casts-shadow=#true
    shade "=-$width/2" "=-$height" $width 2
    rect "=-$width/2" "=-$height" 1 $height paint=$beam.shade
    rect "=$width/2-1" "=-$height" 1 $height paint=$beam.shade
    rect "=-$width/2 - 1" -2 "=$width+2" 2 paint=stone.shade texture=0.3 texture-scale=2
    rect "=-$width/2 - 1" -2 "=$width+2" 1 paint=stone.base
}
part kit-gable width half rise=9 wall=plaster paint=roof {
    polygon "=-$half" 0 points="0,0 $half,-$rise $width,0" paint=$wall texture=0.25 texture-scale=3
    rect "=-$half" -1 $width 1 paint=wood.shade
    ellipse -2 "=-$rise/2 - 1" 4 4 paint=glass.base emissive=#true
    line "=-$half-3" 2 0 "=-$rise-1" width=3 paint=$paint.base
    line 0 "=-$rise-1" "=$half+3" 2 width=3 paint=$paint.shade
    line "=-$half-3" 1 0 "=-$rise-2" paint=$paint.hi
    line 0 "=-$rise-2" "=$half+3" 1 paint=$paint.lit
}
part kit-chimney height=8 paint=brick smoke=1 {
    particles -1 "=-$height-10" 3 8 count=5 vy=-3 life="4s" size=2 wind=3 paint=smoke.lit fade=#true opacity="=0.5 * $smoke" visible=$smoke
    rect -2 "=-$height" 4 $height paint=$paint.shade texture=0.3 texture-scale=2
    rect -3 "=-$height-1" 6 2 paint=stone.base
}
part kit-trunk height=9 paint=wood {
    polygon -2 0 points="0,0 1,-$height 3,-$height 4,0" paint=$paint.shade
    rect 0 "=-$height" 1 $height paint=$paint.base
    line 1 "=-$height+2" 4 "=-$height-2" paint=$paint.shade
    line 0 "=-$height+3" -4 "=-$height-1" paint=$paint.shade
}
part kit-crown paint=leaf {
    blob 0 -7 circles="-5,3,5 5,3,5 0,-1,7" smooth=2 paint=$paint.shade outline=selective
    blob -1 -8 circles="-3,2,4 4,1,4 0,-2,5" smooth=2 paint=$paint.base shading=dome texture=0.4 texture-scale=2
    blob -2 -11 circles="0,0,2.5 3,-1,2" smooth=1.5 paint=$paint.lit texture=0.3 texture-scale=2
    rect -6 -4 1 1 paint=$paint.lit
    rect 5 -6 1 1 paint=$paint.lit
    rect 2 -3 1 1 paint=$paint.deep
    rect -3 -6 1 1 paint=$paint.deep
}
part kit-post height=22 paint=iron {
    rect 0 "=-$height" 1 $height paint=$paint.lit
    rect -1 -3 3 3 paint=$paint.base
    rect -2 -1 5 1 paint=$paint.lit
    rect -1 "=-$height" 3 1 paint=$paint.lit
}
part kit-lantern paint=glass {
    rect -2 -1 5 1 paint=iron.lit
    rect -1 -2 3 1 paint=iron.base
    rect -2 0 5 4 paint=$paint.base emissive=#true
    rounded-rect -1 0 3 4 radius=1 paint=$paint.hi emissive=#true
    rect -1 4 3 1 paint=iron.lit
}
part kit-picket paint=wood { polygon -1 0 points="0,0 0,-4 1,-5 2,-4 2,0" paint=$paint.lit }

part kit-window paint=glass shutters=leaf {
    kit-shutter -6 0 paint=$shutters
    kit-shutter 5 0 paint=$shutters
    kit-pane 0 0 paint=$paint
    kit-sill 0 1
    slot
}
part kit-tree height=9 crown=1 paint=leaf {
    ellipse -7 -1 15 3 paint=street.deep opacity=0.6
    kit-trunk 0 0 height=$height
    kit-crown 0 "=-$height+2" scale=$crown paint=$paint
}
part kit-fence count=6 paint=wood {
    rect -1 -3 "=$count*3" 1 paint=$paint.base
    kit-picket "=$k*3" 0 paint=$paint repeat=$count
}
part kit-street-lamp height=22 reach=38 {
    kit-post 0 0 height=$height
    kit-lantern 0 "=-$height-5"
    anchor top 0 "=-$height-3"
    light-point 0 "=-$height-3" reach=$reach intensity=2 color=warm
}

part kit-house width=26 height=13 wall=plaster {
    kit-chimney "=$width/4" "=-$height-3"
    kit-wall 0 0 width=$width height=$height paint=$wall
    kit-gable 0 "=-$height" width=$width half="=$width/2" wall=$wall
    kit-door "=-$width/4" 0
    kit-window "=$width/4 - 1" -4 { kit-flowers 0 1 }
    group 0 "=-$height" { slot }
}
part kit-block wall=plaster {
    kit-tree -26 0 crown=0.9
    kit-house 0 0 wall=$wall { slot }
    kit-fence 16 0 count=4
    kit-street-lamp 22 2 id=lamp
}

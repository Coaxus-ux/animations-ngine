// The editor's tool icons, drawn as pixel layers and rendered by the engine (D-012).
// Every scene uses the theme palette; pixels left at "key" are transparent.
use "theme.kdl"

scene "pencil" palette="theme" width=16 height=16 fps=1 duration="1f" background="key.0" {
    pixels "pencil-icon" {
        legend { i "ink.1"; d "ink.0"; a "accent.0"; b "accent.1"; w "warning.0"; p "panel.0"; k "panel.2" }
        cel """
        ................
        ...........ddd..
        ..........dbbbd.
        .........dbbbbd.
        ........diibbd..
        .......diiidd...
        ......diiid.....
        .....diiid......
        ....diiid.......
        ...diiid........
        ..dwiid.........
        ..dwwd..........
        ..ddd...........
        ................
        ................
        ................
        """
    }
}


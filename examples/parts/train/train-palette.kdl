// The night train's palette: a blue night, a dark river, and the warm light from the train that
// turns what it touches into the `lamp` twins.

palette night-train {
    ramp sky "070a1c 0d122a 151c3c 212a52 33406c"
    ramp cloud "141a32 1e2644 2a3458 3a466e 4e5c88"
    ramp mountain "0b0f22 11172e 19213c 242e4c 323e60"
    ramp pine "060c10 0b1418 111e22 1a2a2c 243838"
    ramp river "060b18 0a1224 101b32 182644 22345a"
    ramp stone "141418 1e1e24 2a2a32 383842 4a4a56"
    ramp train "0c1612 14241c 1e3428 2a4636 3a5c48"
    ramp car "1c0c10 2e1418 441e22 5e2a2c 7a3a38"
    ramp iron "08080a 121214 1e1e22 2c2c32 40404a"
    ramp brass "4a3410 7a5a1c b0882c e0b84a fff0a0"
    ramp window "5a3410 9a5c1c d8902e ffc85a fff2b8"
    ramp lamp "8a6a3a e0c070 fff0b0 ffffff"
    ramp skin "3a2018 6a3c2a a0634a d08e6c f0b894"
    ramp hair "120c0a 22160f 3a2618 583a22 7a5230"
    ramp coat "141a2e 1e2844 2c3a5e 3e5080 566aa0"
    ramp paper "8a8070 b8ac94 e0d6bc fff8e6"
    ramp smoke "1a1c26 2a2c38 3e404e 585a6a 7a7c8c"
    ramp firefly "6a8a10 b8e030 f0ff90"
    ramp moon "a8a48c d8d4b8 fffcea"
    ramp ink "030408"
    ramp train-warm "2a2410 40381a 5a5026 786a34 9a8846"
    ramp car-warm "3a1a10 562818 743a22 94502e b66a3e"
    ramp stone-warm "2a2014 3c2e1e 52402a 6a5436 866c46"
    ramp river-warm "1a1410 2a2016 3e2e1c 5a4226 7a5a32"
    ramp pine-warm "14140c 202010 2e2c16 40401e 565428"
    twin train lamp=train-warm
    twin car lamp=car-warm
    twin stone lamp=stone-warm
    twin river lamp=river-warm
    twin pine lamp=pine-warm
}

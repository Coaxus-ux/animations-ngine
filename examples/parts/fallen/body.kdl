    group "lid" {
        anim x {
            k "0s" 0 interp=step
            k "50f" 1 interp=step
            k "51f" 2 interp=step
            k "54f" 1 interp=step
            k "55f" 0 interp=step
            k "62f" 2 interp=step
            k "64f" 0 interp=step
        }
    }
    layer "eye" {
        rect 177 "=@lid.x < 1 ? 66 : 67" 1 "=@lid.x < 1 ? 3 : 1" paint=eye.0 emissive=#true visible="=@lid.x < 2"
        rect 177 70 1 1 paint=eye.0 emissive=#true visible="=@lid.x < 1"
    }

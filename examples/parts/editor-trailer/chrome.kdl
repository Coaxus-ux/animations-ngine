// `pxe edit` at 640×360, redrawn as a scene for the trailer: menu bar, file tab, tool hint,
// the Palette, Layers, Elements and Inspector panels, the timeline, the tool bar and the
// status bar, at the pixel positions the real editor uses at that size. Whatever is open in
// it (the scene in the canvas, its swatches, layers and keys) is drawn by the host on top.

use "editor-palette.kdl"
use "panel-parts.kdl"

motif ed-dive { group "dive" { anim x { k "dive" 0; k "full" 1 interp=ease-in-out } } }
motif ed-colors paint {
    rect 4 311 16 16 paint=ui-ink-hi
    rect 5 312 14 14 paint=$paint emissive=#true
    rect 9 327 16 16 paint=ui-ink-hi
    rect 10 328 14 14 paint=ui-grid
}
motif ed-fields names values visible=1 {
    text $names 492 273 paint=ui-ink visible=$visible
    text $values 549 273 paint=ui-ink-hi visible=$visible
}

scene "editor-chrome" palette=editor width=640 height=360 fps=12 duration="1s" loop=#true background=ui-bar {
    param file "untitled.kdl"
    param tab 112
    param hint "Choose a pixel layer in Layers to paint on (or Layer > New pixel layer)"
    param status "64x64 | zoom 100%"
    param help 200

    rect 0 0 640 14 paint=ui-title
    ed-text "File" 8 2
    ed-text "Edit" 36 2
    ed-text "Sprite" 66 2
    ed-text "Layer" 108 2
    ed-text "Frame" 149 2
    ed-text "Palette" 190 2
    ed-text "View" 238 2
    ed-text "Window" 269 2
    ed-text "Help" 312 2

    polygon 5 16 points="4,0 8,4 7,4 7,8 1,8 1,4 0,4" paint=ui-ink
    rect 16 14 "=$tab" 14 paint=ui-panel
    rect 16 14 "=$tab" 1 paint=ui-accent
    ed-text "$file" 20 17

    rect 0 28 640 15 paint=ui-panel
    text "Pencil" 4 31 paint=ui-accent-hi
    text "$hint" 46 31 paint=ui-warning

    rect 1 45 126 261 paint=ui-panel
    use-scene "panel-title" 0 45 width=127 title="Palette"
    rect 4 57 37 12 paint=ui-raised
    rect 42 57 44 12 paint=ui-title
    rect 87 57 37 12 paint=ui-title
    ed-text "Color" 10 60
    ed-text "Recolor" 45 60
    ed-text "Ramps" 91 60
    rect 1 308 126 39 paint=ui-panel
    rect 30 319 19 11 paint=ui-title
    ed-text "X" 37 321

    rect 131 45 352 207 paint=ui-window

    rect 132 252 350 94 paint=ui-panel
    use-scene "panel-title" 131 252 width=352 title="Timeline"
    use-scene "button" 134 265 width=29 label="Play"
    use-scene "button" 166 265 width=45 label="New cel"
    use-scene "button" 214 265 width=59 label="Delete cel"
    use-scene "button" 276 265 width=48 label="+ Frame"
    use-scene "button" 327 265 width=47 label="- Frame"
    rect 378 268 7 7 paint=ui-ink-hi
    rect 379 269 5 5 paint=ui-panel
    ed-text "Onion" 391 266
    text "frame 1..." 435 266 paint=ui-ink
    rect 132 278 350 10 paint=ui-bar

    rect 487 45 125 101 paint=ui-panel
    use-scene "panel-title" 487 45 width=125 title="Layers"
    use-scene "button" 488 115 width=39 label="New"
    use-scene "button" 529 115 width=40 label="Rename" enabled=#false
    use-scene "button" 570 115 width=40 label="Delete" enabled=#false
    use-scene "button" 489 130 width=59 label="Move up" enabled=#false
    use-scene "button" 550 130 width=60 label="Move down" enabled=#false
    rect 487 146 125 100 paint=ui-panel
    use-scene "panel-title" 487 146 width=125 title="Elements"
    rect 487 247 125 99 paint=ui-panel
    use-scene "panel-title" 487 247 width=125 title="Inspector"

    rect 615 45 25 301 paint=ui-title
    use-scene "tool-bar" 618 48

    rect 0 348 640 12 paint=ui-title
    ed-text "$status" 6 349
    text "|" "=$help - 8" 349 paint=ui-ink
    text "F1: help and shortcuts" "=$help" 349 paint=ui-ink
}

// A lantern festival at night, built from parts: the sky and the street are their own scenes, every
// person is the same `walker` scene placed with its own coat, size, direction and timing, and every
// lantern is a placed scene too.

use "parts/festival/festival-palette.kdl"
use "parts/festival/backdrop.kdl"
use "parts/festival/walker.kdl"
use "parts/festival/sky-lantern.kdl"
use "parts/festival/firework.kdl"

scene town-festival palette=festival width=320 height=180 fps=12 duration="12s" loop=#true seed=21 background=sky.base {
    param crowd 4
    ambient darkness=1 occlusion=1 key-light=270
    wind strength=1 gust=0.5 speed=6

    timeline {
        marker zoom-in at="2s"
        marker close-up at="4s"
        marker zoom-out at="8s"
        marker wide at="10s"
    }

    group focus {
        anim x {
            k "zoom-in" 0
            k "close-up" 1 interp=ease-in-out
            k "zoom-out" 1
            k "wide" 0 interp=ease-in-out
        }
    }
    camera "=(@hero.x - 160) * @focus.x" "=(@hero.y - 22 - 90) * @focus.x" zoom="=1 + 1.6 * @focus.x"

    use-scene festival-sky
    layer lanterns parallax=0.6 {
        use-scene sky-lantern "=24 + i * 38" 118 count=8 offset="=i * 1.5" scale="=0.55 + 0.15 * (i % 3)"
        use-scene firework "=110 + i * 52" "=40 - (i % 2) * 14" count=3 start="=0.4 + i * 0.6" end="=1.9 + i * 0.6"
    }
    use-scene festival-street

    use-scene walker "=mod(t * 100 / 3 + 60 + i * 97, 400) - 40" 150 count="=$crowd" scale=0.75 seed="=i" speed=1.25 offset="=i * 0.3" coat=coat-green hair=hair-brown
    use-scene walker "=360 - mod(t * 100 / 3 + 70 + i * 131, 400)" 154 count=3 flip=#true scale=0.85 speed=1.25 offset="=i * 0.45" coat=coat-gold scarf=coat-red ponytail=#true
    use-scene walker "=mod(t * 100 / 3, 400) - 40" 164 id=hero speed=1.25 coat=coat-red hair=hair-brown scarf=cloth ponytail=#true lantern=#true
    light-point 0 7 attach=hero.carried intensity=2 color=warm
    use-scene walker "=360 - mod(t * 100 / 3 + 210, 400)" 178 flip=#true scale=1.2 speed=1.25 offset="0.5s" coat=coat-blue scarf=lantern-gold
}

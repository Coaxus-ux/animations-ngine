// A night train crossing a stone viaduct over a river. A steam engine pulls three lit
// carriages, each hooked to the one before it with `attach`; its headlamp beam is a light
// attached to the lamp inside the engine. Passengers read and doze behind the windows,
// smoke trails back, the train and its windows are mirrored in the river, fireflies drift
// over the reeds. The camera rides along with the middle carriage and zooms in until one
// passenger fills the frame, turning a page, then pulls back out.
//
// Shows: placed scenes nested three deep (train → carriage → passenger, clipped to each
// window), chains of `attach`, a light attached into a placed scene, colored light twins,
// a reflection limited to the river, parallax layers with fog, particles, ropes as stone
// arches, keyframes on timeline markers and a 4× zoom. Loops every 12 seconds.

use "parts/train/train-palette.kdl"
use "parts/train/locomotive.kdl"
use "parts/train/carriage.kdl"

motif train-star x y tone=base visible=1 { rect $x $y 1 1 paint=moon.$tone emissive=#true visible=$visible }

// Pines stand on the forest floor at y = 124; apex is how far along the width the tip sits
motif train-pine x height apex width tone { polygon $x "=124-$height" points="$apex,0 $width,$height 0,$height" paint=pine.$tone }

motif train-glint x y width speed { rect "=$x + mod(t * $speed, 40) - 20" $y $width 1 paint=river.hi }

motif train-pier x {
    rect $x 112 12 26 paint=stone.base texture=0.3 texture-scale=2 shading=dome outline=selective casts-shadow=#true
    rect "=$x-2" 134 16 4 paint=stone.shade outline=selective
}

motif train-bay x {
    train-pier $x
    rope "=$x+10" 116 "=$x+66" 116 sag=-9 width=5 paint=stone.base texture=0.3 texture-scale=2
}

motif train-reed x top period tone { rope $x 184 "=$x + wind($x) * 4 + osc($period, -1, 1)" $top sway="=osc(4s, -1, 1)" width=2 paint=pine.$tone }

scene "night-train" palette=night-train width=320 height=180 fps=12 duration="12s" loop=#true seed=9 background=sky.base {
    ambient darkness=1 occlusion=1 key-light=250
    wind strength=1 gust=0.5 speed=4

    timeline {
        marker "board" at="3s"
        marker "window" at="5s"
        marker "leave" at="8.5s"
        marker "wide" at="10.5s"
    }

    // The train runs across once per loop; 0 shows the valley, 1 rides with a window
    group "focus" {
        anim x {
            k "board" 0
            k "window" 1 interp=ease-in-out
            k "leave" 1
            k "wide" 0 interp=ease-in-out
        }
    }
    camera "=(@engine.x - 169 - 160) * @focus.x" "=(87 - 90) * @focus.x" zoom="=1 + 3 * @focus.x"

    layer "sky" parallax=0 {
        rect -60 -40 440 180 paint=sky.deep gradient=down gradient-steps=3
        ellipse 238 10 34 34 paint=sky.lit emissive=#true
        ellipse 246 18 18 18 paint=moon.hi emissive=#true
        ellipse 251 23 4 3 paint=moon.base emissive=#true
        scatter 19 seed=1 x="-20..330" y="-10..62" tone="base|base|hi" { train-star $x $y tone=$tone }
        scatter 3 seed=2 x="-20..330" y="-10..62" period="2|3|4" { train-star $x $y visible="=1 - pulse($period, 0.15)" }
    }
    layer "clouds" parallax=0.1 {
        blob "=40 + osc(12s, -6, 6)" 34 circles="0,0,6 9,-3,8 19,0,6 28,2,4" smooth=4 paint=cloud.base shading=dome
        blob "=180 + osc(12s, 5, -5)" 22 circles="0,0,4 8,-2,6 16,1,4" paint=cloud.shade shading=dome
        blob "=290 + osc(6s, -3, 3)" 48 circles="0,0,5 8,-3,6 15,0,5" paint=cloud.base shading=dome
    }
    layer "mountains" parallax=0.25 fog="35%" fog-paint=sky.base {
        polygon -80 60 points="0,50 50,18 90,34 150,4 210,30 260,12 330,40 400,16 480,44 480,70 0,70" paint=mountain.base shading=dome
    }
    layer "forest" parallax=0.5 fog="15%" fog-paint=sky.shade {
        rect -80 110 480 30 paint=pine.base
        scatter 67 seed=3 step="0..2" h="14..28" apex="4|5|6" w="8..13" tone="base|lit|shade|shade" {
            train-pine "=-70 + $k*7 + $step" $h $apex $w $tone
        }
    }

    // The river, with glints drifting downstream
    rect "river" -60 132 440 60 paint=river.base gradient=down gradient-steps=-2
    train-glint 151 175 6 6
    train-glint 28 138 10 6
    train-glint 301 138 9 8
    train-glint 133 172 6 6
    train-glint 278 137 5 8
    train-glint 197 165 4 4
    train-glint 126 151 10 4
    train-glint 14 176 7 4

    // The viaduct: piers, stone arches between them, the deck and its parapet
    train-bay "=-40 + $k*64" repeat=6
    train-pier 344
    rect -60 104 440 10 paint=stone.lit texture=0.3 texture-scale=2 shading=dome outline=selective casts-shadow=#true
    rect -60 103 440 1 paint=iron.lit
    rect "=-60 + $k*10" 112 6 2 paint=stone.shade repeat=44

    // The train: an engine and three carriages, each hooked to the one in front
    use-scene "locomotive" id=engine y=104 {
        anim x loop="repeat" { k "0s" -10; k "12s" 580 }
    }
    use-scene "carriage" -86 id=car-1 attach=engine
    use-scene "carriage" -62 id=car-2 attach=car-1 sleepers=#true
    use-scene "carriage" -62 id=car-3 attach=car-2 color=train
    light-cone 4 2 attach=engine.lamp angle="4deg" spread="30deg" reach=110 intensity=2.6 color=lamp

    // The river mirrors everything above it, rippling
    reflection -60 132 440 60 axis=132 speed=3 on=river

    // Reeds on the near bank, and fireflies drifting over them
    layer "near" parallax=1.3 {
        scatter 16 seed=4 x="-11..339" top="164..174" period="3|4|6" tone="base|deep" { train-reed $x $top $period $tone }
    }
    particles -20 118 360 60 count=26 vy=-3 life="6s" wind=6 paint=firefly.hi emissive=#true fade=#true
}

// A coral reef seen from the sea floor. Sun rays reach down through the water, kelp sways,
// a school of fish crosses the scene, a big fish patrols back and forth, a jellyfish glows
// and bubbles rise from a clam. Shows: cone lights as god rays with a twin color, emissive
// glow with a point light, ropes as kelp, `shade` caustics, fog layers, particles, expressions
// that flip a fish to face where it swims. Loops every 4 seconds.

palette "reef" {
    ramp "water"      "#061a2a" "#0a2840" "#0f3856" "#164a6c" "#1f5e84"
    ramp "water-sun"  "#0e3040" "#165066" "#20708a" "#3090a8" "#48b0c4"
    ramp "sand"       "#2a2c2a" "#3e3e36" "#575444" "#736c54" "#928866"
    ramp "sand-sun"   "#3c4038" "#565a48" "#767660" "#9a967a" "#c0ba98"
    ramp "rock"       "#12181e" "#1c252c" "#28333c" "#36444e" "#485862"
    ramp "rock-sun"   "#1e2a30" "#2c3c42" "#3e5258" "#526c70" "#6a888a"
    ramp "coral"      "#3a1428" "#602038" "#8c3048" "#b84858" "#e06a6c"
    ramp "coral-sun"  "#4a2430" "#743644" "#a44c58" "#d0686a" "#f4907e"
    ramp "amber"      "#3a1c10" "#64301a" "#94482a" "#c46638" "#ec9050"
    ramp "amber-sun"  "#4a2c1c" "#744428" "#a2603a" "#cc824c" "#f2a866"
    ramp "kelp"       "#0c2418" "#133624" "#1c4a30" "#28623e" "#367a4e"
    ramp "kelp-sun"   "#16362a" "#205036" "#2c6a44" "#3c8654" "#52a266"
    ramp "fish"       "#4a3410" "#7a5818" "#b08424" "#e0b03a" "#fcd860"
    ramp "blue-fish"  "#102040" "#1a3466" "#284c8e" "#3a68b4" "#5488d4"
    ramp "jelly"      "#5a2a6a" "#9a50b0" "#d88ee8" "#f8d4ff"
    ramp "bubble"     "#4a8aa8" "#8cc8dc" "#d0f0f8"
    ramp "ink"        "#03080e"
    twin "water" sun="water-sun"
    twin "sand" sun="sand-sun"
    twin "rock" sun="rock-sun"
    twin "coral" sun="coral-sun"
    twin "amber" sun="amber-sun"
    twin "kelp" sun="kelp-sun"
}

scene "coral-reef" palette="reef" width=192 height=128 fps=12 duration="4s" loop=#true seed=17 background="water.base" {
    ambient darkness=1 occlusion=1 key-light=270
    wind strength=1 gust=0.6 speed=3

    // Open water, brighter toward the surface, with a rippling surface line
    layer "water" parallax=0 {
        rect x=0 y=0 width="100%" height=128 paint="water.lit" gradient="down" gradient-steps=-4
        rect x=0 y=0 width="100%" height=3 paint="water.hi"
        rect x="=20 + osc(2s, -3, 3)" y=3 width=18 height=1 paint="water.hi"
        rect x="=76 + osc(4s, 4, -4)" y=4 width=26 height=1 paint="water.hi"
        rect x="=140 + osc(2s, -2, 2)" y=3 width=22 height=1 paint="water.hi"
    }

    // Distant reef walls fade into the blue
    layer "far-reef" parallax=0.3 fog="55%" fog-paint="water.base" {
        blob x=0 y=96 circles="0,0,18 22,-4,14 40,2,16 60,-6,12" smooth=6 paint="rock.shade"
        blob x=120 y=92 circles="0,0,14 18,-8,16 38,-2,18 62,4,14" smooth=6 paint="rock.shade"
        capsule x1=150 y1=80 x2=146 y2=62 radius=2 paint="coral.shade"
        capsule x1=24 y1=86 x2=28 y2=70 radius=2 paint="amber.shade"
    }
    layer "mid-reef" parallax=0.6 fog="25%" fog-paint="water.base" {
        blob x=36 y=104 circles="0,0,12 16,-6,10 30,0,12" smooth=5 paint="rock.base" shading="dome"
        blob x=150 y=106 circles="0,0,10 14,-5,12 28,2,9" smooth=5 paint="rock.base" shading="dome"
        rope x1=60 y1=102 x2="=58 + wind(58) * 4" y2=60 sag=0 sway="=osc(4s, -2, 2)" width=2 paint="kelp.shade"
        rope x1=170 y1=100 x2="=172 + wind(172) * 4" y2=56 sag=0 sway="=osc(4s, 2, -2)" width=2 paint="kelp.shade"
    }

    // The sea floor with caustics dancing on it
    blob "floor" x=0 y=122 circles="0,0,14 30,-3,16 64,1,14 98,-2,16 132,0,14 166,-3,16 196,0,14" smooth=8 paint="sand.base" texture=0.3 texture-scale=3
    rect x=0 y=118 width="100%" height=10 paint="sand.base" texture=0.3 texture-scale=3
    shade x="=30 + osc(4s, -6, 6)" y=114 width=22 height=4 steps=1 round=#true
    shade x="=96 + osc(2s, 5, -5)" y=118 width=18 height=3 steps=1 round=#true
    shade x="=150 + osc(4s, 4, -4)" y=113 width=20 height=4 steps=1 round=#true

    // Rocks and corals in front
    blob "rock" x=8 y=110 circles="0,0,10 12,-4,9 22,2,8" smooth=4 paint="rock.base" shading="dome" outline="selective" texture=0.25 casts-shadow=#true contact-shadow=1
    blob x=128 y=112 circles="0,0,9 11,-3,8" smooth=4 paint="rock.lit" shading="dome" outline="selective" texture=0.25 casts-shadow=#true contact-shadow=1
    capsule x1=60 y1=116 x2=56 y2=96 radius=2 paint="coral.base" shading="dome" outline="selective" casts-shadow=#true
    capsule x1=56 y1=100 x2=48 y2=90 radius=2 paint="coral.base" shading="dome" outline="selective"
    capsule x1=58 y1=104 x2=66 y2=92 radius=2 paint="coral.lit" shading="dome" outline="selective"
    capsule x1=66 y1=94 x2=70 y2=86 radius=1.5 paint="coral.lit" shading="dome" outline="selective"
    blob x=84 y=112 circles="0,0,6 7,-2,5 3,-6,4" smooth=2 paint="amber.base" shading="soft" shading-steps=2 outline="selective" texture=0.3 texture-scale=2 casts-shadow=#true contact-shadow=1
    blob x=172 y=110 circles="0,0,5 6,-1,5 3,-6,4 -3,-4,3" smooth=2 paint="coral.lit" shading="dome" outline="selective" texture=0.3 texture-scale=2 casts-shadow=#true
    ellipse "clam" x=106 y=114 width=12 height=6 paint="rock.lit" shading="dome" outline="full"
    ellipse x=110 y=115 width=3 height=3 paint="bubble.hi" emissive=#true

    // Kelp swaying with the current
    rope x1=20 y1=118 x2="=22 + wind(22) * 6" y2=40 sag=0 sway="=osc(4s, -3, 3)" width=3 paint="kelp.base"
    rope x1=26 y1=118 x2="=30 + wind(30) * 6" y2=56 sag=0 sway="=osc(4s, 2, -2)" width=3 paint="kelp.lit"
    rope x1=140 y1=118 x2="=138 + wind(138) * 6" y2=46 sag=0 sway="=osc(4s, 3, -3)" width=3 paint="kelp.base"
    rope x1=146 y1=118 x2="=150 + wind(150) * 6" y2=62 sag=0 sway="=osc(2s, -2, 2)" width=3 paint="kelp.lit"
    rope x1=186 y1=118 x2="=184 + wind(184) * 5" y2=70 sag=0 sway="=osc(4s, -2, 2)" width=3 paint="kelp.base"

    // A school of small fish crossing, one lap per loop
    ellipse "school" x="=mod(10 + t * 56, 224) - 16" y="=50 + osc(2s, -2, 2)" width=7 height=4 paint="blue-fish.lit" shading="dome" outline="selective"
    polygon x="=@school.x - 3" y="=@school.y" points="0,0 3,2 0,4" paint="blue-fish.base"
    ellipse x="=@school.x - 10" y="=@school.y + 5" width=7 height=4 paint="blue-fish.base" shading="dome" outline="selective"
    polygon x="=@school.x - 13" y="=@school.y + 5" points="0,0 3,2 0,4" paint="blue-fish.shade"
    ellipse x="=@school.x - 6" y="=@school.y - 6" width=7 height=4 paint="blue-fish.lit" shading="dome" outline="selective"
    polygon x="=@school.x - 9" y="=@school.y - 6" points="0,0 3,2 0,4" paint="blue-fish.base"
    ellipse x="=@school.x - 18" y="=@school.y - 1" width=7 height=4 paint="blue-fish.base" shading="dome" outline="selective"
    polygon x="=@school.x - 21" y="=@school.y - 1" points="0,0 3,2 0,4" paint="blue-fish.shade"

    // A big fish patrolling: its tail and eye swap sides with the direction it swims
    ellipse "big-fish" x="=86 + osc(4s, -34, 34)" y="=74 + osc(2s, -2, 2)" width=18 height=10 paint="fish.lit" shading="dome" outline="selective" casts-shadow=#true
    blob x="=@big-fish.x + (cos(t * tau / 4) >= 0 ? -3 : 20)" y="=@big-fish.y + 5" circles="0,-3,2.5 0,3,2.5" smooth=2 paint="fish.base" outline="selective"
    rect x="=@big-fish.x + (cos(t * tau / 4) >= 0 ? 13 : 4)" y="=@big-fish.y + 3" width=1 height=1 paint="ink"
    rect x="=@big-fish.x + 7" y="=@big-fish.y + 1" width=2 height=8 paint="fish.base"

    // A glowing jellyfish drifting up and down
    blob "jelly" x=160 y="=34 + osc(4s, -5, 5)" circles="0,0,6 -3,1,4 3,1,4" smooth=2 paint="jelly.lit" emissive=#true
    rope x1=157 y1="=@jelly.y + 3" x2="=156 + osc(2s, -2, 2)" y2="=@jelly.y + 16" sag=0 sway="=osc(2s, -1, 1)" paint="jelly.base" emissive=#true
    rope x1=160 y1="=@jelly.y + 4" x2="=160 + osc(2s, 2, -2)" y2="=@jelly.y + 19" sag=0 sway="=osc(2s, 1, -1)" paint="jelly.base" emissive=#true
    rope x1=163 y1="=@jelly.y + 3" x2="=164 + osc(2s, -2, 2)" y2="=@jelly.y + 15" sag=0 sway="=osc(2s, -1, 1)" paint="jelly.base" emissive=#true
    light-point x=160 y="=@jelly.y" reach=26 intensity=1.6

    // Sun rays from the surface, slowly breathing
    light-cone x=40 y=-30 angle="80deg" spread="24deg" reach=170 intensity="=2.8 + osc(4s, -0.4, 0.4)" color="sun" shadows=#true
    light-cone x=100 y=-30 angle="84deg" spread="20deg" reach=170 intensity="=2.6 + osc(2s, 0.4, -0.4)" color="sun" shadows=#true
    light-cone x=150 y=-30 angle="78deg" spread="26deg" reach=170 intensity="=3 + osc(4s, 0.3, -0.3)" color="sun" shadows=#true

    // Bubbles rising from the clam
    particles x=108 y=104 width=6 height=8 count=8 vx=0 vy=-24 life="4s" size=1 wind=3 paint="bubble.lit" emissive=#true
    particles x=0 y=0 width="100%" height=128 count=24 vx=1 vy=-2 life="4s" size=1 wind=2 paint="water.hi" fade=#true
}

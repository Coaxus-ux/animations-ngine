// A person walking toward the sunset. Loops every 2 seconds.
// pxe export examples/sunset-walk.kdl --param stride=5

palette "sunset" {
    ramp "sky"  "#2b1846" "#5a2a5e" "#9c3f63" "#e0705a" "#f7b267"
    ramp "sun"  "#ff9f43" "#ffd27a" "#fff1c1"
    ramp "land" "#120c1c" "#1f1530" "#33233f"
    ramp "road" "#3d2340" "#6b3b52" "#a65a5c"
    ramp "ink"  "#07040c"
}

scene "sunset-walk" palette=sunset width=128 height=72 fps=12 duration="2s" loop=#true seed=3 background=sky.hi {
    param stride 4 min=1 max=6

    // Sky bands, darkest at the top
    rect 0 0 "100%" 10 paint=sky.deep
    rect 0 10 "100%" 9 paint=sky.shade
    rect 0 19 "100%" 10 paint=sky.base
    rect 0 29 "100%" 9 paint=sky.lit

    // Sun with a soft glow, sinking behind the hills
    ellipse "glow" 82 24 34 34 paint=sun.base
    ellipse "sun" "=@glow.x + 7" "=@glow.y + 7" 20 20 paint=sun.hi

    // Two birds gliding
    line "bird" "=24 + wiggle(4, 0.5)" "=14 + wiggle(2, 0.5)" "=@self.x1 + 2" "=@self.y1 + 1 + square(t * 2)" paint=land.shade
    line "=@bird.x2" "=@bird.y2" "=@bird.x1 + 4" "=@bird.y1" paint=land.shade
    line "bird2" "=52 + wiggle(3, 0.4)" "=9 + wiggle(2, 0.6)" "=@self.x1 + 2" "=@self.y1 + 1 + square(t * 2 + 0.5)" paint=land.shade
    line "=@bird2.x2" "=@bird2.y2" "=@bird2.x1 + 4" "=@bird2.y1" paint=land.shade

    // Hills on both sides, leaving open sky behind the walker
    ellipse -34 42 56 20 paint=land.shade
    ellipse 60 44 96 18 paint=land.base
    rect 0 52 "100%" 20 paint=land.deep
    rect "road" 0 56 "100%" 10 paint=road.base

    // Road dashes scroll left, so the walker moves toward the sun
    rect "=mod($k * 32 - t * 32, 128) - 8" 61 10 1 paint=road.hi repeat=4

    // The walker: one step every half second, body bobbing up as the legs pass
    ellipse 33 62 16 3 paint=road.deep
    line "back-arm" 40 "=@torso.y + 1" "=40 + 3 * sin(tau * t)" "=@torso.y + 7" paint=ink
    line "back-leg" 40 "=@torso.y + 10" "=40 - $stride * sin(tau * t)" "=63 - 2 * max(0, -cos(tau * t))" paint=ink
    line "=@back-leg.x1 + 1" "=@back-leg.y1" "=@back-leg.x2 + 1" "=@back-leg.y2" paint=ink
    rect "torso" 38 "=43 - abs(cos(tau * t))" 4 10 paint=ink
    ellipse 37 "=@torso.y - 6" 6 6 paint=ink
    line "front-leg" 40 "=@torso.y + 10" "=40 + $stride * sin(tau * t)" "=63 - 2 * max(0, cos(tau * t))" paint=ink
    line "=@front-leg.x1 + 1" "=@front-leg.y1" "=@front-leg.x2 + 1" "=@front-leg.y2" paint=ink
    line 41 "=@torso.y + 1" "=41 - 3 * sin(tau * t)" "=@torso.y + 7" paint=ink
}

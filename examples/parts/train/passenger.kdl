// A passenger seated by a train window, seen from the side facing right, sitting at (0, 0).
// With `reading` they hold a book and turn a page every 3 s; otherwise they doze, the head
// nodding with the rhythm of the rails. `hair` and `coat` set the look.

use "train-palette.kdl"

scene "passenger" palette=night-train width=24 height=24 fps=12 duration="3s" loop=#true background=window.base {
    param hair "hair"
    param coat "coat"
    param reading #true
    camera -12 -20

    group "nod" y="=$reading ? round(osc(3s, 0, 0.6)) : round(1 + osc(1s, 0, 1))"

    // Seat back, torso and arms
    rounded-rect -9 -14 4 14 radius=1 paint=car.shade shading=dome
    rounded-rect -6 -11 9 11 radius=3 paint=$coat shading=dome outline=selective
    capsule 1 -8 6 "=-6 + @nod.y" radius=1.3 paint=$coat.lit visible="=$reading"
    capsule 1 -8 4 -2 radius=1.3 paint=$coat.lit visible="=1 - $reading"

    // Head: hair behind, face, eye that blinks or stays closed
    ellipse -5 "=-19 + @nod.y" 8 8 paint=skin shading=dome outline=selective
    blob -5 "=-19 + @nod.y" circles="2,1,3 0,3,2.5 4,0,2.5" smooth=1.5 paint=$hair shading=dome outline=selective
    rect 0 "=-15 + @nod.y" 1 "=$reading ? 1 - square(t / 3, 0.06) : 0" paint=ink
    line 0 "=-14 + @nod.y" 1 "=-14 + @nod.y" paint=skin.shade visible="=1 - $reading"
    rect 2 "=-13 + @nod.y" 1 1 paint=skin.shade

    // The book, with a page that lifts and turns over
    polygon 4 "=-9 + @nod.y" points="0,0 6,-1 6,4 0,5" paint=paper.lit outline=full outline-paint=car.deep visible="=$reading"
    line 4 "=-9 + @nod.y" 4 "=-4 + @nod.y" paint=car.base visible="=$reading"
    line 4 "=-9 + @nod.y" "=10 - 9 * smoothstep(2.4, 2.9, t)" "=-10 + @nod.y - 2 * sin(pi * smoothstep(2.4, 2.9, t))" paint=paper.hi visible="=$reading && t > 2.3"
    ellipse 5 "=-6 + @nod.y" 3 3 paint=skin visible="=$reading"
}

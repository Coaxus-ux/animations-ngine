// The sword: the blade by the feet, its edge behind the body and the hilt past the head.
// Polygons are stacked largest first, so every shape sits on top of the ones it nests inside.

use "fallen-palette.kdl"

motif fall-steel x y tone outline { polygon $x $y points=$outline paint=steel.$tone }

scene "fallen-sword" palette=fallen width=256 height=170 fps=12 duration="1f" background=night.2 {
    layer "sword" {
        fall-steel 9 138 4 "13,0 14,0 14,3 13,3 13,4 11,4 11,5 10,5 10,6 8,6 8,7 10,7 10,8 14,8 14,11 0,11 0,10 1,10 1,9 2,9 2,8 3,8 4,6 6,6 6,5 7,5 7,4 8,4 9,2 11,2 11,1 13,1"

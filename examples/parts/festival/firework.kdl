// A firework: ten sparks burst out from (0, 0), droop and fade in 1.5 s, then it is gone.

use "festival-palette.kdl"

motif fest-spark dx dy tone {
    line "=@burst.x * $dx * 0.7" "=@burst.x * $dy * 0.7 + @burst.y" "=@burst.x * $dx" "=@burst.x * $dy + @burst.y" paint=$tone.lit emissive=#true visible="=t < 1.1"
    rect "=@burst.x * $dx - 1" "=@burst.x * $dy + @burst.y - 1" 2 2 paint=$tone.hi emissive=#true visible="=t < 1.35"
}

scene firework palette=festival width=96 height=96 fps=12 duration="1.5s" background=sky.base {
    camera -48 -48

    group burst "=40 * (1 - (1 - t / 1.5) ** 2)" "=10 * t * t"
    ellipse -4 -4 9 9 paint=flame.hi emissive=#true visible="=t < 0.25"
    fest-spark 1.0 0.0 lantern-gold
    fest-spark 0.809 0.5878 lantern
    fest-spark 0.309 0.9511 lantern-gold
    fest-spark -0.309 0.9511 lantern
    fest-spark -0.809 0.5878 lantern-gold
    fest-spark -1.0 0.0 lantern
    fest-spark -0.809 -0.5878 lantern-gold
    fest-spark -0.309 -0.9511 lantern
    fest-spark 0.309 -0.9511 lantern-gold
    fest-spark 0.809 -0.5878 lantern
    light-point 0 0 reach=46 intensity="=2 * (1 - t / 1.5)" color=warm
}

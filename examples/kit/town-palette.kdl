// The colors the town kit paints with by default. A scene uses it as it is, or includes it in its own.
palette kit-town {
    ramp night "0a0c22 121634 1c2148 282e5e 3a4078"
    ramp star "8a8fb8 c8cce8 fffbe6"
    ramp moon "8f8c86 bdb698 e2dcbc fffbe6"

// The editor's small row and header icons, drawn as pixel layers and rendered by the engine (D-012).
// Every scene uses the theme palette; pixels left at "key" are transparent.
use "theme.kdl"

scene "eye" palette="theme" width=8 height=8 fps=1 duration="1f" background="key.0" {
    pixels "eye-icon" {
        legend { i "ink.1"; d "ink.0"; a "accent.0"; b "accent.1"; w "warning.0"; p "panel.0"; k "panel.2" }
        cel """
        ........
        ..iiii..
        .i....i.
        i..aa..i
        i..aa..i
        .i....i.
        ..iiii..
        ........
        """
    }
}


// Code becoming pixels: KDL types itself into an editor, line by line in its colors, and
// when the last line lands the scene it describes comes alive beside it: a golden koi swims
// in, a ripple follows it, and the camera dives in until the fish fills the frame.
// Generated by laying the code out with the font's glyph widths.

use "../pond/pond-palette.kdl"
use "../pond/koi.kdl"
use "../pond/lily.kdl"
use "../pond/ripple.kdl"

motif studio-gutter number y from until {
    rect 8 $y 192 11 paint=koi-black.base visible="=t >= $from && t < $until"
    text $number 22 "=$y+2" align=right paint=koi-black.hi
}
motif studio-typed words x y at paint { text $words $x $y paint=$paint reveal="=(t - 0.4) * 54 - $at" }
motif studio-keyword words x y at { studio-typed $words $x $y $at paint=koi-gold.lit }
motif studio-sign words x y at { studio-typed $words $x $y $at paint=koi-white.shade }
motif studio-string words x y at { studio-typed $words $x $y $at paint=lotus.hi }

scene "code" palette=pond width=320 height=180 fps=12 duration="7s" seed=6 background=koi-black.deep {
    timeline {
        marker "run" at="4.42s"
        marker "dive" at="5.02s"
    }
    group "focus" {
        anim x {
            k "dive" 0
            k "6.32s" 1 interp=ease-in-out
        }
    }

    rect 8 14 192 152 paint=koi-black.shade
    rect 8 14 192 10 paint=koi-black.base
    ellipse 12 16 5 5 paint=lacquer.lit
    ellipse 20 16 5 5 paint=koi-gold.base
    ellipse 28 16 5 5 paint=pad.lit
    text "pond" 104 15 align=center paint=koi-white.shade
    studio-gutter "1" 32 0.400 0.881
    studio-gutter "2" 43 0.881 1.437
    studio-gutter "3" 54 1.437 1.956
    studio-gutter "4" 65 1.956 2.344
    studio-gutter "5" 76 2.344 2.715
    studio-gutter "6" 87 2.715 3.067
    studio-gutter "7" 98 3.067 3.456
    studio-gutter "8" 109 3.456 3.789
    studio-gutter "9" 120 3.789 4.085
    studio-gutter "10" 131 4.085 4.122
    studio-typed "// a koi, written as code" 30 34 0 paint=koi-black.hi
    studio-keyword "scene" 30 45 26
    studio-string "\"pond\"" 64 45 32
    studio-typed "palette" 100 45 39 paint=koi-white.lit
    studio-sign "=" 137 45 46
    studio-string "\"pond\"" 143 45 47
    studio-sign "{" 179 45 54
    studio-keyword "use-scene" 38 56 58
    studio-string "\"koi\"" 95 56 68
    studio-typed "id" 120 56 74 paint=koi-white.lit
    studio-sign "=" 128 56 76
    studio-string "\"ogon\"" 134 56 77
    studio-keyword "x" 46 67 88
    studio-sign "=" 52 67 89
    studio-string "\"=t * 8\"" 58 67 90
    studio-typed "y" 101 67 99 paint=koi-white.lit
    studio-sign "=" 107 67 100
    studio-typed "104" 113 67 101 paint=dragonfly.hi
    studio-keyword "body" 46 78 109
    studio-sign "=" 70 78 113
    studio-string "\"koi-gold\"" 76 78 114
    studio-keyword "metallic" 46 89 129
    studio-sign "=" 83 89 137
    studio-typed "#true" 89 89 138 paint=dragonfly.hi
    studio-keyword "use-scene" 38 100 146
    studio-string "\"ripple\"" 95 100 156
    studio-keyword "attach" 46 111 169
    studio-sign "=" 80 111 175
    studio-string "\"ogon\"" 86 111 176
    studio-keyword "camera" 38 122 185
    studio-typed "zoom" 78 122 192 paint=koi-white.lit
    studio-sign "=" 102 122 196
    studio-typed "3" 108 122 197 paint=dragonfly.hi
    studio-sign "}" 30 133 199

    rect 8 146 192 20 paint=koi-black.deep
    text "> pxe watch pond" 14 149 paint=pad.hi reveal="=(t - 4.12) * 60"
    text "ok  watching for changes" 14 158 paint=koi-white.shade visible="=t > 4.42"

    rect 206 14 106 152 paint=water.base
    group 206 14 106 152 clip=#true {
        shade 214 30 40 22 steps=1 round=#true
        shade 262 120 34 18 steps=1 round=#true
        shade 230 74 70 60 round=#true
        use-scene "lily" 286 40 scale=1.2 flower=#true
        use-scene "lily" 226 146 offset="1.5s"
        use-scene "koi" "=236 + (t - 4.42) * 8" 104 id=ogon start=run body=koi-gold metallic=#true
        use-scene "ripple" 2 attach=ogon start=run
    }
    rect 205 14 1 152 paint=koi-black.base
    camera "=(@ogon.x - 22 - 160) * @focus.x" "=(@ogon.y - 90) * @focus.x" zoom="=1 + 2.5 * @focus.x"
}

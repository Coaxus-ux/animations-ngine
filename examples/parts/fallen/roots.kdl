// The nest of roots the warrior lies in: wide root masses first, then the gaps of night between them.
// Polygons are stacked largest first, so every shape sits on top of the ones it nests inside.

use "fallen-palette.kdl"

motif fall-root x y outline paint=root.2 { polygon $x $y points=$outline paint=$paint }
motif fall-root-box x y w=1 h=1 paint=root.2 { fall-root $x $y "0,0 $w,0 $w,$h 0,$h" paint=$paint }

scene "fallen-roots" palette=fallen width=256 height=170 fps=12 duration="1f" background=night.2 {

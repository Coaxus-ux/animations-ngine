// Code becoming pixels: KDL types itself into an editor, line by line in its colors, and
// when the last line lands the scene it describes comes alive beside it: a golden koi swims
// in, a ripple follows it, and the camera dives in until the fish fills the frame.
// Generated by laying the code out with the font's glyph widths.

use "../pond/pond-palette.kdl"
use "../pond/koi.kdl"
use "../pond/lily.kdl"
use "../pond/ripple.kdl"

scene "code" palette="pond" width=320 height=180 fps=12 duration="7s" seed=6 background="koi-black.deep" {
    timeline {
        marker "run" at="4.42s"
        marker "dive" at="5.02s"
    }
    group "focus" {
        anim x {
            k "dive" 0
            k "6.32s" 1 interp="ease-in-out"
        }
    }

    rect x=8 y=14 width=192 height=152 paint="koi-black.shade"
    rect x=8 y=14 width=192 height=10 paint="koi-black.base"
    ellipse x=12 y=16 width=5 height=5 paint="lacquer.lit"
    ellipse x=20 y=16 width=5 height=5 paint="koi-gold.base"
    ellipse x=28 y=16 width=5 height=5 paint="pad.lit"
    text "pond" x=104 y=15 align="center" paint="koi-white.shade"
    rect x=8 y=32 width=192 height=11 paint="koi-black.base" visible="=t >= 0.400 && t < 0.881"
    text "1" x=22 y=34 align="right" paint="koi-black.hi"
    rect x=8 y=43 width=192 height=11 paint="koi-black.base" visible="=t >= 0.881 && t < 1.437"
    text "2" x=22 y=45 align="right" paint="koi-black.hi"
    rect x=8 y=54 width=192 height=11 paint="koi-black.base" visible="=t >= 1.437 && t < 1.956"
    text "3" x=22 y=56 align="right" paint="koi-black.hi"
    rect x=8 y=65 width=192 height=11 paint="koi-black.base" visible="=t >= 1.956 && t < 2.344"
    text "4" x=22 y=67 align="right" paint="koi-black.hi"
    rect x=8 y=76 width=192 height=11 paint="koi-black.base" visible="=t >= 2.344 && t < 2.715"
    text "5" x=22 y=78 align="right" paint="koi-black.hi"
    rect x=8 y=87 width=192 height=11 paint="koi-black.base" visible="=t >= 2.715 && t < 3.067"
    text "6" x=22 y=89 align="right" paint="koi-black.hi"
    rect x=8 y=98 width=192 height=11 paint="koi-black.base" visible="=t >= 3.067 && t < 3.456"
    text "7" x=22 y=100 align="right" paint="koi-black.hi"
    rect x=8 y=109 width=192 height=11 paint="koi-black.base" visible="=t >= 3.456 && t < 3.789"
    text "8" x=22 y=111 align="right" paint="koi-black.hi"
    rect x=8 y=120 width=192 height=11 paint="koi-black.base" visible="=t >= 3.789 && t < 4.085"
    text "9" x=22 y=122 align="right" paint="koi-black.hi"
    rect x=8 y=131 width=192 height=11 paint="koi-black.base" visible="=t >= 4.085 && t < 4.122"
    text "10" x=22 y=133 align="right" paint="koi-black.hi"
    text "// a koi, written as code" x=30 y=34 paint="koi-black.hi" reveal="=(t - 0.4) * 54 - 0"
    text "scene" x=30 y=45 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 26"
    text "\"pond\"" x=64 y=45 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 32"
    text "palette" x=100 y=45 paint="koi-white.lit" reveal="=(t - 0.4) * 54 - 39"
    text "=" x=137 y=45 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 46"
    text "\"pond\"" x=143 y=45 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 47"
    text "{" x=179 y=45 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 54"
    text "use-scene" x=38 y=56 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 58"
    text "\"koi\"" x=95 y=56 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 68"
    text "id" x=120 y=56 paint="koi-white.lit" reveal="=(t - 0.4) * 54 - 74"
    text "=" x=128 y=56 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 76"
    text "\"ogon\"" x=134 y=56 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 77"
    text "x" x=46 y=67 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 88"
    text "=" x=52 y=67 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 89"
    text "\"=t * 8\"" x=58 y=67 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 90"
    text "y" x=101 y=67 paint="koi-white.lit" reveal="=(t - 0.4) * 54 - 99"
    text "=" x=107 y=67 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 100"
    text "104" x=113 y=67 paint="dragonfly.hi" reveal="=(t - 0.4) * 54 - 101"
    text "body" x=46 y=78 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 109"
    text "=" x=70 y=78 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 113"
    text "\"koi-gold\"" x=76 y=78 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 114"
    text "metallic" x=46 y=89 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 129"
    text "=" x=83 y=89 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 137"
    text "#true" x=89 y=89 paint="dragonfly.hi" reveal="=(t - 0.4) * 54 - 138"
    text "use-scene" x=38 y=100 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 146"
    text "\"ripple\"" x=95 y=100 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 156"
    text "attach" x=46 y=111 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 169"
    text "=" x=80 y=111 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 175"
    text "\"ogon\"" x=86 y=111 paint="lotus.hi" reveal="=(t - 0.4) * 54 - 176"
    text "camera" x=38 y=122 paint="koi-gold.lit" reveal="=(t - 0.4) * 54 - 185"
    text "zoom" x=78 y=122 paint="koi-white.lit" reveal="=(t - 0.4) * 54 - 192"
    text "=" x=102 y=122 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 196"
    text "3" x=108 y=122 paint="dragonfly.hi" reveal="=(t - 0.4) * 54 - 197"
    text "}" x=30 y=133 paint="koi-white.shade" reveal="=(t - 0.4) * 54 - 199"

    rect x=8 y=146 width=192 height=20 paint="koi-black.deep"
    text "> pxe watch pond" x=14 y=149 paint="pad.hi" reveal="=(t - 4.12) * 60"
    text "ok  watching for changes" x=14 y=158 paint="koi-white.shade" visible="=t > 4.42" size=1

    rect x=206 y=14 width=106 height=152 paint="water.base"
    group x=206 y=14 width=106 height=152 clip=#true {
        shade x=214 y=30 width=40 height=22 steps=1 round=#true
        shade x=262 y=120 width=34 height=18 steps=1 round=#true
        shade x=230 y=74 width=70 height=60 steps=-1 round=#true
        use-scene "lily" x=286 y=40 scale=1.2 flower=#true
        use-scene "lily" x=226 y=146 offset="1.5s"
        use-scene "koi" id="ogon" x="=236 + (t - 4.42) * 8" y=104 start="run" body="koi-gold" metallic=#true
        use-scene "ripple" attach="ogon" x=2 start="run"
    }
    rect x=205 y=14 width=1 height=152 paint="koi-black.base"
    camera x="=(@ogon.x - 22 - 160) * @focus.x" y="=(@ogon.y - 90) * @focus.x" zoom="=1 + 2.5 * @focus.x"
}

// A camera drifting along a misty lake: parallax layers, fog, gradients, polygons,
// a reflection with ripples, wind-blown reeds and rain. Loops every 4 seconds.

palette "lake" {
    ramp "sky"   "#1d2b45" "#2f4566" "#4d6a8c" "#7896b0" "#a9c2d3"
    ramp "hill"  "#14202e" "#1f3140" "#2d4555" "#41606c" "#5d7f84"
    ramp "pine"  "#0b1714" "#13261f" "#1d3a2c" "#2b513b" "#3f6b4c"
    ramp "water" "#101c2c" "#1a2c42" "#284260" "#3b5c7e" "#5a7f9e"
    ramp "reed"  "#1a1c10" "#2e3418" "#4a5222" "#6c7430" "#949a46"
}

scene "misty-lake" palette=lake width=160 height=90 fps=12 duration="4s" loop=#true seed=11 background=sky.lit {
    wind strength=1.5 gust=0.5 speed=10
    camera { k "0s" x=0; k "2s" x=16 interp="ease-in-out"; k "4s" x=0 interp="ease-in-out" }

    layer "sky" parallax=0 {
        rect 0 0 "100%" 60 paint=sky.base gradient=down gradient-steps=3
        ellipse 104 8 14 14 paint=sky.hi emissive=#true
    }
    layer "far-hills" parallax=0.25 fog="60%" fog-paint=sky.lit {
        polygon -20 24 points="0,30 30,6 52,22 80,0 118,26 150,10 200,30" paint=hill.base gradient=down
    }
    layer "near-hills" parallax=0.5 fog="15%" fog-paint=sky.lit {
        polygon -30 34 points="0,22 40,4 70,16 104,2 140,18 190,8 230,22" paint=hill.shade
        polygon 20 30 points="0,26 6,0 12,26" paint=pine.base
        polygon 31 34 points="0,22 5,0 10,22" paint=pine.shade
        polygon 118 28 points="0,28 7,0 14,28" paint=pine.base
    }
    layer "shore" parallax=1 {
        rect -20 56 220 34 paint=water.base gradient=down gradient-steps=-2
        reflection -20 56 220 34 axis=56 speed=3 on=water
        blob 0 58 circles="0,0,10 14,2,8 26,0,6" smooth=4 paint=hill.deep
        rope 8 60 "=10 + wind(10) * 4" 44 paint=reed.lit
        rope 14 60 "=15 + wind(15) * 5" 40 paint=reed.base
        rope 20 60 "=22 + wind(20) * 4" 46 paint=reed.lit
        capsule "=60 + sin(t * tau / 4) * 2" 60 "=@self.x1 + 18" 60 paint=hill.deep shading=dome outline=selective
    }
    particles -20 -10 200 10 count=60 vx=-6 vy=60 life="0.5s" wind=2 paint=sky.hi opacity=0.7
}

// The built-in default font of `text`, 5×7 pixels: capitals and digits are 7 pixels tall,
// lowercase sits on the same baseline with 2 rows below for descenders. Covers printable
// ASCII, so code can be shown.
// Each glyph lists its 9 rows top to bottom; `#` is ink.

font "5x7" height=9 spacing=1 line-height=11 {
    glyph " " width=3
    glyph "!" "# # # # # . # . ."
    glyph "\"" "#.# #.# ... ... ... ... ... ... ..."
    glyph "#" ".#.#. .#.#. ##### .#.#. ##### .#.#. .#.#. ..... ....."
    glyph "$" "..#.. .#### #.#.. .###. ..#.# ####. ..#.. ..... ....."
    glyph "%" "##..# ##..# ...#. ..#.. .#... #..## #..## ..... ....."
    glyph "&" ".##.. #..#. #.#.. .#... #.#.# #..#. .##.# ..... ....."
    glyph "'" "# # . . . . . . ."
    glyph "(" "..# .#. #.. #.. #.. .#. ..# ... ..."
    glyph ")" "#.. .#. ..# ..# ..# .#. #.. ... ..."
    glyph "*" "..... ..#.. #.#.# .###. #.#.# ..#.. ..... ..... ....."
    glyph "+" "..... ..#.. ..#.. ##### ..#.. ..#.. ..... ..... ....."
    glyph "," ".. .. .. .. .. .# .# #. .."
    glyph "-" ".... .... .... #### .... .... .... .... ...."
    glyph "." ". . . . . . # . ."
    glyph "/" "....# ....# ...#. ..#.. .#... #.... #.... ..... ....."

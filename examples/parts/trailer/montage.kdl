// The examples, framed for the trailer's montage: each is placed scaled up to the full
// 320×180 height (re-rasterized, never resampled) between dark bars, in its own palette.

use "../../neon-rain.kdl"
use "../../lighthouse-harbor.kdl"
use "../../coral-reef.kdl"
use "../../campfire-forest.kdl"
use "../../moonlit-beach.kdl"
use "../../puppy-love.kdl"

scene "framed-neon-rain" palette="neon" width=320 height=180 fps=12 duration="4s" loop=#true background="sky.shade" {
    use-scene "neon-rain" x=25 scale=1.40625
    rect x=0 y=0 width=25 height=180 paint="sky.deep"
    rect x=295 y=0 width=25 height=180 paint="sky.deep"
}

scene "framed-lighthouse-harbor" palette="harbor" width=320 height=180 fps=12 duration="4s" loop=#true background="sky.base" {
    use-scene "lighthouse-harbor" x=25 scale=1.40625
    rect x=0 y=0 width=25 height=180 paint="ink"
    rect x=295 y=0 width=25 height=180 paint="ink"
}

scene "framed-coral-reef" palette="reef" width=320 height=180 fps=12 duration="4s" loop=#true background="water.base" {
    use-scene "coral-reef" x=25 scale=1.40625
    rect x=0 y=0 width=25 height=180 paint="ink"
    rect x=295 y=0 width=25 height=180 paint="ink"
}

scene "framed-campfire-forest" palette="campfire" width=320 height=180 fps=12 duration="2s" loop=#true background="sky.shade" {
    use-scene "campfire-forest" x=25 scale=1.40625
    rect x=0 y=0 width=25 height=180 paint="sky.deep"
    rect x=295 y=0 width=25 height=180 paint="sky.deep"
}

scene "framed-moonlit-beach" palette="moonlit" width=320 height=180 fps=12 duration="4s" loop=#true background="sky.base" {
    use-scene "moonlit-beach" x=25 scale=1.40625
    rect x=0 y=0 width=25 height=180 paint="sky.deep"
    rect x=295 y=0 width=25 height=180 paint="sky.deep"
}

scene "framed-puppy-love" palette="puppy" width=320 height=180 fps=12 duration="2s" loop=#true background="sky.lit" {
    use-scene "puppy-love" x=47 scale=1.40625
    rect x=0 y=0 width=47 height=180 paint="eye.deep"
    rect x=272 y=0 width=48 height=180 paint="eye.deep"
}

// Dusk clouds lit from below by a sun already under the horizon. A `puff` is one lump of cloud,
// its bottom center at (0, 0): a dithered fringe softens its top into the sky, and its outline
// is drawn again lower in rose, orange and gold, so the lit underside shows as stacked bands.
// It bobs and its gold rim shimmers on an 8 s cycle. The clouds stack puffs in tiers from the
// bottom up, so each higher puff lays its lit underside across the body below it; their left
// end is at (0, 0) and a host desynchronizes them with `offset`. `cloud-streak` is a thin band of lit
// stratus for low near the horizon.

use "sunflower-palette.kdl"

motif sun-streak-band y tone texture grain opacity=1 shift=0 {
    blob 0 $y circles="0,-0,1.9 4,-0.7,2 8,-0.4,1.9 12,0.5,1.6 16,0.6,1.4 20,-0.2,1.5 24,-0.7,1.9 28,-0.2,2.3 32,0.6,2.3 36,0.5,2 40,-0.3,1.6 44,-0.7,1.4 48,-0.1,1.6 52,0.7,1.8 56,0.4,1.9 60,-0.4,1.9" paint=cloud.$tone gradient=up gradient-steps=$shift texture=$texture texture-scale=$grain opacity=$opacity
}

scene "puff" palette=sunflower width=32 height=20 fps=12 duration="16s" loop=#true background=sky.3 {
    camera -16 -14
    group "bob" y="=0.6 * sin(tau * t / 8)"
    blob 0 "=@bob.y - 0.8" circles="-8,0,6 -2,-4,8 6,-3,7 11,0,5" paint=cloud.2 opacity=0.5 texture=0.3 texture-scale=2
    blob 0 "=@bob.y + 2.6" circles="-8,0,5 -2,-4,7 6,-3,6 11,0,4" paint=cloud.7 texture=0.5 texture-scale=1 opacity="=0.75 + 0.25 * sin(tau * t / 8 + 1)"
    blob 0 "=@bob.y + 1.7" circles="-8,0,5 -2,-4,7 6,-3,6 11,0,4" paint=cloud.6 texture=0.4 texture-scale=1.5
    blob 0 "=@bob.y + 0.9" circles="-8,0,5 -2,-4,7 6,-3,6 11,0,4" paint=cloud.5 texture=0.35 texture-scale=2
    blob 0 "=@bob.y" circles="-8,0,5 -2,-4,7 6,-3,6 11,0,4" paint=cloud.3 gradient=up gradient-steps=-2 texture=0.3 texture-scale=3
}

scene "cloud-bank" palette=sunflower width=96 height=32 fps=12 duration="16s" loop=#true background=sky.3 {
    camera -12 -22
    use-scene "puff" "=i * 76" 3 count=2 scale=0.45 offset="=i * 3 + 5"
    use-scene "puff" "=12 + i * 16" "=2 + 1.5 * rand(i + 7)" count=4 scale="=0.75 + 0.2 * rand(i + 3)" offset="=i * 2.3 + 1"
    use-scene "puff" "=18 + i * 14" "=-6 - 2 * sin(i * 1.9)" count=4 scale="=0.9 + 0.3 * rand(i)" offset="=i * 1.7"
    use-scene "puff" "=28 + i * 18" "=-13 - 2 * rand(i + 11)" count=2 scale="=0.7 + 0.2 * rand(i + 13)" offset="=i * 3.1 + 2"
}

scene "cloud-heap" palette=sunflower width=64 height=44 fps=12 duration="16s" loop=#true background=sky.3 {
    camera -8 -34
    use-scene "puff" "=4 + i * 18" "=1 + 3 * sin(i * 2.2)" count=3 scale="=0.8 + 0.2 * rand(i + 9)" offset="=i * 2.9 + 3"
    use-scene "puff" "=10 + i * 22" "=-7 - 4 * i" count=2 scale="=0.9 + 0.2 * rand(i + 2)" offset="=i * 2.1"
    use-scene "puff" 20 -17 scale=1.1 offset=4
    use-scene "puff" 40 -21 scale=0.6 offset=7
}

scene "cloud-wisp" palette=sunflower width=48 height=16 fps=12 duration="16s" loop=#true background=sky.5 {
    camera -6 -10
    use-scene "puff" "=4 + i * 8" "=-sin(i * 1.3)" count=4 scale="=0.42 + 0.1 * rand(i)" offset="=i * 1.9"
}

scene "cloud-streak" palette=sunflower width=80 height=10 fps=12 duration="16s" loop=#true background=sky.6 {
    camera -8 -5
    sun-streak-band 1.4 7 0.5 1 opacity="=0.7 + 0.3 * sin(tau * t / 8)"
    sun-streak-band 0.6 6 0.4 1.5
    sun-streak-band -0.4 4 0.3 2 shift=-1
}

// A camera drifting along a misty lake: parallax layers, fog, gradients, polygons,
// a reflection with ripples, wind-blown reeds and rain. Loops every 4 seconds.

palette "lake" {
    ramp "sky"   "#1d2b45" "#2f4566" "#4d6a8c" "#7896b0" "#a9c2d3"
    ramp "hill"  "#14202e" "#1f3140" "#2d4555" "#41606c" "#5d7f84"
    ramp "pine"  "#0b1714" "#13261f" "#1d3a2c" "#2b513b" "#3f6b4c"
    ramp "water" "#101c2c" "#1a2c42" "#284260" "#3b5c7e" "#5a7f9e"
    ramp "reed"  "#1a1c10" "#2e3418" "#4a5222" "#6c7430" "#949a46"
}

scene "misty-lake" palette="lake" width=160 height=90 fps=12 duration="4s" loop=#true seed=11 background="sky.lit" {
    wind strength=1.5 gust=0.5 speed=10
    camera { k "0s" x=0; k "2s" x=16 interp="ease-in-out"; k "4s" x=0 interp="ease-in-out" }

    layer "sky" parallax=0 {
        rect x=0 y=0 width="100%" height=60 paint="sky.base" gradient="down" gradient-steps=3
        ellipse x=104 y=8 width=14 height=14 paint="sky.hi" emissive=#true
    }
    layer "far-hills" parallax=0.25 fog="60%" fog-paint="sky.lit" {
        polygon x=-20 y=24 points="0,30 30,6 52,22 80,0 118,26 150,10 200,30" paint="hill.base" gradient="down"
    }
    layer "near-hills" parallax=0.5 fog="15%" fog-paint="sky.lit" {
        polygon x=-30 y=34 points="0,22 40,4 70,16 104,2 140,18 190,8 230,22" paint="hill.shade"
        polygon x=20 y=30 points="0,26 6,0 12,26" paint="pine.base"
        polygon x=31 y=34 points="0,22 5,0 10,22" paint="pine.shade"
        polygon x=118 y=28 points="0,28 7,0 14,28" paint="pine.base"
    }
    layer "shore" parallax=1 {
        rect x=-20 y=56 width=220 height=34 paint="water.base" gradient="down" gradient-steps=-2
        reflection x=-20 y=56 width=220 height=34 axis=56 ripple=1 speed=3 tone-shift=-1 on="water"
        blob x=0 y=58 circles="0,0,10 14,2,8 26,0,6" smooth=4 paint="hill.deep"
        rope x1=8 y1=60 x2="=10 + wind(10) * 4" y2=44 sag=0 width=1 paint="reed.lit"
        rope x1=14 y1=60 x2="=15 + wind(15) * 5" y2=40 sag=0 width=1 paint="reed.base"
        rope x1=20 y1=60 x2="=22 + wind(20) * 4" y2=46 sag=0 width=1 paint="reed.lit"
        capsule x1="=60 + sin(t * tau / 4) * 2" y1=60 x2="=@self.x1 + 18" y2=60 radius=2 paint="hill.deep" shading="dome" outline="selective"
    }
    particles x=-20 y=-10 width=200 height=10 count=60 vx=-6 vy=60 life="0.5s" size=1 wind=2 paint="sky.hi" opacity=0.7
}

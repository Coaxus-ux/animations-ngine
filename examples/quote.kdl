// A quote told as a small story. In the rain one figure points at another kneeling under a hard
// light; then the arm drops, the accuser walks over and kneels beside them, and the sun comes up.

use "parts/trailer/studio-palette.kdl"
use "parts/quote/quote-palette.kdl"
use "parts/quote/verse.kdl"

scene quote palette=quote width=320 height=180 fps=12 duration="20s" seed=5 background=night.deep {
    timeline {
        marker judgment at="0.5s"
        marker mercy at="9.5s"
    }

    group accuse "=smoothstep(0.4, 1.1, t) * (1 - smoothstep(7.6, 8.6, t))"
    group approach "=smoothstep(9, 12, t)"
    group stride "=step(9, t) * step(t, 12) * sin(tau * t * 1.5)"
    group kneel "=smoothstep(12, 12.8, t)"
    group comfort "=smoothstep(12.7, 13.6, t)"
    group rise "=smoothstep(13.4, 15, t)"
    group dawn "=smoothstep(10.5, 16, t)"
    group storm "=1 - smoothstep(8.2, 10.8, t)"
    group push "=smoothstep(17.4, 19.6, t)"

    ambient darkness="=1 - @dawn.x"
    camera "=76 * @push.x" "=36 * @push.x" zoom="=1 + @push.x"

    rect 0 0 320 141 paint=night.shade gradient=down gradient-steps=2
    rect 0 58 320 44 paint=dawn.deep opacity="=0.55 * @dawn.x"
    rect 0 100 320 24 paint=dawn.shade opacity="=0.8 * @dawn.x"
    rect 0 122 320 19 paint=dawn.base opacity="=0.9 * @dawn.x"
    ellipse "=236 - 40" "=168 - 46 * @dawn.x - 40" 80 80 paint=dawn.lit opacity="=0.45 * @dawn.x" emissive=#true
    ellipse "=236 - 22" "=168 - 46 * @dawn.x - 22" 44 44 paint=sun.lit emissive=#true
    ellipse "=236 - 16" "=168 - 46 * @dawn.x - 16" 32 32 paint=sun.hi emissive=#true

    ellipse -40 126 150 40 paint=earth.shade
    ellipse 70 132 120 26 paint=earth.shade
    ellipse 250 130 130 30 paint=earth.shade
    rect 0 140 320 40 paint=earth.base texture=0.3 texture-scale=3

    polygon 246 0 points="-9,0 9,0 30,140 -30,140" paint=rose.shade opacity="=0.3 * @storm.x"
    ellipse 214 136 64 9 paint=rose.shade opacity="=0.55 * @storm.x"

    group accuser x="=64 + 166 * @approach.x" y=140 {
        capsule 0 "=-14 + 8 * @kneel.x" "=-5 * @stride.x" 0 radius=1.6 paint=coat.shade
        capsule 1 -2 -9 -2 radius=1.5 paint=coat.shade visible="=@kneel.x > 0.5"
        capsule 0 "=-14 + 8 * @kneel.x" "=5 * @stride.x + 2 * @kneel.x" 0 radius=1.6 paint=coat.base
        capsule 0 "=-15 + 8 * @kneel.x" "=2 * @comfort.x" "=-26 + 8 * @kneel.x" radius=3.6 paint=coat.lit
        polygon -4 "=-17 + 8 * @kneel.x" points="0,0 8,0 10,6 -1,6" paint=coat.base
        ellipse "=-3 + 3 * @comfort.x" "=-36 + 8 * @kneel.x + @comfort.x" 8 8 paint=skin.lit
        ellipse "=-4 + 3 * @comfort.x" "=-37 + 8 * @kneel.x + @comfort.x" 8 5 paint=coat.shade
        capsule arm "=1 + 2 * @comfort.x" "=-25 + 8 * @kneel.x" "=2 + 11 * max(@accuse.x, @comfort.x)" "=-15 + 8 * @kneel.x - 10 * @accuse.x - 5 * @comfort.x" radius=1.4 paint=coat.hi
        ellipse "=@arm.x2" "=@arm.y2 - 1" 3 3 paint=skin.lit
    }

    group accused x=246 y=140 {
        capsule -2 -2 9 -2 radius=1.5 paint=cloth.shade
        capsule 0 -6 "=-4 + 3 * @rise.x" "=-16 - 2 * @rise.x" radius=3.4 paint=cloth.lit
        capsule "=-4 + 3 * @rise.x" "=-15 - 2 * @rise.x" -5 -4 radius=1.3 paint=cloth.hi
        ellipse "=-11 + 5 * @rise.x" "=-22 - 5 * @rise.x + round(wiggle(0.7, 3) * (1 - @rise.x))" 8 8 paint=skin.lit
        ellipse "=-10 + 5 * @rise.x" "=-23 - 5 * @rise.x + round(wiggle(0.7, 3) * (1 - @rise.x))" 8 5 paint=earth.deep
    }

    reflection 0 141 320 39 axis=140 ripple=1 speed=2 tone-shift=-1 opacity=0.45

    particles -20 -30 380 150 vx=-24 vy=170 streak="0.05s" count=140 life="1s" paint=rain.lit opacity="=@storm.x"
    particles 0 60 320 90 vy=-7 count=36 life="3s" fade=#true paint=sun.lit emissive=#true opacity="=@dawn.x"

    light-cone 246 10 reach=170 intensity="=3 * @storm.x" angle=90 spread=34
    light-point 236 "=168 - 46 * @dawn.x" reach=130 intensity="=2 * @dawn.x"

    use-scene verse start=judgment end="8.5s" opening="THE SINS YOU" closing="DON'T COMMIT," bridge="you call" verdict="EVIL" accent=rose verdict-size=5
    use-scene verse start=mercy end="17.5s" opening="THE SINS YOU" closing="DO COMMIT," bridge="you call" verdict="BEING HUMAN" accent=gold verdict-size=3
}

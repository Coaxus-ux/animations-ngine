// A koi pond seen from above on a spring afternoon. Koi of five varieties swim at two depths
// (the deeper ones fade into the water), under lily pads, lotus flowers and a red bridge;
// a frog rides a drifting pad, ripples spread, cherry petals float by, a dragonfly darts and
// the shade of a maple sways with sunlight dappling through it. The camera dives in on the
// golden ogon and follows it, three times closer, then rises again.
//
// Shows: parts (`use`), placed scenes with params, copies, flips, speeds and offsets; layers
// with fog for depth; `attach` (a frog and ripples riding lily pads); a timeline with
// markers driving the zoom; shade as caustics, dappled light and cast shadows; particles,
// ropes in the wind, textures and dome shading. Loops every 12 seconds.

use "parts/pond/pond-palette.kdl"
use "parts/pond/koi.kdl"
use "parts/pond/lily.kdl"
use "parts/pond/ripple.kdl"
use "parts/pond/frog.kdl"
use "parts/pond/dragonfly.kdl"

scene "koi-pond" palette="pond" width=320 height=180 fps=12 duration="12s" loop=#true seed=5 background="water.base" {
    ambient occlusion=1 key-light=225
    wind strength=1 gust=0.6 speed=5

    timeline {
        marker "dive" at="2.5s"
        marker "close" at="4.5s"
        marker "rise" at="8s"
        marker "wide" at="10s"
    }

    // 0 shows the whole pond, 1 follows the ogon three times closer
    group "focus" {
        anim x {
            k "dive" 0
            k "close" 1 interp="ease-in-out"
            k "rise" 1
            k "wide" 0 interp="ease-in-out"
        }
    }
    camera x="=(@ogon.x - 22 - 160) * @focus.x" y="=(@ogon.y - 90) * @focus.x" zoom="=1 + 2 * @focus.x"

    // The pond floor, seen through the water: pebbles, sunken stones and waterweed
    layer "floor" parallax=1 fog="50%" fog-paint="water.shade" {
        rect x=-80 y=-60 width=480 height=300 paint="floor.base" texture=0.35 texture-scale=4
        ellipse x=97 y=46 width=6 height=4 paint="floor.lit" shading="dome"
        ellipse x=276 y=38 width=5 height=4 paint="floor.hi" shading="dome"
        ellipse x=-7 y=82 width=3 height=3 paint="floor.lit" shading="dome"
        ellipse x=178 y=34 width=5 height=4 paint="floor.hi" shading="dome"
        ellipse x=207 y=102 width=3 height=3 paint="stone.base" shading="dome"
        ellipse x=-2 y=55 width=5 height=4 paint="floor.hi" shading="dome"
        ellipse x=84 y=45 width=3 height=3 paint="floor.shade" shading="dome"
        ellipse x=182 y=115 width=3 height=3 paint="floor.hi" shading="dome"
        ellipse x=114 y=97 width=3 height=3 paint="floor.lit" shading="dome"
        ellipse x=203 y=91 width=5 height=4 paint="floor.shade" shading="dome"
        ellipse x=148 y=146 width=4 height=4 paint="floor.hi" shading="dome"
        ellipse x=266 y=117 width=4 height=3 paint="floor.shade" shading="dome"
        ellipse x=169 y=140 width=6 height=5 paint="floor.shade" shading="dome"
        ellipse x=199 y=36 width=5 height=4 paint="floor.hi" shading="dome"
        ellipse x=253 y=46 width=5 height=4 paint="floor.lit" shading="dome"
        ellipse x=326 y=36 width=5 height=4 paint="floor.shade" shading="dome"
        ellipse x=102 y=72 width=5 height=4 paint="stone.base" shading="dome"
        ellipse x=5 y=38 width=4 height=3 paint="floor.lit" shading="dome"
        ellipse x=2 y=117 width=6 height=4 paint="stone.base" shading="dome"
        ellipse x=82 y=76 width=6 height=5 paint="floor.lit" shading="dome"
        ellipse x=319 y=72 width=5 height=4 paint="stone.base" shading="dome"
        ellipse x=1 y=126 width=4 height=3 paint="floor.hi" shading="dome"
        ellipse x=123 y=145 width=5 height=4 paint="floor.hi" shading="dome"
        ellipse x=142 y=97 width=7 height=5 paint="stone.base" shading="dome"
        ellipse x=291 y=62 width=5 height=4 paint="floor.shade" shading="dome"
        ellipse x=226 y=75 width=4 height=3 paint="floor.lit" shading="dome"
        ellipse x=43 y=56 width=4 height=3 paint="stone.base" shading="dome"
        ellipse x=279 y=50 width=4 height=3 paint="floor.hi" shading="dome"
        ellipse x=131 y=74 width=5 height=4 paint="floor.hi" shading="dome"
        ellipse x=229 y=93 width=5 height=4 paint="floor.lit" shading="dome"
        ellipse x=144 y=139 width=7 height=5 paint="stone.base" shading="dome"
        ellipse x=123 y=77 width=5 height=4 paint="stone.base" shading="dome"
        ellipse x=2 y=35 width=4 height=3 paint="floor.hi" shading="dome"
        ellipse x=20 y=104 width=3 height=3 paint="floor.hi" shading="dome"
        blob x=70 y=120 circles="0,0,7 9,-2,6 4,5,5" smooth=3 paint="stone.base" shading="dome" texture=0.3 texture-scale=2 outline="selective"
        blob x=190 y=60 circles="0,0,7 9,-2,6 4,5,5" smooth=3 paint="stone.base" shading="dome" texture=0.3 texture-scale=2 outline="selective"
        blob x=290 y=130 circles="0,0,7 9,-2,6 4,5,5" smooth=3 paint="stone.base" shading="dome" texture=0.3 texture-scale=2 outline="selective"
        rope x1=30 y1=150 x2="=30 + wind(30) * 8 + osc(4s, -3, 3)" y2=110 sag=0 sway="=osc(3s, -3, 3)" width=2 paint="pad.shade"
        rope x1=44 y1=154 x2="=44 + wind(44) * 8 + osc(4s, -2, 2)" y2=124 sag=0 sway="=osc(3s, -3, 3)" width=2 paint="pad.shade"
        rope x1=150 y1=152 x2="=150 + wind(150) * 8 + osc(4s, -1, 1)" y2=116 sag=0 sway="=osc(3s, -3, 3)" width=2 paint="pad.shade"
        rope x1=208 y1=30 x2="=208 + wind(208) * 8 + osc(4s, -3, 3)" y2=64 sag=0 sway="=osc(3s, -3, 3)" width=2 paint="pad.shade"
        rope x1=300 y1=40 x2="=300 + wind(300) * 8 + osc(4s, -2, 2)" y2=70 sag=0 sway="=osc(3s, -3, 3)" width=2 paint="pad.shade"
        rope x1=118 y1=32 x2="=118 + wind(118) * 8 + osc(4s, -1, 1)" y2=58 sag=0 sway="=osc(3s, -3, 3)" width=2 paint="pad.shade"
        shade x="=170 + osc(6s, -8, 8)" y="=135 + osc(4s, 4, -4)" width=25 height=8 steps=1 round=#true
        shade x="=40 + osc(6s, -8, 8)" y="=61 + osc(4s, 4, -4)" width=22 height=9 steps=1 round=#true
        shade x="=198 + osc(6s, -8, 8)" y="=136 + osc(4s, 4, -4)" width=25 height=10 steps=1 round=#true
        shade x="=153 + osc(6s, -8, 8)" y="=52 + osc(4s, 4, -4)" width=23 height=11 steps=1 round=#true
        shade x="=155 + osc(6s, -8, 8)" y="=71 + osc(4s, 4, -4)" width=18 height=8 steps=1 round=#true
        shade x="=230 + osc(6s, -8, 8)" y="=114 + osc(4s, 4, -4)" width=23 height=9 steps=1 round=#true
    }

    // Deep koi, slower and further down
    layer "deep" parallax=1 fog="30%" fog-paint="water.shade" {
        use-scene "koi" count=2 x="=mod(t * 220 / 6 + i * 210, 440) - 60" y="=72 + i * 46 + 6 * sin(tau * t / 6 + i)" scale=0.7 speed=0.75 offset="=i * 0.4" body="koi-black" patch="koi-white"
        use-scene "koi" flip=#true x="=380 - mod(t * 110 / 3 + 120, 440)" y="=108 + 5 * sin(tau * t / 4)" scale=0.75 speed=0.75 body="koi-orange" patch="koi-gold"
    }

    // Koi near the surface
    use-scene "koi" id="ogon" x="=mod(t * 110 / 3 + 40, 440) - 60" y="=96 + 10 * sin(tau * t / 6)" scale=1.25 body="koi-gold" patch="koi-gold" metallic=#true
    use-scene "koi" flip=#true x="=380 - mod(t * 110 / 3 + 60, 440)" y="=58 + 8 * sin(tau * t / 6 + 2)" scale=1.1 speed=1.25 body="koi-white" patch="koi-red"
    use-scene "koi" flip=#true x="=380 - mod(t * 110 / 3 + 260, 440)" y="=134 + 6 * sin(tau * t / 4)" scale=1 body="koi-white" patch="koi-red" spotted=#true offset="0.3s"
    use-scene "koi" x="=mod(t * 110 / 3 + 250, 440) - 60" y="=48 + 6 * sin(tau * t / 4 + 1)" scale=0.95 speed=1.25 body="koi-black" patch="koi-red" offset="0.6s"
    use-scene "koi" x="=mod(t * 110 / 3 + 330, 440) - 60" y="=122 + 8 * sin(tau * t / 6 + 3)" scale=1.05 body="koi-orange" patch="koi-white" offset="0.2s"

    // Shade of a maple leaning over the pond, swaying, with sunlight dappling through it
    shade x="=-30 + osc(4s, -3, 3)" y=-20 width=150 height=90 steps=-1 round=#true
    shade x="=60 + osc(4s, 2, -2)" y=-30 width=110 height=70 steps=-1 round=#true
    shade x="=210 + osc(6s, -2, 2)" y=120 width=140 height=90 steps=-1 round=#true
    shade x="=20 + osc(4s, -3, 3)" y="=18 + osc(6s, -2, 2)" width=14 height=9 steps=1 round=#true
    shade x="=58 + osc(4s, -3, 3)" y="=30 + osc(6s, 2, -2)" width=10 height=7 steps=1 round=#true
    shade x="=92 + osc(4s, -2, 2)" y="=8 + osc(6s, -1, 1)" width=12 height=8 steps=1 round=#true
    shade x="=246 + osc(6s, -2, 2)" y="=146 + osc(4s, 2, -2)" width=12 height=8 steps=1 round=#true

    // Lily pads; a frog rides one, ripples spread from others
    use-scene "lily" id="pad-a" x=96 y=70 scale=1.4 flower=#true
    use-scene "lily" id="pad-b" x=118 y=86 scale=1.1
    use-scene "lily" id="pad-c" x=84 y=92 scale=0.9 offset="1s"
    use-scene "lily" id="pad-d" x=206 y=118 scale=1.3 offset="2s" flower=#true
    use-scene "lily" x=228 y=104 scale=0.9 offset="3s"
    use-scene "lily" id="pad-e" x=176 y=52 scale=1.2 offset="1.5s"
    use-scene "lily" x=20 y=96 scale=1 offset="0.5s" flower=#true
    use-scene "lily" x=300 y=78 scale=1.2 offset="2.5s"
    use-scene "frog" attach="pad-b" y=-1 scale=0.9
    use-scene "ripple" attach="pad-e" offset="0.5s"
    use-scene "ripple" attach="pad-c" offset="1.2s" scale=0.8
    use-scene "ripple" count=2 x="=150 + i * 110" y="=128 - i * 72" offset="=i * 0.9" scale=0.9

    // Banks: moss and stones above, stepping stones below
    polygon x=-20 y=0 points="0,0 360,0 360,16 320,20 280,15 240,22 200,17 160,24 120,18 80,23 40,17 0,22" paint="moss" texture=0.4 texture-scale=2 shading="dome" outline="selective"
    blob x=-10 y=16 circles="0,0,5.9 7,1,3.7" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=32 y=20 circles="0,0,5.5 7,1,3.6" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=72 y=15 circles="0,0,5.7 7,1,4.0" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=115 y=17 circles="0,0,4.4 7,1,4.1" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=150 y=18 circles="0,0,5.2 7,1,4.6" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=193 y=16 circles="0,0,4.5 7,1,3.8" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=234 y=16 circles="0,0,5.0 7,1,4.5" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=276 y=19 circles="0,0,4.9 7,1,3.4" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    blob x=311 y=17 circles="0,0,5.6 7,1,4.4" smooth=2 paint="stone" shading="dome" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    polygon x=-20 y=158 points="0,8 40,2 80,6 120,0 160,5 200,1 240,6 280,0 320,4 360,2 360,30 0,30" paint="moss" texture=0.4 texture-scale=2 shading="dome" outline="selective"
    blob x=30 y=156 circles="0,0,6 5,2,5" smooth=2 paint="stone.lit" shading="dome" texture=0.25 texture-scale=2 outline="selective"
    blob x=64 y=160 circles="0,0,6 5,2,5" smooth=2 paint="stone.lit" shading="dome" texture=0.25 texture-scale=2 outline="selective"
    blob x=98 y=154 circles="0,0,6 5,2,5" smooth=2 paint="stone.lit" shading="dome" texture=0.25 texture-scale=2 outline="selective"
    blob x=132 y=159 circles="0,0,6 5,2,5" smooth=2 paint="stone.lit" shading="dome" texture=0.25 texture-scale=2 outline="selective"
    line x1=112 y1=14 x2="=112 + wind(112) * 2 + 1" y2=10 paint="moss.hi"
    line x1=73 y1=6 x2="=73 + wind(73) * 2 + 1" y2=2 paint="moss.hi"
    line x1=153 y1=11 x2="=153 + wind(153) * 2 + 1" y2=7 paint="moss.hi"
    line x1=267 y1=5 x2="=267 + wind(267) * 2 + 1" y2=1 paint="moss.hi"
    line x1=153 y1=175 x2="=153 + wind(153) * 2 + 1" y2=171 paint="moss.hi"
    line x1=28 y1=175 x2="=28 + wind(28) * 2 + 1" y2=171 paint="moss.hi"
    line x1=128 y1=13 x2="=128 + wind(128) * 2 + 1" y2=9 paint="moss.hi"
    line x1=318 y1=173 x2="=318 + wind(318) * 2 + 1" y2=169 paint="moss.hi"
    line x1=258 y1=176 x2="=258 + wind(258) * 2 + 1" y2=172 paint="moss.hi"
    line x1=210 y1=8 x2="=210 + wind(210) * 2 + 1" y2=4 paint="moss.hi"

    // A stone lantern on the far bank
    rect x=36 y=2 width=14 height=14 paint="stone.shade" outline="full" outline-paint="ink"
    polygon x=34 y=0 points="9,0 18,7 9,14 0,7" paint="stone.lit" shading="dome" outline="selective"
    rect x=41 y=5 width=4 height=4 paint="lamp.hi" emissive=#true

    // The red bridge, with its shadow on the water
    rect x=252 y=-10 width=34 height=200 paint="water.deep" opacity=0.5
    rect x=244 y=-10 width=30 height=200 paint="wood.lit" texture=0.3 texture-scale=2 outline="selective" casts-shadow=#true
    line x1=245 y1=-8 x2=272 y2=-8 paint="wood.shade"
    line x1=245 y1=-2 x2=272 y2=-2 paint="wood.shade"
    line x1=245 y1=4 x2=272 y2=4 paint="wood.shade"
    line x1=245 y1=10 x2=272 y2=10 paint="wood.shade"
    line x1=245 y1=16 x2=272 y2=16 paint="wood.shade"
    line x1=245 y1=22 x2=272 y2=22 paint="wood.shade"
    line x1=245 y1=28 x2=272 y2=28 paint="wood.shade"
    line x1=245 y1=34 x2=272 y2=34 paint="wood.shade"
    line x1=245 y1=40 x2=272 y2=40 paint="wood.shade"
    line x1=245 y1=46 x2=272 y2=46 paint="wood.shade"
    line x1=245 y1=52 x2=272 y2=52 paint="wood.shade"
    line x1=245 y1=58 x2=272 y2=58 paint="wood.shade"
    line x1=245 y1=64 x2=272 y2=64 paint="wood.shade"
    line x1=245 y1=70 x2=272 y2=70 paint="wood.shade"
    line x1=245 y1=76 x2=272 y2=76 paint="wood.shade"
    line x1=245 y1=82 x2=272 y2=82 paint="wood.shade"
    line x1=245 y1=88 x2=272 y2=88 paint="wood.shade"
    line x1=245 y1=94 x2=272 y2=94 paint="wood.shade"
    line x1=245 y1=100 x2=272 y2=100 paint="wood.shade"
    line x1=245 y1=106 x2=272 y2=106 paint="wood.shade"
    line x1=245 y1=112 x2=272 y2=112 paint="wood.shade"
    line x1=245 y1=118 x2=272 y2=118 paint="wood.shade"
    line x1=245 y1=124 x2=272 y2=124 paint="wood.shade"
    line x1=245 y1=130 x2=272 y2=130 paint="wood.shade"
    line x1=245 y1=136 x2=272 y2=136 paint="wood.shade"
    line x1=245 y1=142 x2=272 y2=142 paint="wood.shade"
    line x1=245 y1=148 x2=272 y2=148 paint="wood.shade"
    line x1=245 y1=154 x2=272 y2=154 paint="wood.shade"
    line x1=245 y1=160 x2=272 y2=160 paint="wood.shade"
    line x1=245 y1=166 x2=272 y2=166 paint="wood.shade"
    line x1=245 y1=172 x2=272 y2=172 paint="wood.shade"
    line x1=245 y1=178 x2=272 y2=178 paint="wood.shade"
    line x1=245 y1=184 x2=272 y2=184 paint="wood.shade"
    rect x=241 y=-10 width=4 height=200 paint="lacquer" shading="dome" outline="selective"
    rect x=273 y=-10 width=4 height=200 paint="lacquer" shading="dome" outline="selective"
    rect x=240 y=4 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=272 y=4 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=240 y=40 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=272 y=40 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=240 y=76 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=272 y=76 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=240 y=112 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=272 y=112 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=240 y=148 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=272 y=148 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=240 y=184 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"
    rect x=272 y=184 width=6 height=5 paint="lacquer.lit" outline="full" outline-paint="lacquer.deep"

    // Petals drifting on the surface, and a dragonfly
    particles x=-40 y=20 width=380 height=140 count=22 vx=5 vy=1 life="12s" size=1 wind=3 paint="petal.lit"
    particles x=-40 y=20 width=380 height=140 count=10 vx=4 vy=1.5 life="6s" size=2 wind=2 paint="petal.base"
    use-scene "dragonfly" x=150 y=40 scale=1.1
}

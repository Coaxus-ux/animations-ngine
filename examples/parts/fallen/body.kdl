// The curled-up body: skin in two tones, bloodied bandages, the headband and the dark creases.
// The open eye blinks twice every loop.
// Polygons are stacked largest first, so every shape sits on top of the ones it nests inside.

use "fallen-palette.kdl"

motif fall-body x y tone outline { polygon $x $y points=$outline paint=$tone }
motif fall-body-box x y tone w=1 h=1 { fall-body $x $y $tone "0,0 $w,0 $w,$h 0,$h" }

scene "fallen-body" palette=fallen width=256 height=170 fps=12 duration="6s" loop=#true background=night.2 {
    layer "body" {
        fall-body 96 86 skin.3 "5,0 6,0 6,8 4,8 4,7 0,6 0,4 1,4 1,3 3,3 3,2 4,2"
        fall-body 68 112 skin.3 "4,0 6,0 6,1 10,1 10,2 13,2 13,1 15,1 15,0 16,0 16,4 15,4 15,5 13,5 13,6 12,6 12,8 11,8 10,10 2,10 2,8 1,8 1,6 0,6 0,2 2,2 2,1 4,1"
        fall-body 67 122 skin.3 "3,0 10,0 10,1 8,2 8,4 7,4 7,6 6,6 6,8 5,8 4,10 2,10 2,8 1,8 1,6 0,6 0,4 2,3 2,1 3,1"

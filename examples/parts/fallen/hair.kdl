// The dark, matted hair falling over the face.
// Polygons are stacked largest first, so every shape sits on top of the ones it nests inside.

use "fallen-palette.kdl"

motif fall-hair x y outline paint=steel.2 { polygon $x $y points=$outline paint=$paint }
motif fall-hair-box x y w=1 h=1 paint=steel.2 { fall-hair $x $y "0,0 $w,0 $w,$h 0,$h" paint=$paint }

scene "fallen-hair" palette=fallen width=256 height=170 fps=12 duration="1f" background=night.2 {
    layer "hair" {
        fall-hair 183 38 "5,0 7,0 7,1 8,1 8,3 6,4 6,6 5,6 5,7 3,6 3,4 2,4 2,6 1,6 0,4 1,4 2,2 4,2"
        fall-hair 191 37 "3,0 6,0 6,1 8,1 8,0 9,0 9,3 8,3 8,7 7,7 7,4 6,4 6,2 4,2 4,4 3,4 3,2 2,2 2,4 0,5 0,2 1,2 1,1 3,1"
        fall-hair 196 45 "1,0 2,0 2,3 4,3 4,5 3,5 3,6 1,6 1,4 0,4"
        fall-hair 200 37 "0,0 2,0 2,2 6,2 6,3 8,4 8,11 7,11 7,10 6,10 6,12 5,12 5,11 2,11 2,12 1,12 1,14 0,14 0,11 1,11 1,9 2,9 2,8 6,8 6,7 7,7 7,5 3,5 3,6 2,6 2,5 0,5"
        fall-hair 208 42 "0,0 4,1 4,4 6,4 6,7 8,7 8,8 9,8 9,10 6,10 6,11 5,11 5,9 2,9 2,7 1,7 1,9 0,9 0,4 1,4 1,3 0,3"
        fall-hair 202 50 "1,0 2,0 2,1 3,1 3,0 5,1 5,2 4,2 4,4 6,3 6,7 4,6 4,8 3,8 3,2 2,2 2,3 0,4"
        fall-hair 208 52 "0,0 1,0 1,5 3,5 4,3 7,3 7,5 6,5 6,6 5,6 5,7 3,8 4,10 1,10 2,8 0,7"
        fall-hair 208 62 "0,0 5,0 6,2 7,2 7,1 10,1 10,2 9,2 9,3 6,3 6,4 4,4 3,6 1,6 1,5 2,5 2,4 3,4 4,2 3,2 3,1 0,1"
        fall-hair 210 68 "0,0 4,1 4,3 5,3 5,4 4,4 3,6 1,5 1,4 3,4 3,3 2,3 2,2 1,2"
        fall-hair 200 58 "6,0 7,0 7,2 6,2 6,4 5,4 5,5 3,6 3,8 8,8 8,9 6,9 5,11 3,11 4,9 0,9 0,8 1,8 1,7 2,7 2,5 3,5 3,4 2,4 2,2 4,3 4,2 5,2"
        fall-hair 199 69 "3,0 6,0 6,1 7,1 7,3 5,4 5,5 7,5 7,6 5,6 5,9 4,9 4,10 9,10 9,11 3,12 3,11 1,10 1,8 3,8 3,7 0,7 0,6 2,6 2,5 3,5 3,4 5,3 5,1 4,1 4,2 2,2"
        fall-hair 189 49 "1,0 2,0 3,6 4,6 4,5 6,4 6,8 7,8 7,7 8,7 8,5 10,4 10,7 11,7 11,8 13,9 13,10 12,10 12,11 11,11 10,13 9,13 9,9 5,11 5,8 4,8 4,10 3,10 2,4 0,5 0,1 1,1"
        fall-hair 190 43 "1,0 2,0 2,3 3,3 3,5 2,5 2,6 1,6 1,4 0,4"
        fall-hair 215 68 "1,0 3,0 2,4 0,3 0,1 1,1"
        fall-hair 198 81 "0,0 3,0 3,1 5,1 5,3 4,3 4,2 2,2 2,1 0,1"
        fall-hair 193 47 "1,0 2,0 2,2 1,2 1,4 0,4 0,1 1,1"
        fall-hair 211 77 "2,0 3,0 3,2 0,2 0,1 2,1"
        fall-hair 209 81 "0,0 3,0 3,2 2,2 2,1 0,1"
        fall-hair 216 52 "1,0 2,0 2,2 0,2"
        fall-hair 215 57 "0,0 1,0 2,2 0,2"
        fall-hair-box 204 84 w=3
        fall-hair 208 84 "0,0 2,0 2,2 1,2"
        fall-hair-box 209 46 w=2 paint=night.2
        fall-hair-box 194 42 w=2
        fall-hair-box 217 56 w=2
        fall-hair-box 205 87 w=2
        fall-hair-box 206 45 paint=night.2
        fall-hair-box 208 45 paint=night.2
        fall-hair-box 215 50 paint=night.2
        fall-hair-box 218 67 paint=steel.4
        fall-hair-box 201 51
        fall-hair-box 215 54
        fall-hair-box 204 58
        fall-hair-box 203 59
        fall-hair-box 214 59
        fall-hair-box 201 62
        fall-hair-box "=197 - $k" "=75 + $k" repeat=3
        fall-hair-box 208 80
        fall-hair-box 192 84
        fall-hair-box 193 85
        fall-hair-box 207 85
        fall-hair-box "=210 - $k" "=87 + $k" repeat=3
        fall-hair-box 218 70 paint=steel.3
    }
}

// Two lovers by a campfire on the beach, watching the sea under a full moon. She rests her head
// on his shoulder, his arm around her; the fire warms them while the moon silvers the water,
// a dolphin leaps across the face of the moon, and the waves lap the shore.
// Shows: two light colors at once (warm fire, silver moon), a dolphin whose body follows the
// tangent of its arc through reference helpers, a rippling moon path, timed splashes,
// hair and palm fronds moved by the wind. Loops every 4 seconds.

palette "moonlit" {
    ramp "sky"          "#0d0f2e" "#181b4a" "#262a66" "#383c82" "#5052a0"
    ramp "sky-moon"     "#1a1c42" "#2a2c62" "#3e4082" "#5658a2" "#7476c2"
    ramp "moon"         "#b8c4dc" "#e2e8f4" "#ffffff"
    ramp "sea"          "#020c14" "#041724" "#082436" "#0e344c" "#164866"
    ramp "sea-moon"     "#06141e" "#0c2232" "#163448" "#244a62" "#38667e"
    ramp "foam"         "#6a86a8" "#a8c0d8" "#e0ecf8"
    ramp "sand"         "#2a2430" "#3e3440" "#564856" "#70606c" "#8c7a84"
    ramp "sand-warm"    "#3a2420" "#583428" "#7a4a34" "#a06642" "#c88a56"
    ramp "sand-moon"    "#2e3040" "#444858" "#5e6474" "#7c8494" "#a0a8b8"
    ramp "wood"         "#140e0c" "#22180f" "#342414" "#48321c" "#5e4426"
    ramp "wood-warm"    "#2a1206" "#4a210a" "#6e3410" "#964c17" "#c06a20"
    ramp "palm"         "#06100e" "#0c1a16" "#132620" "#1c342c" "#284438"
    ramp "dolphin"      "#1a2a40" "#2a405e" "#3e5a80" "#5678a0" "#7698c0"
    ramp "dolphin-moon" "#2a3a52" "#3e5474" "#58749a" "#7896bc" "#9cbadc"
    ramp "shirt"        "#3a3a48" "#5a5a6c" "#82828e" "#aaaab4" "#d0d0d8"
    ramp "shirt-warm"   "#4a3226" "#70503a" "#9a7252" "#c49a70" "#ecc496"
    ramp "dress"        "#3a1020" "#5e1a30" "#8a2a44" "#b83e58" "#e05a70"
    ramp "dress-warm"   "#4a1418" "#742424" "#a23a30" "#cc5640" "#f27a52"
    ramp "hair"         "#0e0a0e" "#1c1418" "#2c2026" "#3e2e34" "#524048"
    ramp "hair-warm"    "#1e0e08" "#341a0e" "#4e2a16" "#6c3c20" "#8c522c"
    ramp "brunette"     "#0e0806" "#170e0a" "#22150f" "#2f1d15" "#3d271c"
    ramp "brunette-warm" "#170c08" "#22130c" "#311c12" "#432719" "#573322"
    ramp "skin"         "#4a2c22" "#6e4433" "#946049" "#b87e60" "#d9a07c"
    ramp "skin-warm"    "#5a2c18" "#844126" "#ad5c36" "#d27c48" "#f0a060"
    ramp "blanket"      "#1e1a34" "#2c264c" "#3c3466" "#4e4482" "#64589e"
    ramp "blanket-warm" "#3a1e22" "#5a2c2c" "#7c3e38" "#a25446" "#c86e56"
    ramp "fire"         "#7a2e0e" "#c8521a" "#f08a24" "#ffc65a" "#fff1b8"
    ramp "rose"         "#a83a5a" "#e05a80" "#ff9ab8"
    twin "sky" moon="sky-moon"
    twin "sea" moon="sea-moon"
    twin "sand" warm="sand-warm" moon="sand-moon"
    twin "dolphin" moon="dolphin-moon"
    twin "wood" warm="wood-warm"
    twin "shirt" warm="shirt-warm"
    twin "dress" warm="dress-warm"
    twin "hair" warm="hair-warm"
    twin "brunette" warm="brunette-warm"
    twin "skin" warm="skin-warm"
    twin "blanket" warm="blanket-warm"
}

scene "moonlit-beach" palette="moonlit" width=192 height=128 fps=12 duration="4s" loop=#true seed=14 background="sky.base" {
    ambient darkness=1 occlusion=1 key-light=300
    wind strength=1 gust=0.5 speed=4

    // Sky: a deep gradient, a glowing full moon, thin clouds and twinkling stars
    layer "sky" parallax=0 {
        rect x=0 y=0 width="100%" height=60 paint="sky.deep" gradient="down" gradient-steps=3
        ellipse x=125 y=27 width=24 height=24 paint="sky.lit" emissive=#true
        ellipse "moon" x=128 y=30 width=18 height=18 paint="moon.lit" emissive=#true
        ellipse x=131 y=33 width=4 height=3 paint="moon.base" emissive=#true
        ellipse x=138 y=39 width=3 height=3 paint="moon.base" emissive=#true
        rect x=136 y=33 width=1 height=1 paint="moon.base" emissive=#true
        rect x=131 y=40 width=2 height=1 paint="moon.base" emissive=#true
        blob x="=40 + osc(4s, -3, 3)" y=22 circles="0,0,3 8,-1,4 18,0,3 26,1,2" smooth=4 paint="sky.lit" shading="dome"
        blob x="=160 + osc(4s, 2, -2)" y=14 circles="0,0,2 6,-1,3 13,0,2" smooth=3 paint="sky.lit" shading="dome"
        rect x=14 y=8 width=1 height=1 paint="moon.hi" emissive=#true visible="=chance(0.85, mod(floor(t * 3), 12))"
        rect x=36 y=36 width=1 height=1 paint="moon.base" emissive=#true visible="=chance(0.8, mod(floor(t * 3), 12) + 1)"
        rect x=66 y=12 width=1 height=1 paint="moon.hi" emissive=#true visible="=chance(0.9, mod(floor(t * 3), 12) + 2)"
        rect x=88 y=30 width=1 height=1 paint="moon.base" emissive=#true visible="=chance(0.8, mod(floor(t * 3), 12) + 3)"
        rect x=100 y=6 width=1 height=1 paint="moon.hi" emissive=#true
        rect x=172 y=34 width=1 height=1 paint="moon.base" emissive=#true visible="=chance(0.85, mod(floor(t * 3), 12) + 4)"
        rect x=184 y=10 width=1 height=1 paint="moon.hi" emissive=#true visible="=chance(0.8, mod(floor(t * 3), 12) + 5)"
        rect x=6 y=44 width=1 height=1 paint="moon.base" emissive=#true
    }
    light-rect x=0 y=0 width=192 height=128 reach=1 intensity=1.2 color="moon"

    // The sea, with a path of glints under the moon and its reflection
    rect "sea" x=0 y=60 width="100%" height=40 paint="sea.lit" gradient="down" gradient-steps=-2
    rect x=0 y=59 width="100%" height=1 paint="sky.hi" emissive=#true
    rect x=0 y=60 width="100%" height=1 paint="sea.deep"
    rect x=126 y=64 width=6 height=1 paint="foam.hi" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24))"
    rect x=138 y=66 width=5 height=1 paint="foam.hi" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 1)"
    rect x=130 y=70 width=7 height=1 paint="foam.lit" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 2)"
    rect x=142 y=74 width=6 height=1 paint="foam.hi" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 3)"
    rect x=124 y=78 width=8 height=1 paint="foam.lit" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 4)"
    rect x=136 y=82 width=9 height=1 paint="foam.hi" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 5)"
    rect x=122 y=86 width=7 height=1 paint="foam.lit" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 6)"
    rect x=146 y=88 width=8 height=1 paint="foam.lit" emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + 7)"
    rect x="=40 + osc(4s, -4, 4)" y=68 width=14 height=1 paint="sea.lit"
    rect x="=80 + osc(2s, 3, -3)" y=76 width=18 height=1 paint="sea.lit"
    rect x="=20 + osc(4s, 3, -3)" y=84 width=22 height=1 paint="sea.lit"
    rect x="=170 + osc(2s, -3, 3)" y=80 width=16 height=1 paint="sea.lit"

    // A dolphin leaps across the moon once per loop. `jump` holds the arc's progress (x)
    // and the angle of its tangent (y); the body is drawn along that angle.
    rect "jump" x="=clamp((t - 0.8) / 1.6, 0, 1)" y="=atan2(-30 * pi * cos(pi * @self.x), 60)" width=1 height=1 paint="sea.base" visible=0
    rect "arc" x="=108 + 60 * @jump.x" y="=66 - 30 * sin(pi * @jump.x)" width=1 height=1 paint="sea.base" visible=0
    group "dolphin" {
        capsule x1="=@arc.x" y1="=@arc.y" x2="=@arc.x + cos(@jump.y) * 6" y2="=@arc.y + sin(@jump.y) * 6" radius=4 paint="dolphin.shade" shading="dome" outline="selective" visible="=between(0.8s, 2.4s)"
        capsule x1="=@arc.x" y1="=@arc.y" x2="=@arc.x - cos(@jump.y) * 10" y2="=@arc.y - sin(@jump.y) * 10" radius=2.5 paint="dolphin.shade" shading="dome" outline="selective" visible="=between(0.8s, 2.4s)"
        capsule x1="=@arc.x + cos(@jump.y) * 6" y1="=@arc.y + sin(@jump.y) * 6" x2="=@arc.x + cos(@jump.y) * 12" y2="=@arc.y + sin(@jump.y) * 12" radius=1.5 paint="dolphin.base" visible="=between(0.8s, 2.4s)"
        polygon x="=@arc.x + sin(@jump.y) * 3" y="=@arc.y - cos(@jump.y) * 3" points="-3,0 1,-7 4,0" paint="dolphin.deep" visible="=between(0.8s, 2.4s)"
        blob x="=@arc.x - cos(@jump.y) * 13" y="=@arc.y - sin(@jump.y) * 13" circles="0,-3,2 0,3,2" smooth=1.5 paint="dolphin.deep" visible="=between(0.8s, 2.4s)"
    }
    ellipse "splash-in" x="=108 - @self.width / 2" y=64 width="=4 + (t - 0.7) * 40" height=3 paint="foam.lit" visible="=between(0.7s, 1.1s)"
    rect x=104 y="=62 - sin(pi * (t - 0.7) / 0.4) * 6" width=1 height=1 paint="foam.hi" visible="=between(0.7s, 1.1s)"
    rect x=112 y="=62 - sin(pi * (t - 0.7) / 0.4) * 8" width=1 height=1 paint="foam.hi" visible="=between(0.7s, 1.1s)"
    ellipse "splash-out" x="=168 - @self.width / 2" y=64 width="=4 + (t - 2.3) * 40" height=3 paint="foam.lit" visible="=between(2.3s, 2.7s)"
    rect x=164 y="=62 - sin(pi * (t - 2.3) / 0.4) * 7" width=1 height=1 paint="foam.hi" visible="=between(2.3s, 2.7s)"
    rect x=172 y="=62 - sin(pi * (t - 2.3) / 0.4) * 5" width=1 height=1 paint="foam.hi" visible="=between(2.3s, 2.7s)"

    // The moon's path on the water: rippling silver dashes, wider near the shore
    rect x="=131 + osc(2s, -1, 1)" y=62 width=12 height=1 paint="moon.lit" emissive=#true
    rect x="=129 + osc(2s, 1, -1)" y=64 width=16 height=1 paint="moon.base" emissive=#true
    rect x="=133 + osc(1s, -1, 1)" y=66 width=9 height=1 paint="moon.lit" emissive=#true
    rect x="=128 + osc(2s, -2, 2)" y=69 width=18 height=1 paint="moon.base" emissive=#true
    rect x="=132 + osc(1s, 1, -1)" y=72 width=11 height=1 paint="moon.lit" emissive=#true
    rect x="=126 + osc(2s, 2, -2)" y=75 width=22 height=1 paint="moon.base" emissive=#true
    rect x="=131 + osc(1s, -2, 2)" y=79 width=13 height=1 paint="moon.lit" emissive=#true
    rect x="=124 + osc(2s, -2, 2)" y=83 width=26 height=1 paint="moon.base" emissive=#true
    rect x="=130 + osc(1s, 2, -2)" y=87 width=15 height=1 paint="moon.base" emissive=#true

    // The shore: lapping foam over wet sand, then the dry beach
    rect x=0 y=92 width="100%" height=36 paint="sand.base" texture=0.2 texture-scale=3 gradient="down" gradient-steps=-1
    rect x=0 y=92 width="100%" height=4 paint="sand.shade"
    rect "wave" x=0 y="=91 + osc(4s, -1.5, 1.5)" width="100%" height=1 paint="foam.lit"
    rect x=20 y="=@wave.y + 1" width=40 height=1 paint="foam.base" visible="=osc(4s) > 0"
    rect x=120 y="=@wave.y + 1" width=56 height=1 paint="foam.base" visible="=osc(4s) > 0"
    blob x=0 y=118 circles="0,0,14 20,4,12 40,2,10" smooth=6 paint="sand.lit" texture=0.25 texture-scale=3

    // A palm leaning over the beach, fronds stirring in the breeze
    rope "trunk" x1=184 y1=118 x2=164 y2=50 sag=-6 width=4 paint="palm.shade" casts-shadow=#true
    polygon x="=@trunk.x2 + osc(4s, -1, 1)" y=48 points="0,0 -14,4 -26,12 -12,6" paint="palm.base" shading="dome" casts-shadow=#true
    polygon x="=@trunk.x2 + osc(4s, 1, -1)" y=48 points="0,0 12,2 24,10 10,6" paint="palm.base" shading="dome" casts-shadow=#true
    polygon x=164 y="=46 + osc(2s, -1, 1)" points="0,0 -8,-8 -18,-10 -6,-4" paint="palm.lit" shading="dome"
    polygon x=164 y="=46 + osc(2s, 1, -1)" points="0,0 8,-8 18,-8 6,-3" paint="palm.lit" shading="dome"

    // The campfire in front of the couple
    blob x=108 y=106 circles="0,0,3 6,1,3 12,0,3 18,1,3" smooth=2 paint="sand.deep" shading="dome" outline="selective" contact-shadow=1
    capsule x1=110 y1=104 x2=124 y2=100 radius=1.5 paint="wood.base" shading="dome"
    capsule x1=110 y1=100 x2=124 y2=104 radius=1.5 paint="wood.lit" shading="dome"
    blob "flame" x="=117 + wiggle(1, 3)" y=99 circles="0,0,4 -2,-4,3 1,-7,2" smooth=2 paint="fire.lit" emissive=#true
    blob x="=117 + wiggle(1, 4)" y=100 circles="0,0,2.5 0,-4,1.5" smooth=1 paint="fire.hi" emissive=#true tone-shift="=round(wiggle(0.6, 5))"
    light-point x=117 y=96 reach=80 intensity="=3 + wiggle(0.4, 4)" color="warm" shadows=#true
    particles x=113 y=86 width=8 height=6 count=8 vy=-16 life="1s" size=1 wind=2 streak="0.05s" paint="fire.hi" emissive=#true fade=#true

    // The lovers, seen from behind, sitting close on a blanket
    polygon x=50 y=108 points="0,6 52,0 58,13 4,18" paint="blanket.base" texture=0.25 texture-scale=2 shading="dome" outline="selective"
    rounded-rect "his-back" x=58 y=92 width=17 height=20 radius=6 paint="shirt.base" shading="dome" outline="selective" casts-shadow=#true
    rect x=64 y=89 width=5 height=4 paint="skin.shade"
    ellipse "his-head" x=60 y=79 width=12 height=13 paint="hair.base" shading="dome" outline="selective" casts-shadow=#true
    rounded-rect "her-back" x=77 y=97 width=13 height=16 radius=5 paint="dress.base" shading="dome" outline="selective" casts-shadow=#true
    blob "her-hair" x=82 y=94 circles="0,0,5 1,6,5 0,11,4" smooth=3 paint="brunette.base" shading="dome" outline="selective" casts-shadow=#true
    rope x1=84 y1=96 x2="=86 + wind(86) * 2" y2=108 sag=0 sway="=osc(4s, -1, 1)" width=1 paint="brunette.lit"
    rope x1=80 y1=96 x2="=81 + wind(81) * 2" y2=107 sag=0 sway="=osc(4s, 1, -1)" width=1 paint="brunette.shade"
    ellipse "her-head" x=72 y=85 width=10 height=11 paint="brunette.base" shading="dome" outline="selective" casts-shadow=#true
    blob x=79 y=87 circles="0,0,1.5 2,1,1.5 0,2,1.5" smooth=1 paint="rose.base"
    capsule x1=72 y1=96 x2=89 y2=99 radius=2 paint="shirt.lit" shading="dome" outline="selective"
    ellipse x=87 y=97 width=4 height=4 paint="skin.base" shading="dome"

    // One small heart drifting up from them
    group "heart" {
        blob "heart-top" x=73 y="=78 - fract(t / 4) * 22" circles="0,0,1.6 3,0,1.6" smooth=1 paint="rose.lit" emissive=#true visible="=fract(t / 4) < 0.8"
        polygon x="=@heart-top.x - 1.6" y="=@heart-top.y" points="0,0 6.2,0 3.1,3.5" paint="rose.lit" emissive=#true visible="=fract(t / 4) < 0.8"
    }
}

// A wooded point running out into the lake, in host canvas coordinates: a dark shoreline, a
// canopy of rounded treetops with cherry trees in bloom among them, and the pagoda standing
// in the trees, its base hidden by the front row. Its windows and lanterns light up at 11 s.

use "fuji-palette.kdl"
use "pagoda.kdl"

motif fuji-treetop x y crown spread side paint { blob $x $y circles="0,0,$crown -$spread,1,$side $spread,1,$side" smooth=1.5 paint=$paint texture=0.5 texture-scale=1 shading=dome }
motif fuji-tree x y crown side tone { fuji-treetop $x $y $crown $side $side paint=forest.$tone }
motif fuji-cherry x y crown spread side tone top=3 {
    fuji-treetop $x $y $crown $spread $side paint=sakura.$tone
    rect $x "=$y-$top" 2 1 paint=sakura.7
}

scene "wooded-point" palette=fuji width=480 height=180 fps=12 duration="16s" background=sky-day.5 {
    polygon points="-80,180 -80,108 -20,104 40,104 90,107 130,110 170,112 196,116 214,122 228,130 232,134 214,140 170,148 110,156 40,164 -80,170" paint=forest.2 texture=0.45 texture-scale=2 shading=soft
    polygon points="232,134 214,140 170,148 110,156 40,164 -80,170 -80,174 40,168 112,160 172,152 216,143 234,136" paint=forest.0

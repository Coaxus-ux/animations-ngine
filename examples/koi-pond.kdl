// A koi pond seen from above on a spring afternoon.

use "parts/pond/pond-palette.kdl"
use "parts/pond/koi.kdl"
use "parts/pond/lily.kdl"
use "parts/pond/ripple.kdl"
use "parts/pond/frog.kdl"
use "parts/pond/dragonfly.kdl"

motif pond-pebble x y w h tone { ellipse $x $y $w $h paint=$tone shading=dome }
motif pond-weed x y top swing { rope $x $y "=$x + wind($x) * 8 + osc(4s, -$swing, $swing)" $top sway="=osc(3s, -3, 3)" width=2 paint=pad.shade }
motif pond-caustic x y w h { shade "=$x + osc(6s, -8, 8)" "=$y + osc(4s, 4, -4)" $w $h steps=1 round=#true }
motif pond-rock x y { blob $x $y circles="0,0,7 9,-2,6 4,5,5" paint=stone.base shading=dome texture=0.3 texture-scale=2 outline=selective }
motif pond-bank-stone x y big small { blob $x $y circles="0,0,$big 7,1,$small" smooth=2 paint=stone shading=dome texture=0.3 texture-scale=2 outline=selective casts-shadow=#true }
motif pond-stepping-stone x y { blob $x $y circles="0,0,6 5,2,5" smooth=2 paint=stone.lit shading=dome texture=0.25 texture-scale=2 outline=selective }
motif pond-grass x y { line $x $y "=$x + wind($x) * 2 + 1" "=$y - 4" paint=moss.hi }

scene koi-pond palette=pond width=320 height=180 fps=12 duration="12s" loop=#true seed=5 background=water.base {
    ambient occlusion=1 key-light=225
    wind strength=1 gust=0.6 speed=5

    timeline {
        marker dive at="2.5s"
        marker close at="4.5s"
        marker rise at="8s"
        marker wide at="10s"
    }

    group focus {
        anim x {
            k "dive" 0
            k "close" 1 interp=ease-in-out
            k "rise" 1
            k "wide" 0 interp=ease-in-out
        }
    }
    camera "=(@ogon.x - 22 - 160) * @focus.x" "=(@ogon.y - 90) * @focus.x" zoom="=1 + 2 * @focus.x"

    layer floor parallax=1 fog="50%" fog-paint=water.shade {
        rect -80 -60 480 300 paint=floor.base texture=0.35 texture-scale=4
        scatter 34 seed=1 x="-7..326" y="34..146" w="3..7" h="3..5" tone="floor.lit|floor.hi|floor.shade|stone.base" {
            pond-pebble $x $y $w $h $tone
        }
        pond-rock 70 120
        pond-rock 190 60
        pond-rock 290 130
        pond-weed 30 150 110 3
        pond-weed 44 154 124 2
        pond-weed 150 152 116 1
        pond-weed 208 30 64 3
        pond-weed 300 40 70 2
        pond-weed 118 32 58 1
        pond-caustic 170 135 25 8
        pond-caustic 40 61 22 9
        pond-caustic 198 136 25 10
        pond-caustic 153 52 23 11
        pond-caustic 155 71 18 8
        pond-caustic 230 114 23 9
    }

    layer deep parallax=1 fog="30%" fog-paint=water.shade {
        use-scene koi "=mod(t * 220 / 6 + i * 210, 440) - 60" "=72 + i * 46 + 6 * sin(tau * t / 6 + i)" count=2 scale=0.7 speed=0.75 offset="=i * 0.4" body=koi-black patch=koi-white
        use-scene koi "=380 - mod(t * 110 / 3 + 120, 440)" "=108 + 5 * sin(tau * t / 4)" flip=#true scale=0.75 speed=0.75 body=koi-orange patch=koi-gold
    }

    use-scene koi "=mod(t * 110 / 3 + 40, 440) - 60" "=96 + 10 * sin(tau * t / 6)" id=ogon scale=1.25 body=koi-gold patch=koi-gold metallic=#true
    use-scene koi "=380 - mod(t * 110 / 3 + 60, 440)" "=58 + 8 * sin(tau * t / 6 + 2)" flip=#true scale=1.1 speed=1.25 body=koi-white patch=koi-red
    use-scene koi "=380 - mod(t * 110 / 3 + 260, 440)" "=134 + 6 * sin(tau * t / 4)" flip=#true body=koi-white patch=koi-red spotted=#true offset="0.3s"
    use-scene koi "=mod(t * 110 / 3 + 250, 440) - 60" "=48 + 6 * sin(tau * t / 4 + 1)" scale=0.95 speed=1.25 body=koi-black patch=koi-red offset="0.6s"
    use-scene koi "=mod(t * 110 / 3 + 330, 440) - 60" "=122 + 8 * sin(tau * t / 6 + 3)" scale=1.05 body=koi-orange patch=koi-white offset="0.2s"

    shade "=-30 + osc(4s, -3, 3)" -20 150 90 round=#true
    shade "=60 + osc(4s, 2, -2)" -30 110 70 round=#true
    shade "=210 + osc(6s, -2, 2)" 120 140 90 round=#true
    shade "=20 + osc(4s, -3, 3)" "=18 + osc(6s, -2, 2)" 14 9 steps=1 round=#true
    shade "=58 + osc(4s, -3, 3)" "=30 + osc(6s, 2, -2)" 10 7 steps=1 round=#true
    shade "=92 + osc(4s, -2, 2)" "=8 + osc(6s, -1, 1)" 12 8 steps=1 round=#true
    shade "=246 + osc(6s, -2, 2)" "=146 + osc(4s, 2, -2)" 12 8 steps=1 round=#true

    use-scene lily 96 70 id=pad-a scale=1.4 flower=#true
    use-scene lily 118 86 id=pad-b scale=1.1
    use-scene lily 84 92 id=pad-c scale=0.9 offset="1s"
    use-scene lily 206 118 id=pad-d scale=1.3 offset="2s" flower=#true
    use-scene lily 228 104 scale=0.9 offset="3s"
    use-scene lily 176 52 id=pad-e scale=1.2 offset="1.5s"
    use-scene lily 20 96 offset="0.5s" flower=#true
    use-scene lily 300 78 scale=1.2 offset="2.5s"
    use-scene frog attach=pad-b y=-1 scale=0.9
    use-scene ripple attach=pad-e offset="0.5s"
    use-scene ripple attach=pad-c offset="1.2s" scale=0.8
    use-scene ripple "=150 + i * 110" "=128 - i * 72" count=2 offset="=i * 0.9" scale=0.9

    polygon -20 points="0,0 360,0 360,16 320,20 280,15 240,22 200,17 160,24 120,18 80,23 40,17 0,22" paint=moss texture=0.4 texture-scale=2 shading=dome outline=selective
    pond-bank-stone -10 16 5.9 3.7
    pond-bank-stone 32 20 5.5 3.6
    pond-bank-stone 72 15 5.7 4.0
    pond-bank-stone 115 17 4.4 4.1
    pond-bank-stone 150 18 5.2 4.6
    pond-bank-stone 193 16 4.5 3.8
    pond-bank-stone 234 16 5.0 4.5
    pond-bank-stone 276 19 4.9 3.4
    pond-bank-stone 311 17 5.6 4.4
    polygon -20 158 points="0,8 40,2 80,6 120,0 160,5 200,1 240,6 280,0 320,4 360,2 360,30 0,30" paint=moss texture=0.4 texture-scale=2 shading=dome outline=selective
    pond-stepping-stone 30 156
    pond-stepping-stone 64 160
    pond-stepping-stone 98 154
    pond-stepping-stone 132 159
    scatter 5 seed=2 x="20..320" y="5..14" { pond-grass $x $y }
    scatter 5 seed=3 x="20..320" y="173..176" { pond-grass $x $y }

    rect 36 2 14 14 paint=stone.shade outline=full outline-paint=ink
    polygon 34 points="9,0 18,7 9,14 0,7" paint=stone.lit shading=dome outline=selective
    rect 41 5 4 4 paint=lamp.hi emissive=#true

    rect 252 -10 34 200 paint=water.deep opacity=0.5
    rect 244 -10 30 200 paint=wood.lit texture=0.3 texture-scale=2 outline=selective casts-shadow=#true
    line 245 "=-8 + $k*6" 272 "=-8 + $k*6" paint=wood.shade repeat=33
    rect "=241 + $k*32" -10 4 200 paint=lacquer shading=dome outline=selective repeat=2
    rect "=240 + ($k % 2)*32" "=4 + floor($k/2)*36" 6 5 paint=lacquer.lit outline=full outline-paint=lacquer.deep repeat=12

    particles -40 20 380 140 count=22 vx=5 vy=1 life="12s" wind=3 paint=petal.lit
    particles -40 20 380 140 count=10 vx=4 vy=1.5 life="6s" size=2 wind=2 paint=petal.base
    use-scene dragonfly 150 40 scale=1.1
}

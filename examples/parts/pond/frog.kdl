// A small frog seen from above, sitting at (0, 0) and facing up. It breathes, blinks and
// now and then its throat puffs out. Every 3 s.

use "pond-palette.kdl"

scene "frog" palette=pond width=20 height=20 fps=12 duration="3s" loop=#true background=pad.base {
    camera -10 -10

    ellipse -6 1 4 6 paint=frog.shade outline=selective
    ellipse 2 1 4 6 paint=frog.shade outline=selective
    ellipse "body" -4 "=-4 - round(osc(1.5s, 0, 0.6))" 8 9 paint=frog shading=dome outline=selective
    ellipse -2 -1 4 3 paint=frog.lit
    ellipse "=-1 - round(pulse(3s, 0.15))" -6 "=2 + 2 * round(pulse(3s, 0.15))" 2 paint=heart.hi visible="=pulse(3s, 0.15)"
    ellipse -4 -6 3 3 paint=frog.lit outline=selective
    ellipse 1 -6 3 3 paint=frog.lit outline=selective
    rect -3 -5 1 "=1 - square(t / 3, 0.05)" paint=ink
    rect 2 -5 1 "=1 - square(t / 3, 0.05)" paint=ink
    line -6 -2 -8 -4 paint=frog.shade
    line 5 -2 7 -4 paint=frog.shade
}

// The editor's dark theme: every UI pixel uses one of these colors (px-ui `Theme`).
palette "theme" {
    ramp "window"  "#0e0d16"
    ramp "panel"   "#14131f" "#1f1d2e" "#2b2940" "#262438"
    ramp "field"   "#0a0a12"
    ramp "ink"     "#9491ab" "#e6e3f5"
    ramp "accent"  "#3859db" "#8fa8ff"
    ramp "warning" "#f36a20"
    ramp "checker" "#2a2a33" "#3a3a46"
    ramp "grid"    "#3c3a52"
    ramp "disabled" "#4a4860"
    ramp "backdrop" "#07060c"
    ramp "tab"      "#1a1828"
    ramp "key"     "#ff00ff"
}

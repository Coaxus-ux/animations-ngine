// A passenger carriage seen from the side, its front coupling at (0, 0) and its body
// stretching back to x = -58. Four lit windows, each a clip group holding a passenger (a
// placed scene), so people show only through the glass. The window light spills on whatever
// is near. Wheels turn twice a second. `color` sets the livery.

use "train-palette.kdl"
use "passenger.kdl"

scene "carriage" palette="night-train" width=72 height=36 fps=12 duration="12s" loop=#true background="sky.base" {
    param color "car"
    param sleepers #false
    camera x=-66 y=-30

    // Underframe and bogies
    rect x=-56 y=-6 width=54 height=2 paint="iron.base"
    rect x=-54 y=-5 width=14 height=2 paint="iron.shade"
    ellipse x=-54 y=-5 width=6 height=6 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-53 y=-4 width=4 height=4 paint="iron.shade"
    line x1="=-51 + 2 * cos(0 - tau * 2 * t)" y1="=-2 + 2 * sin(0 - tau * 2 * t)" x2="=-51 - 2 * cos(0 - tau * 2 * t)" y2="=-2 - 2 * sin(0 - tau * 2 * t)" paint="iron.lit"
    line x1="=-51 + 2 * cos(1.5708 - tau * 2 * t)" y1="=-2 + 2 * sin(1.5708 - tau * 2 * t)" x2="=-51 - 2 * cos(1.5708 - tau * 2 * t)" y2="=-2 - 2 * sin(1.5708 - tau * 2 * t)" paint="iron.lit"
    rect x=-51 y=-2 width=1 height=1 paint="brass.lit"
    ellipse x=-46 y=-5 width=6 height=6 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-45 y=-4 width=4 height=4 paint="iron.shade"
    line x1="=-43 + 2 * cos(0 - tau * 2 * t)" y1="=-2 + 2 * sin(0 - tau * 2 * t)" x2="=-43 - 2 * cos(0 - tau * 2 * t)" y2="=-2 - 2 * sin(0 - tau * 2 * t)" paint="iron.lit"
    line x1="=-43 + 2 * cos(1.5708 - tau * 2 * t)" y1="=-2 + 2 * sin(1.5708 - tau * 2 * t)" x2="=-43 - 2 * cos(1.5708 - tau * 2 * t)" y2="=-2 - 2 * sin(1.5708 - tau * 2 * t)" paint="iron.lit"
    rect x=-43 y=-2 width=1 height=1 paint="brass.lit"
    rect x=-18 y=-5 width=14 height=2 paint="iron.shade"
    ellipse x=-18 y=-5 width=6 height=6 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-17 y=-4 width=4 height=4 paint="iron.shade"
    line x1="=-15 + 2 * cos(0 - tau * 2 * t)" y1="=-2 + 2 * sin(0 - tau * 2 * t)" x2="=-15 - 2 * cos(0 - tau * 2 * t)" y2="=-2 - 2 * sin(0 - tau * 2 * t)" paint="iron.lit"
    line x1="=-15 + 2 * cos(1.5708 - tau * 2 * t)" y1="=-2 + 2 * sin(1.5708 - tau * 2 * t)" x2="=-15 - 2 * cos(1.5708 - tau * 2 * t)" y2="=-2 - 2 * sin(1.5708 - tau * 2 * t)" paint="iron.lit"
    rect x=-15 y=-2 width=1 height=1 paint="brass.lit"
    ellipse x=-10 y=-5 width=6 height=6 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-9 y=-4 width=4 height=4 paint="iron.shade"
    line x1="=-7 + 2 * cos(0 - tau * 2 * t)" y1="=-2 + 2 * sin(0 - tau * 2 * t)" x2="=-7 - 2 * cos(0 - tau * 2 * t)" y2="=-2 - 2 * sin(0 - tau * 2 * t)" paint="iron.lit"
    line x1="=-7 + 2 * cos(1.5708 - tau * 2 * t)" y1="=-2 + 2 * sin(1.5708 - tau * 2 * t)" x2="=-7 - 2 * cos(1.5708 - tau * 2 * t)" y2="=-2 - 2 * sin(1.5708 - tau * 2 * t)" paint="iron.lit"
    rect x=-7 y=-2 width=1 height=1 paint="brass.lit"

    // Body, roof and the window band
    rounded-rect "body" x=-58 y=-25 width=58 height=20 radius=2 paint="$color" shading="dome" outline="selective" casts-shadow=#true
    rounded-rect x=-59 y=-28 width=60 height=4 radius=2 paint="iron.lit" shading="dome" outline="selective"
    rect x=-50 y=-30 width=4 height=2 paint="iron.base"
    rect x=-20 y=-30 width=4 height=2 paint="iron.base"
    rect x=-58 y=-21 width=58 height=1 paint="brass.shade"
    rect x=-58 y=-9 width=58 height=1 paint="brass.shade"
    rect x=-4 y=-21 width=3 height=12 paint="$color.shade" outline="full" outline-paint="ink"
    rect x=-1 y=-20 width=3 height=10 paint="iron.shade"
    rect x=-30 y=-8 width=6 height=2 paint="brass.lit"
    rect x=-55 y=-20 width=12 height=11 paint="ink"
    rect x=-54 y=-19 width=10 height=9 paint="window.lit" emissive=#true gradient="down" gradient-steps=-1
    group x=-54 y=-19 width=10 height=9 clip=#true {
        use-scene "passenger" x=-50 y=-6 scale=0.7 offset="0.0s" hair="hair" coat="coat" reading=#true
    }
    rect x=-54 y=-19 width=10 height=1 paint="window.hi" emissive=#true
    rect x=-43 y=-20 width=12 height=11 paint="ink"
    rect x=-42 y=-19 width=10 height=9 paint="window.lit" emissive=#true gradient="down" gradient-steps=-1
    group x=-42 y=-19 width=10 height=9 clip=#true {
        use-scene "passenger" x=-38 y=-6 scale=0.7 offset="0.7s" hair="hair" coat="car" reading=#false
    }
    rect x=-42 y=-19 width=10 height=1 paint="window.hi" emissive=#true
    rect x=-31 y=-20 width=12 height=11 paint="ink"
    rect x=-30 y=-19 width=10 height=9 paint="window.lit" emissive=#true gradient="down" gradient-steps=-1
    group x=-30 y=-19 width=10 height=9 clip=#true {
        use-scene "passenger" x=-26 y=-6 scale=0.7 offset="1.4s" hair="brass" coat="coat" reading=#true
    }
    rect x=-30 y=-19 width=10 height=1 paint="window.hi" emissive=#true
    rect x=-19 y=-20 width=12 height=11 paint="ink"
    rect x=-18 y=-19 width=10 height=9 paint="window.lit" emissive=#true gradient="down" gradient-steps=-1
    group x=-18 y=-19 width=10 height=9 clip=#true {
        use-scene "passenger" x=-14 y=-6 scale=0.7 offset="2.1s" hair="hair" coat="train" reading=#true
    }
    rect x=-18 y=-19 width=10 height=1 paint="window.hi" emissive=#true
    light-rect x=-56 y=-19 width=52 height=9 reach=36 intensity=1.8 color="lamp"
}

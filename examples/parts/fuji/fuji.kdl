// The volcano, its summit crater at (0, 0): a wide cone with concave flanks lit from the
// west (right), a snow cap whose fingers run down the gullies, and dark lava ridges between
// them. Still; the host lights it and hides its foot behind hills.

use "fuji-palette.kdl"

scene "fuji" palette=fuji width=480 height=140 fps=12 duration="1s" loop=#true background=sky-day.5 {
    camera -240 -12

    polygon points="-16,0 -9,-2 -3,-1 0,-1 4,20 12,50 22,90 23,96 -84,96 -80,90 -40,50 -20,20" paint=rock.3 texture=0.15 texture-scale=3
    polygon points="-16,0 -30,12 -48,26 -70,42 -96,58 -126,74 -160,90 -177,96 -84,96 -80,90 -40,50 -20,20" paint=rock.2 texture=0.15 texture-scale=3
    polygon points="0,-1 3,-2 10,-1 22,20 46,52 80,92 84,96 23,96 22,90 12,50 4,20" paint=rock.4 texture=0.15 texture-scale=3
    polygon points="10,-1 16,0 44,24 84,56 140,94 144,96 84,96 80,92 46,52 22,20" paint=rock.5 texture=0.12 texture-scale=3
    polygon points="16,0 30,12 48,26 70,42 96,58 126,74 160,90 177,96 144,96 140,94 84,56 44,24" paint=rock.6 texture=0.1 texture-scale=3

    line 40 36 70 78 paint=rock.3
    line 26 42 44 96 paint=rock.3
    line 12 46 18 100 paint=rock.3
    line 58 40 100 80 paint=rock.4
    line 74 52 128 92 paint=rock.4
    line -4 46 -8 104 paint=rock.1
    line -16 42 -34 96 paint=rock.1
    line -30 40 -62 90 paint=rock.1
    line -46 34 -92 84 paint=rock.1
    line -64 46 -120 90 paint=rock.1

    polygon points="-16,0 -9,-2 -3,-1 3,-2 10,-1 16,0 30,12 44,23 52,30 46,31 44,36 36,32 31,40 24,33 18,42 12,33 6,44 0,33 -5,42 -10,32 -17,40 -22,31 -28,38 -34,30 -42,31 -48,26 -30,12" paint=snow.4
    polygon points="-3,-1 3,-2 10,-1 16,0 30,12 44,23 52,30 46,31 44,36 36,32 31,40 24,33 18,42 12,33 6,44 2,36 1,20 -1,8" paint=snow.5
    polygon points="3,-2 10,-1 16,0 30,12 44,23 52,30 46,31 44,36 36,32 31,40 24,33 20,30 12,14 6,4" paint=snow.6
    polygon points="10,-1 16,0 30,12 44,23 52,30 46,31 40,28 30,20 20,10" paint=snow.7
    polygon points="-16,0 -9,-2 -3,-1 -1,8 -4,22 -9,32 -13,31 -17,40 -22,31 -28,38 -34,30 -42,31 -48,26 -30,12" paint=snow.3
    polygon points="-9,-2 -3,-1 3,-2 10,-1 8,1 0,0 -8,1" paint=snow.2

    polygon points="44,36 50,34 56,37 62,42 66,48 62,47 57,44 52,42 48,46 46,40" paint=snow.6
    polygon points="62,42 70,46 78,52 84,58 80,58 72,52 66,48" paint=snow.6
    polygon points="18,42 22,40 26,46 30,54 28,58 24,52 21,48 19,52" paint=snow.5
    polygon points="30,54 34,58 38,66 36,70 33,64 29,59" paint=snow.5
    polygon points="6,44 8,46 9,54 10,62 8,66 6,58 5,50" paint=snow.5
    polygon points="-5,42 -4,48 -6,56 -8,60 -9,54 -7,48" paint=snow.3
    polygon points="-17,40 -15,44 -19,52 -24,58 -25,54 -21,47" paint=snow.3
    polygon points="-24,58 -28,64 -32,70 -33,66 -29,61" paint=snow.2
    polygon points="-28,38 -32,44 -38,50 -44,54 -42,50 -36,44 -32,40" paint=snow.2
    polygon points="-43,30 -50,34 -58,40 -64,46 -60,46 -54,41 -48,38" paint=snow.2
    polygon points="84,58 92,62 100,68 96,68 88,64" paint=snow.5
}

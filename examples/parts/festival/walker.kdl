// A person walking in place, facing right: one full stride per second. The feet touch
// (0, 0), so a host places a walker by where it stands, moves it with `x`, turns it around
// with `flip` and sets its look with params. Can carry a paper lantern (a nested scene).

use "festival-palette.kdl"
use "paper-lantern.kdl"

scene "walker" palette=festival width=40 height=48 fps=12 duration="1s" loop=#true background=street.base {
    param coat "coat-blue"
    param hair "hair-black"
    param scarf "cloth"
    param lantern #false
    param ponytail #false
    camera -20 -44

    // The body rises a pixel each time the legs pass each other
    group "bob" y="=round(abs(sin(tau * t))) - 1"

    // Far side: back leg and arm
    capsule "back-leg" -1 "=-13 + @bob.y" "=-6 * sin(tau * t)" "=-2 - 2 * max(0, -cos(tau * t))" radius=1.6 paint=pants.shade
    ellipse "=@back-leg.x2 - 2" "=@back-leg.y2 - 1" 5 3 paint=hair-black.shade
    capsule "back-arm" 0 "=-23 + @bob.y" "=4 * sin(tau * t)" "=-15 + @bob.y" radius=1.3 paint=$coat.shade
    ellipse "=@back-arm.x2 - 1" "=@back-arm.y2 - 1" 3 3 paint=skin.shade

    // Near leg and the coat over both hips
    capsule "front-leg" 1 "=-13 + @bob.y" "=6 * sin(tau * t)" "=-2 - 2 * max(0, cos(tau * t))" radius=1.6 paint=pants.base
    ellipse "=@front-leg.x2 - 2" "=@front-leg.y2 - 1" 5 3 paint=hair-black.base outline=selective
    rounded-rect "coat" -4 "=-26 + @bob.y" 9 14 radius=3 paint=$coat shading=dome outline=selective casts-shadow=#true
    polygon -5 "=-14 + @bob.y" points="1,0 10,0 11,3 0,3" paint=$coat.shade outline=selective
    rect -4 "=-16 + @bob.y" 9 1 paint=wood.shade
    rect 2 "=-23 + @bob.y" 1 1 paint=lantern-gold.lit
    rect 2 "=-20 + @bob.y" 1 1 paint=lantern-gold.lit

    // Head: hair behind, face, then the fringe in front
    rope -4 "=-34 + @bob.y" "=-9 + wind(0) * 1.5 - sin(tau * t)" "=-28 + @bob.y" sag=1 width=2 paint=$hair visible="=$ponytail"
    rect -1 "=-28 + @bob.y" 3 3 paint=skin.shade
    ellipse "head" -4 "=-37 + @bob.y" 10 10 paint=skin shading=dome outline=selective
    blob -4 "=-37 + @bob.y" circles="3,2,3.5 1,4,2.5 6,1.5,2.5" smooth=1.5 paint=$hair shading=dome outline=selective
    polygon 2 "=-37 + @bob.y" points="0,1 5,2 6,4 2,3" paint=$hair.lit
    rect -1 "=-32 + @bob.y" 1 2 paint=skin.shade
    rect 3 "=-33 + @bob.y" 1 2 paint=ink
    rect 4 "=-30 + @bob.y" 1 1 paint=lantern.hi
    rect 5 "=-29 + @bob.y" 1 1 paint=skin.shade

    // Scarf, trailing behind in the wind
    rounded-rect -3 "=-28 + @bob.y" 8 3 radius=1 paint=$scarf shading=dome
    rope -2 "=-27 + @bob.y" "=-8 + wind(0) * 3" "=-23 + @bob.y + sin(tau * t)" sag=1 width=2 paint=$scarf.shade

    // Near arm, and the lantern hanging from that hand
    capsule "front-arm" 1 "=-23 + @bob.y" "=1 - 4 * sin(tau * t)" "=-15 + @bob.y" radius=1.4 paint=$coat.lit outline=selective
    ellipse "hand" "=@front-arm.x2 - 1" "=@front-arm.y2 - 1" 3 3 paint=skin outline=selective
    use-scene "paper-lantern" "=@hand.x + 2" "=@hand.y + 1" id=carried count="=$lantern" scale=0.6
}

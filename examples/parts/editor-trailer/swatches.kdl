// The Palette panel's swatch rows: one scene per ramp length, each tone a 9×9 swatch on a 10 px
// pitch, drawn emissive so the host's darkness and lights never touch them.

use "editor-palette.kdl"

motif ed-ramp x y tones ramp { use-scene "swatches-$tones" $x $y ramp=$ramp }

scene swatches-1 palette=editor width=10 height=9 fps=12 duration="1s" loop=#true background=ui-panel {
    param ramp "ui-sample"

    rect 0 0 9 9 paint=$ramp.0 emissive=#true
}

scene swatches-4 palette=editor width=40 height=9 fps=12 duration="1s" loop=#true background=ui-panel {
    param ramp "ui-sample"

    rect "=$k*10" 0 9 9 paint=$ramp.$k emissive=#true repeat=4
}

scene swatches-5 palette=editor width=50 height=9 fps=12 duration="1s" loop=#true background=ui-panel {
    param ramp "ui-sample"

    rect "=$k*10" 0 9 9 paint=$ramp.$k emissive=#true repeat=5
}

scene swatches-6 palette=editor width=60 height=9 fps=12 duration="1s" loop=#true background=ui-panel {
    param ramp "ui-sample"

    rect "=$k*10" 0 9 9 paint=$ramp.$k emissive=#true repeat=6
}

scene swatches-7 palette=editor width=70 height=9 fps=12 duration="1s" loop=#true background=ui-panel {
    param ramp "ui-sample"

    rect "=$k*10" 0 9 9 paint=$ramp.$k emissive=#true repeat=7
}

scene swatches-8 palette=editor width=80 height=9 fps=12 duration="1s" loop=#true background=ui-panel {
    param ramp "ui-sample"

    rect "=$k*10" 0 9 9 paint=$ramp.$k emissive=#true repeat=8
}

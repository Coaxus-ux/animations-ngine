// The editor's action and view icons, drawn as pixel layers and rendered by the engine (D-012).
// Every scene uses the theme palette; pixels left at "key" are transparent.
use "theme.kdl"

scene "undo" palette="theme" width=16 height=16 fps=1 duration="1f" background="key.0" {
    pixels "undo-icon" {
        legend { i "ink.1"; d "ink.0"; a "accent.0"; b "accent.1"; w "warning.0"; p "panel.0"; k "panel.2" }
        cel """
        ................
        ................
        ....i...........
        ...ii...........
        ..iiiiiiiii.....
        ...ii......ii...
        ....i.......i...
        ............i...
        ............i...
        ...........i....
        .........ii.....
        ................
        ................
        ................
        ................
        ................
        """
    }
}


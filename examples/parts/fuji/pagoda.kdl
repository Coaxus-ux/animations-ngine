// A five-storey pagoda in red lacquer on a stone plinth, its base centered at (0, 0). Each
// storey is lit on its west (right) side and shaded under its eaves; bells hang from the
// roof corners, lanterns from the lowest eaves, and its windows glow after `lights-on`
// (host seconds).

use "fuji-palette.kdl"

scene "pagoda" palette="fuji" width=48 height=80 fps=12 duration="16s" background="sky-day.5" {
    param lights-on 10
    camera x=-24 y=-72

    rect x=-17 y=-2 width=34 height=4 paint="plaster.1" texture=0.4 texture-scale=1.5 shading="soft" contact-shadow=1
    rect x=-15 y=-4 width=30 height=2 paint="plaster.2" texture=0.3 texture-scale=1.5
    rect x=-12 y=-5 width=24 height=1 paint="plaster.3"
    rect x=-3 y=-2 width=6 height=4 paint="plaster.3" texture=0.3 texture-scale=1
    rect x=-3 y=0 width=6 height=1 paint="plaster.1"
    rect x=-9 y=-15 width=18 height=10 paint="lacquer.3" casts-shadow=#true
    rect x=-9 y=-15 width=2 height=10 paint="lacquer.1"
    rect x=7 y=-15 width=2 height=10 paint="lacquer.4"
    rect x=8 y=-14 width=1 height=9 paint="lacquer.5"
    rect x=-7 y=-15 width=14 height=2 paint="lacquer.1"
    rect x=-6 y=-12 width=12 height=5 paint="lacquer.2"
    rect x=-5 y=-12 width=1 height=5 paint="lacquer.3"
    rect x=-2 y=-12 width=1 height=5 paint="lacquer.3"
    rect x=1 y=-12 width=1 height=5 paint="lacquer.4"
    rect x=4 y=-12 width=1 height=5 paint="lacquer.4"
    rect x=-8 y=-6 width=16 height=1 paint="tile.4"
    rect x=-2 y=-12 width=4 height=5 paint="lamp.2" emissive=#true visible="=t > $lights-on + 0.0"
    rect x=-1 y=-11 width=2 height=3 paint="lamp.4" emissive=#true visible="=t > $lights-on + 0.4"
    rect x=-8 y=-24 width=16 height=9 paint="lacquer.3" casts-shadow=#true
    rect x=-8 y=-24 width=2 height=9 paint="lacquer.1"
    rect x=6 y=-24 width=2 height=9 paint="lacquer.4"
    rect x=7 y=-23 width=1 height=8 paint="lacquer.5"
    rect x=-6 y=-24 width=12 height=2 paint="lacquer.1"
    rect x=-5 y=-21 width=10 height=4 paint="lacquer.2"
    rect x=-4 y=-21 width=1 height=4 paint="lacquer.3"
    rect x=-1 y=-21 width=1 height=4 paint="lacquer.3"
    rect x=2 y=-21 width=1 height=4 paint="lacquer.4"
    rect x=-7 y=-16 width=14 height=1 paint="tile.4"
    rect x=-7 y=-33 width=14 height=9 paint="lacquer.3" casts-shadow=#true
    rect x=-7 y=-33 width=2 height=9 paint="lacquer.1"
    rect x=5 y=-33 width=2 height=9 paint="lacquer.4"
    rect x=6 y=-32 width=1 height=8 paint="lacquer.5"
    rect x=-5 y=-33 width=10 height=2 paint="lacquer.1"
    rect x=-4 y=-30 width=8 height=4 paint="lacquer.2"
    rect x=-3 y=-30 width=1 height=4 paint="lacquer.3"
    rect x=0 y=-30 width=1 height=4 paint="lacquer.3"
    rect x=-6 y=-25 width=12 height=1 paint="tile.4"
    rect x=-2 y=-30 width=4 height=4 paint="lamp.2" emissive=#true visible="=t > $lights-on + 1.2"
    rect x=-1 y=-29 width=2 height=2 paint="lamp.4" emissive=#true visible="=t > $lights-on + 1.6"
    rect x=-6 y=-41 width=12 height=8 paint="lacquer.3" casts-shadow=#true
    rect x=-6 y=-41 width=2 height=8 paint="lacquer.1"
    rect x=4 y=-41 width=2 height=8 paint="lacquer.4"
    rect x=5 y=-40 width=1 height=7 paint="lacquer.5"
    rect x=-4 y=-41 width=8 height=2 paint="lacquer.1"
    rect x=-3 y=-38 width=6 height=3 paint="lacquer.2"
    rect x=-2 y=-38 width=1 height=3 paint="lacquer.3"
    rect x=1 y=-38 width=1 height=3 paint="lacquer.4"
    rect x=-5 y=-34 width=10 height=1 paint="tile.4"
    rect x=-2 y=-38 width=4 height=3 paint="lamp.2" emissive=#true visible="=t > $lights-on + 1.8"
    rect x=-1 y=-37 width=2 height=1 paint="lamp.4" emissive=#true visible="=t > $lights-on + 2.2"
    rect x=-5 y=-49 width=10 height=8 paint="lacquer.3" casts-shadow=#true
    rect x=-5 y=-49 width=2 height=8 paint="lacquer.1"
    rect x=3 y=-49 width=2 height=8 paint="lacquer.4"
    rect x=4 y=-48 width=1 height=7 paint="lacquer.5"
    rect x=-3 y=-49 width=6 height=2 paint="lacquer.1"
    rect x=-2 y=-46 width=4 height=3 paint="lacquer.2"
    rect x=-1 y=-46 width=1 height=3 paint="lacquer.3"
    rect x=-4 y=-42 width=8 height=1 paint="tile.4"
    polygon x=0 y=-15 points="-17,-1 -14,1 14,1 17,-1 12,-3 -12,-3" paint="tile.2" casts-shadow=#true
    polygon x=0 y=-15 points="17,-1 14,1 2,1 2,-3 12,-3" paint="tile.3"
    rect x=-12 y=-18 width=24 height=1 paint="tile.4"
    line x1=12 y1=-18 x2=17 y2=-16 paint="tile.4"
    rect x=-14 y=-14 width=28 height=1 paint="tile.0"
    rect x=-17 y=-15 width=1 height=2 paint="lamp.1"
    rect x=17 y=-15 width=1 height=2 paint="lamp.1"
    polygon x=0 y=-24 points="-15,-1 -12,1 12,1 15,-1 10,-3 -10,-3" paint="tile.2" casts-shadow=#true
    polygon x=0 y=-24 points="15,-1 12,1 2,1 2,-3 10,-3" paint="tile.3"
    rect x=-10 y=-27 width=20 height=1 paint="tile.4"
    line x1=10 y1=-27 x2=15 y2=-25 paint="tile.4"
    rect x=-12 y=-23 width=24 height=1 paint="tile.0"
    rect x=-15 y=-24 width=1 height=2 paint="lamp.1"
    rect x=15 y=-24 width=1 height=2 paint="lamp.1"
    polygon x=0 y=-33 points="-13,-1 -10,1 10,1 13,-1 8,-3 -8,-3" paint="tile.2" casts-shadow=#true
    polygon x=0 y=-33 points="13,-1 10,1 2,1 2,-3 8,-3" paint="tile.3"
    rect x=-8 y=-36 width=16 height=1 paint="tile.4"
    line x1=8 y1=-36 x2=13 y2=-34 paint="tile.4"
    rect x=-10 y=-32 width=20 height=1 paint="tile.0"
    rect x=-13 y=-33 width=1 height=2 paint="lamp.1"
    rect x=13 y=-33 width=1 height=2 paint="lamp.1"
    polygon x=0 y=-41 points="-11,-1 -8,1 8,1 11,-1 6,-3 -6,-3" paint="tile.2" casts-shadow=#true
    polygon x=0 y=-41 points="11,-1 8,1 2,1 2,-3 6,-3" paint="tile.3"
    rect x=-6 y=-44 width=12 height=1 paint="tile.4"
    line x1=6 y1=-44 x2=11 y2=-42 paint="tile.4"
    rect x=-8 y=-40 width=16 height=1 paint="tile.0"
    rect x=-11 y=-41 width=1 height=2 paint="lamp.1"
    rect x=11 y=-41 width=1 height=2 paint="lamp.1"
    polygon x=0 y=-49 points="-9,-1 -6,1 6,1 9,-1 4,-3 -4,-3" paint="tile.2" casts-shadow=#true
    polygon x=0 y=-49 points="9,-1 6,1 2,1 2,-3 4,-3" paint="tile.3"
    rect x=-4 y=-52 width=8 height=1 paint="tile.4"
    line x1=4 y1=-52 x2=9 y2=-50 paint="tile.4"
    rect x=-6 y=-48 width=12 height=1 paint="tile.0"
    rect x=-9 y=-49 width=1 height=2 paint="lamp.1"
    rect x=9 y=-49 width=1 height=2 paint="lamp.1"
    rect x=0 y=-67 width=1 height=15 paint="tile.1"
    rect x=1 y=-67 width=1 height=15 paint="tile.3"
    rect x=-1 y=-55 width=4 height=1 paint="lamp.1"
    rect x=-1 y=-57 width=4 height=1 paint="lamp.0"
    rect x=-1 y=-59 width=4 height=1 paint="lamp.1"
    rect x=-1 y=-61 width=4 height=1 paint="lamp.0"
    rect x=-1 y=-63 width=4 height=1 paint="lamp.1"
    rect x=-1 y=-65 width=4 height=1 paint="lamp.0"
    ellipse x=-1 y=-70 width=4 height=4 paint="lamp.2" shading="dome"
    line x1=-16 y1=-15 x2=-16 y2=-12 paint="ink"
    rounded-rect x=-17 y=-12 width=3 height=4 radius=1 paint="lamp.3" emissive=#true visible="=t > $lights-on"
    rounded-rect x=-17 y=-12 width=3 height=4 radius=1 paint="lacquer.2" visible="=t <= $lights-on"
    line x1=16 y1=-15 x2=16 y2=-12 paint="ink"
    rounded-rect x=15 y=-12 width=3 height=4 radius=1 paint="lamp.3" emissive=#true visible="=t > $lights-on"
    rounded-rect x=15 y=-12 width=3 height=4 radius=1 paint="lacquer.2" visible="=t <= $lights-on"
}

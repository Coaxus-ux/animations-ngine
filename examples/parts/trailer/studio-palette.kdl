    ramp rose "420a24 80183e c8346a ff6a96 ffc2d6"
    ramp violet "1c0c3a 34186a 5a30a8 8c62e0 c8b0ff"
    ramp panel "0a0d15 11151f 191e2c 232a3c 303a52"

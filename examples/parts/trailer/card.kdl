// A title card: a small kicker over a big title that types in, a frame of corner marks in
// the accent color, and the title blowing apart into pixels as the card ends.

use "studio-palette.kdl"

motif studio-corner x reach y tip {
    line $x $y "=$x + $reach" $y paint=$accent.base
    line $x $y $x $tip paint=$accent.base
}

scene "card" palette=studio width=320 height=180 fps=12 duration="2s" seed=8 background=ink.deep {
    param title "TITLE"
    param kicker "KICKER"
    param accent "teal"

    particles 0 0 320 180 vx=6 count=40 life="2s" fade=#true paint=ink.lit
    group "open" "=min(1, t * 4)"
    group "leave" "=max(0, t - 1.55) / 0.45"

    studio-corner "=160 - 130 * @open.x" 10 56 64
    studio-corner "=160 + 130 * @open.x" -10 56 64
    studio-corner "=160 - 130 * @open.x" 10 124 116
    studio-corner "=160 + 130 * @open.x" -10 124 116

    text "$kicker" 160 66 align=center paint=$accent.lit reveal="=t * 40" scatter="=@leave.x * 60"
    text "$title" 161 82 size=2 align=center paint=$accent.shade reveal="=(t - 0.15) * 32" scatter="=@leave.x * @leave.x * 160"
    text "$title" 160 81 size=2 align=center paint=paper.hi reveal="=(t - 0.15) * 32" scatter="=@leave.x * @leave.x * 140"
    rect "=160 - 90 * @open.x * (1 - @leave.x)" 106 "=180 * @open.x * (1 - @leave.x)" 2 paint=$accent.base
}

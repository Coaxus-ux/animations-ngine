// The parts both cherries are grown from.

motif fuji-limb x1 y1 x2 y2 radius {
    capsule $x1 $y1 $x2 $y2 radius=$radius paint=bark.1 shading=soft texture=0.4 texture-scale=1
}
motif fuji-branch x1 y1 x2 y2 radius {
    fuji-limb "=$x1 + @sway.x" $y1 "=$x2 + @sway.x" $y2 $radius
}
motif fuji-twig x1 y1 x2 y2 radius {
    capsule "=$x1 + @sway.x" $y1 "=$x2 + @sway.x" $y2 radius=$radius paint=bark.1
}
motif fuji-back x y circles paint {
    blob "=$x + @sway.x" $y circles=$circles smooth=1.5 paint=$paint shading=dome
}
motif fuji-clump x y radius rim circles tone opacity=1 {
    blob "=$x + @sway.x" $y circles=$circles smooth=1.5 paint=sakura.$tone texture=0.4 texture-scale=1 shading=dome opacity=$opacity
    ellipse "=$x-$radius/2 + @sway.x" "=$y-$radius" $rim 2 paint=sakura.7 opacity=$opacity
}

motif fuji-back30 x y paint=sakura.3 { fuji-back $x $y "0,0,3 -2.4,1.4,2.0 2.4,1.0,2.0 0.3,1.8,1.8" paint=$paint }
motif fuji-clump30 x y tone opacity=1 { fuji-clump $x $y 3 3 "0,0,3 -2.4,1.4,2.0 2.4,1.0,2.0 0.3,1.8,1.8" $tone opacity=$opacity }
motif fuji-back35 x y paint=sakura.3 { fuji-back $x $y "0,0,3.5 -2.8,1.6,2.3 2.8,1.2,2.3 0.4,2.1,2.1" paint=$paint }
motif fuji-clump35 x y tone opacity=1 { fuji-clump $x $y 3.5 4 "0,0,3.5 -2.8,1.6,2.3 2.8,1.2,2.3 0.4,2.1,2.1" $tone opacity=$opacity }
motif fuji-back40 x y paint=sakura.3 { fuji-back $x $y "0,0,4 -3.2,1.8,2.6 3.2,1.4,2.6 0.4,2.4,2.4" paint=$paint }
motif fuji-clump40 x y tone opacity=1 { fuji-clump $x $y 4 4 "0,0,4 -3.2,1.8,2.6 3.2,1.4,2.6 0.4,2.4,2.4" $tone opacity=$opacity }
motif fuji-back45 x y paint=sakura.3 { fuji-back $x $y "0,0,4.5 -3.6,2.0,2.9 3.6,1.6,2.9 0.5,2.7,2.7" paint=$paint }
motif fuji-clump45 x y tone opacity=1 { fuji-clump $x $y 4.5 4 "0,0,4.5 -3.6,2.0,2.9 3.6,1.6,2.9 0.5,2.7,2.7" $tone opacity=$opacity }
motif fuji-back50 x y paint=sakura.3 { fuji-back $x $y "0,0,5 -4.0,2.2,3.2 4.0,1.8,3.2 0.5,3.0,3.0" paint=$paint }
motif fuji-clump50 x y tone opacity=1 { fuji-clump $x $y 5 5 "0,0,5 -4.0,2.2,3.2 4.0,1.8,3.2 0.5,3.0,3.0" $tone opacity=$opacity }
motif fuji-back55 x y paint=sakura.3 { fuji-back $x $y "0,0,5.5 -4.4,2.5,3.6 4.4,1.9,3.6 0.6,3.3,3.3" paint=$paint }
motif fuji-clump55 x y tone opacity=1 { fuji-clump $x $y 5.5 6 "0,0,5.5 -4.4,2.5,3.6 4.4,1.9,3.6 0.6,3.3,3.3" $tone opacity=$opacity }
motif fuji-back60 x y paint=sakura.3 { fuji-back $x $y "0,0,6 -4.8,2.7,3.9 4.8,2.1,3.9 0.6,3.6,3.6" paint=$paint }
motif fuji-clump60 x y tone opacity=1 { fuji-clump $x $y 6 6 "0,0,6 -4.8,2.7,3.9 4.8,2.1,3.9 0.6,3.6,3.6" $tone opacity=$opacity }

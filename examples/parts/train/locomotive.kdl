// A steam locomotive and its tender seen from the side, facing right, its front buffer at
// (0, 0). Three driving wheels turn with the connecting rod sliding between them, smoke
// streams back from the chimney (so it trails behind as the engine moves), the cab glows
// and the headlamp is an object named `lamp` that a light can be attached to.

use "train-palette.kdl"

scene "locomotive" palette="night-train" width=96 height=48 fps=12 duration="12s" loop=#true background="sky.base" {
    camera x=-84 y=-40

    // Smoke, pouring back from the chimney
    particles x=-16 y=-36 width=4 height=2 count=40 vx=-46 vy=-12 gravity=-4 life="1.5s" size=2 wind=4 paint="smoke.lit" fade=#true
    particles x=-16 y=-34 width=4 height=2 count=20 vx=-40 vy=-8 life="1s" size=3 wind=3 paint="smoke.base" fade=#true

    // Tender with its coal
    rounded-rect x=-82 y=-22 width=24 height=17 radius=2 paint="train" shading="dome" outline="selective" casts-shadow=#true
    polygon x=-80 y=-26 points="0,4 4,0 10,2 16,0 20,4" paint="iron.shade" texture=0.4 texture-scale=1
    rect x=-82 y=-12 width=24 height=1 paint="brass.base"
    ellipse x=-79 y=-6 width=6 height=6 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-78 y=-5 width=4 height=4 paint="iron.shade"
    line x1="=-76 + 2 * cos(0 - tau * 2 * t)" y1="=-3 + 2 * sin(0 - tau * 2 * t)" x2="=-76 - 2 * cos(0 - tau * 2 * t)" y2="=-3 - 2 * sin(0 - tau * 2 * t)" paint="iron.lit"
    line x1="=-76 + 2 * cos(1.5708 - tau * 2 * t)" y1="=-3 + 2 * sin(1.5708 - tau * 2 * t)" x2="=-76 - 2 * cos(1.5708 - tau * 2 * t)" y2="=-3 - 2 * sin(1.5708 - tau * 2 * t)" paint="iron.lit"
    rect x=-76 y=-3 width=1 height=1 paint="brass.lit"
    ellipse x=-67 y=-6 width=6 height=6 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-66 y=-5 width=4 height=4 paint="iron.shade"
    line x1="=-64 + 2 * cos(0 - tau * 2 * t)" y1="=-3 + 2 * sin(0 - tau * 2 * t)" x2="=-64 - 2 * cos(0 - tau * 2 * t)" y2="=-3 - 2 * sin(0 - tau * 2 * t)" paint="iron.lit"
    line x1="=-64 + 2 * cos(1.5708 - tau * 2 * t)" y1="=-3 + 2 * sin(1.5708 - tau * 2 * t)" x2="=-64 - 2 * cos(1.5708 - tau * 2 * t)" y2="=-3 - 2 * sin(1.5708 - tau * 2 * t)" paint="iron.lit"
    rect x=-64 y=-3 width=1 height=1 paint="brass.lit"

    // Cab, with the driver lit by the firebox
    rect x=-56 y=-28 width=18 height=23 paint="train.base" shading="dome" outline="selective" casts-shadow=#true
    rounded-rect x=-58 y=-31 width=22 height=4 radius=1 paint="iron.lit" outline="selective"
    rect x=-52 y=-25 width=8 height=8 paint="window.base" emissive=#true gradient="down" gradient-steps=-1
    ellipse x=-50 y=-24 width=4 height=4 paint="skin.shade"
    rect x=-51 y=-25 width=5 height=2 paint="hair.base"
    rect x=-50 y=-20 width=4 height=3 paint="coat.shade"
    light-point x=-48 y=-18 reach=22 intensity=1.6 color="lamp"

    // Boiler, chimney and dome, with brass bands
    rounded-rect x=-40 y=-21 width=34 height=12 radius=5 paint="train" shading="dome" outline="selective" casts-shadow=#true
    rect x=-34 y=-21 width=1 height=12 paint="brass.lit"
    rect x=-22 y=-21 width=1 height=12 paint="brass.lit"
    ellipse x=-28 y=-25 width=7 height=6 paint="brass" shading="dome" outline="selective"
    rect x=-16 y=-30 width=5 height=10 paint="iron.base" shading="dome" outline="selective"
    rect x=-17 y=-32 width=7 height=2 paint="iron.lit"
    rounded-rect x=-8 y=-20 width=6 height=11 radius=1 paint="iron.base" shading="dome" outline="selective"
    ellipse "lamp" x=-5 y=-25 width=5 height=5 paint="lamp.hi" emissive=#true outline="full" outline-paint="iron.deep"
    rect x=-2 y=-9 width=3 height=3 paint="car.lit" outline="selective"
    polygon x=-4 y=-6 points="0,0 6,0 8,6 0,6" paint="iron.lit" outline="selective"
    rect x=-40 y=-9 width=36 height=2 paint="iron.shade"

    // Driving wheels and the rod that couples them
    ellipse x=-38 y=-8 width=8 height=8 paint="car.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-37 y=-7 width=6 height=6 paint="car.shade"
    line x1="=-34 + 3 * cos(0 - tau * 1.5 * t)" y1="=-4 + 3 * sin(0 - tau * 1.5 * t)" x2="=-34 - 3 * cos(0 - tau * 1.5 * t)" y2="=-4 - 3 * sin(0 - tau * 1.5 * t)" paint="car.lit"
    line x1="=-34 + 3 * cos(1.5708 - tau * 1.5 * t)" y1="=-4 + 3 * sin(1.5708 - tau * 1.5 * t)" x2="=-34 - 3 * cos(1.5708 - tau * 1.5 * t)" y2="=-4 - 3 * sin(1.5708 - tau * 1.5 * t)" paint="car.lit"
    rect x=-34 y=-4 width=1 height=1 paint="brass.lit"
    ellipse x=-27 y=-8 width=8 height=8 paint="car.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-26 y=-7 width=6 height=6 paint="car.shade"
    line x1="=-23 + 3 * cos(0 - tau * 1.5 * t)" y1="=-4 + 3 * sin(0 - tau * 1.5 * t)" x2="=-23 - 3 * cos(0 - tau * 1.5 * t)" y2="=-4 - 3 * sin(0 - tau * 1.5 * t)" paint="car.lit"
    line x1="=-23 + 3 * cos(1.5708 - tau * 1.5 * t)" y1="=-4 + 3 * sin(1.5708 - tau * 1.5 * t)" x2="=-23 - 3 * cos(1.5708 - tau * 1.5 * t)" y2="=-4 - 3 * sin(1.5708 - tau * 1.5 * t)" paint="car.lit"
    rect x=-23 y=-4 width=1 height=1 paint="brass.lit"
    ellipse x=-16 y=-8 width=8 height=8 paint="car.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-15 y=-7 width=6 height=6 paint="car.shade"
    line x1="=-12 + 3 * cos(0 - tau * 1.5 * t)" y1="=-4 + 3 * sin(0 - tau * 1.5 * t)" x2="=-12 - 3 * cos(0 - tau * 1.5 * t)" y2="=-4 - 3 * sin(0 - tau * 1.5 * t)" paint="car.lit"
    line x1="=-12 + 3 * cos(1.5708 - tau * 1.5 * t)" y1="=-4 + 3 * sin(1.5708 - tau * 1.5 * t)" x2="=-12 - 3 * cos(1.5708 - tau * 1.5 * t)" y2="=-4 - 3 * sin(1.5708 - tau * 1.5 * t)" paint="car.lit"
    rect x=-12 y=-4 width=1 height=1 paint="brass.lit"
    line x1="=-34 + 2.5 * cos(-tau * 1.5 * t)" y1="=-4 + 2.5 * sin(-tau * 1.5 * t)" x2="=-12 + 2.5 * cos(-tau * 1.5 * t)" y2="=-4 + 2.5 * sin(-tau * 1.5 * t)" width=2 paint="iron.hi"
    line x1="=-12 + 2.5 * cos(-tau * 1.5 * t)" y1="=-4 + 2.5 * sin(-tau * 1.5 * t)" x2=-4 y2=-8 paint="iron.lit"
    ellipse x=-6 y=-4 width=4 height=4 paint="iron.base" shading="dome" outline="full" outline-paint="ink"
    ellipse x=-5 y=-3 width=2 height=2 paint="iron.shade"
    line x1="=-4 + 1 * cos(0 - tau * 2.5 * t)" y1="=-2 + 1 * sin(0 - tau * 2.5 * t)" x2="=-4 - 1 * cos(0 - tau * 2.5 * t)" y2="=-2 - 1 * sin(0 - tau * 2.5 * t)" paint="iron.lit"
    line x1="=-4 + 1 * cos(1.5708 - tau * 2.5 * t)" y1="=-2 + 1 * sin(1.5708 - tau * 2.5 * t)" x2="=-4 - 1 * cos(1.5708 - tau * 2.5 * t)" y2="=-2 - 1 * sin(1.5708 - tau * 2.5 * t)" paint="iron.lit"
    rect x=-4 y=-2 width=1 height=1 paint="brass.lit"
}

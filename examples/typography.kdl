// Text with the built-in font: no `use` and no `font` needed. Whole-text `bold` and
// `italic`, inline [b] [i] [size=N] tags that mix them in one line, and words that type in
// and gather from scattered pixels. Render it with: pxe export examples/typography.kdl

palette "type" {
    ramp "ink"   "#07080f" "#0e1120" "#171c33" "#232a48" "#323b60"
    ramp "paper" "#6c7290" "#9ca2bc" "#c8cde0" "#eceff8" "#ffffff"
    ramp "gold"  "#4a2e08" "#8a5c12" "#d09624" "#ffcc4e" "#fff2b0"
    ramp "teal"  "#06302f" "#0c5a58" "#14948e" "#3cd2c4" "#aef8ee"
    ramp "rose"  "#420a24" "#80183e" "#c8346a" "#ff6a96" "#ffc2d6"
}

scene "typography" palette="type" width=240 height=135 fps=12 duration="4s" background="ink.shade" {
    group "gather" x="=max(0, 1 - t * 1.5)"
    group "type" x="=max(0, t - 0.6) * 30"

    rect x=0 y=0 width=240 height=44 paint="ink.deep"
    text "[size=3][b]Pixel[/b] [i]type[/i][/size]" x=121 y=9 align="center" paint="rose.shade" scatter="=@gather.x * 70"
    text "[size=3][b]Pixel[/b] [i]type[/i][/size]" x=120 y=8 align="center" paint="gold.lit" scatter="=@gather.x * 60"
    rect x="=120 - 70 * min(1, t * 1.5)" y=38 width="=140 * min(1, t * 1.5)" height=1 paint="gold.base"

    text "plain, [b]bold[/b], [i]italic[/i] and [b][i]both[/i][/b]" x=12 y=54 paint="paper.lit" reveal="=@type.x"
    text "sizes [size=2]share[/size] [size=3]one[/size] bottom" x=12 y=70 paint="teal.lit" reveal="=@type.x - 34"
    text "a whole line in bold" x=12 y=102 bold=#true paint="rose.lit" reveal="=@type.x - 50"
    text "a whole line in italic" x=12 y=116 italic=#true paint="paper.base" reveal="=@type.x - 66"
}

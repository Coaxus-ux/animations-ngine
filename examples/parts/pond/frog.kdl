// A small frog seen from above, sitting at (0, 0) and facing up. It breathes, blinks and
// now and then its throat puffs out. Every 3 s.

use "pond-palette.kdl"

scene "frog" palette="pond" width=20 height=20 fps=12 duration="3s" loop=#true background="pad.base" {
    camera x=-10 y=-10

    ellipse x=-6 y=1 width=4 height=6 paint="frog.shade" outline="selective"
    ellipse x=2 y=1 width=4 height=6 paint="frog.shade" outline="selective"
    ellipse "body" x=-4 y="=-4 - round(osc(1.5s, 0, 0.6))" width=8 height=9 paint="frog" shading="dome" outline="selective"
    ellipse x=-2 y=-1 width=4 height=3 paint="frog.lit"
    ellipse x="=-1 - round(pulse(3s, 0.15))" y=-6 width="=2 + 2 * round(pulse(3s, 0.15))" height=2 paint="heart.hi" visible="=pulse(3s, 0.15)"
    ellipse x=-4 y=-6 width=3 height=3 paint="frog.lit" outline="selective"
    ellipse x=1 y=-6 width=3 height=3 paint="frog.lit" outline="selective"
    rect x=-3 y=-5 width=1 height="=1 - square(t / 3, 0.05)" paint="ink"
    rect x=2 y=-5 width=1 height="=1 - square(t / 3, 0.05)" paint="ink"
    line x1=-6 y1=-2 x2=-8 y2=-4 paint="frog.shade"
    line x1=5 y1=-2 x2=7 y2=-4 paint="frog.shade"
}

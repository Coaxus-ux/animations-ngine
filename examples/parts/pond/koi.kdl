// A koi seen from above, swimming toward +x with its head at (0, 0). Eight spine points each
// trail the swimming wave a little more, so the body bends and the tail sweeps. Built in
// layers like a painted koi: shadow on the floor, translucent fins with rays, a three-tone
// body with a scale texture, markings, a dorsal ridge and a detailed head. Colors come from
// params: `body`, `patch` (big markings), `spots` (with `spotted`); `metallic` adds a
// shimmer that runs down the body (ogon). One stroke of the tail per second.

use "pond-palette.kdl"

scene "koi" palette="pond" width=72 height=36 fps=12 duration="1s" loop=#true background="water.base" {
    param body "koi-white"
    param patch "koi-red"
    param spots "koi-black"
    param spotted #false
    param metallic #false
    camera x=-52 y=-18

    // The spine, head first: each point trails the wave by a little more
    group "s0" x=0 y="=0.3 * sin(tau * t)"
    group "s1" x=-5 y="=0.6 * sin(tau * t - 0.55)"
    group "s2" x=-10 y="=0.95 * sin(tau * t - 1.10)"
    group "s3" x=-15 y="=1.35 * sin(tau * t - 1.65)"
    group "s4" x=-20 y="=1.8 * sin(tau * t - 2.20)"
    group "s5" x=-25 y="=2.3 * sin(tau * t - 2.75)"
    group "s6" x=-30 y="=2.8 * sin(tau * t - 3.30)"
    group "s7" x=-34 y="=3.3 * sin(tau * t - 3.85)"
    group "tail" x="=@s7.x - 9" y="=@s7.y + 2.6 * sin(tau * t - 4.6)"

    // Shadow on the pond floor
    shade x="=@s2.x - 8" y="=@s2.y + 1" width=19 height=12 steps=-1 round=#true
    shade x="=@s5.x - 6" y="=@s5.y + 2" width=15 height=8 steps=-1 round=#true

    // Tail: a translucent fan, its rays and lit tips following the flick
    polygon x="=@s7.x" y="=@s7.y" points="1,-1 -6,-6 -9,-6 -6,0 -9,6 -6,6 1,1" paint="$body.lit" opacity=0.8
    line x1="=@s7.x" y1="=@s7.y" x2="=@tail.x" y2="=@tail.y - 6" paint="$body.lit"
    line x1="=@s7.x" y1="=@s7.y" x2="=@tail.x" y2="=@tail.y + 6" paint="$body.lit"
    line x1="=@s7.x - 1" y1="=@s7.y" x2="=@tail.x + 2" y2="=@tail.y - 3" paint="$body.base"
    line x1="=@s7.x - 1" y1="=@s7.y" x2="=@tail.x + 2" y2="=@tail.y + 3" paint="$body.base"
    line x1="=@s7.x - 1" y1="=@s7.y" x2="=@tail.x + 3" y2="=@tail.y" paint="$body.base"

    // Pectoral fins splay out behind the head and paddle in turn; pelvic fins further back
    polygon x="=@s1.x" y="=@s1.y - 3" points="1,0 0,-5 -3,-8 -7,-8 -8,-5 -4,0" paint="$body.lit"
    polygon x="=@s1.x" y="=@s1.y + 3" points="1,0 0,5 -3,8 -7,8 -8,5 -4,0" paint="$body.lit"
    line x1="=@s1.x - 1" y1="=@s1.y - 3" x2="=@s1.x - 3 - round(osc(1s, 0, 1))" y2="=@s1.y - 10" paint="$body.base"
    line x1="=@s1.x - 2" y1="=@s1.y - 3" x2="=@s1.x - 7 - round(osc(1s, 0, 1))" y2="=@s1.y - 9" paint="$body.base"
    line x1="=@s1.x - 1" y1="=@s1.y + 3" x2="=@s1.x - 3 - round(osc(1s, 1, 0))" y2="=@s1.y + 10" paint="$body.base"
    line x1="=@s1.x - 2" y1="=@s1.y + 3" x2="=@s1.x - 7 - round(osc(1s, 1, 0))" y2="=@s1.y + 9" paint="$body.base"
    polygon x="=@s4.x" y="=@s4.y - 3" points="0,0 -1,-4 -4,-5 -5,-3 -3,0" paint="$body.lit"
    polygon x="=@s4.x" y="=@s4.y + 3" points="0,0 -1,4 -4,5 -5,3 -3,0" paint="$body.lit"

    // Body as capsules between spine points, so it stays smooth at any zoom: a darker belly
    // a pixel lower, the main color with a scale texture, then a lit band along the back
    ellipse x="=@s0.x - 4" y="=@s0.y - 3" width=8 height=8 paint="$body.shade"
    line x1="=@s0.x" y1="=@s0.y + 1" x2="=@s1.x" y2="=@s1.y + 1" width=9 paint="$body.shade"
    line x1="=@s1.x" y1="=@s1.y + 1" x2="=@s2.x" y2="=@s2.y + 1" width=11 paint="$body.shade"
    line x1="=@s2.x" y1="=@s2.y + 1" x2="=@s3.x" y2="=@s3.y + 1" width=11 paint="$body.shade"
    line x1="=@s3.x" y1="=@s3.y + 1" x2="=@s4.x" y2="=@s4.y + 1" width=10 paint="$body.shade"
    line x1="=@s4.x" y1="=@s4.y + 1" x2="=@s5.x" y2="=@s5.y + 1" width=8 paint="$body.shade"
    line x1="=@s5.x" y1="=@s5.y + 1" x2="=@s6.x" y2="=@s6.y + 1" width=6 paint="$body.shade"
    line x1="=@s6.x" y1="=@s6.y + 1" x2="=@s7.x" y2="=@s7.y + 1" width=4 paint="$body.shade"
    ellipse x="=@s0.x - 4" y="=@s0.y - 4" width=8 height=7 paint="$body"
    line x1="=@s0.x" y1="=@s0.y" x2="=@s1.x" y2="=@s1.y" width=8 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s1.x" y1="=@s1.y" x2="=@s2.x" y2="=@s2.y" width=10 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s2.x" y1="=@s2.y" x2="=@s3.x" y2="=@s3.y" width=10 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s3.x" y1="=@s3.y" x2="=@s4.x" y2="=@s4.y" width=9 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s4.x" y1="=@s4.y" x2="=@s5.x" y2="=@s5.y" width=7 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s5.x" y1="=@s5.y" x2="=@s6.x" y2="=@s6.y" width=5 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s6.x" y1="=@s6.y" x2="=@s7.x" y2="=@s7.y" width=3 paint="$body" texture=0.3 texture-scale=1.5
    line x1="=@s1.x" y1="=@s1.y - 1.5" x2="=@s2.x" y2="=@s2.y - 1.5" width=4 paint="$body.lit"
    line x1="=@s2.x" y1="=@s2.y - 1.5" x2="=@s3.x" y2="=@s3.y - 1.5" width=4 paint="$body.lit"
    line x1="=@s3.x" y1="=@s3.y - 1.5" x2="=@s4.x" y2="=@s4.y - 1.5" width=4 paint="$body.lit"
    line x1="=@s4.x" y1="=@s4.y - 1.5" x2="=@s5.x" y2="=@s5.y - 1.5" width=3 paint="$body.lit"

    // The dorsal ridge, then the markings over it, following the body as it bends
    rope x1="=@s1.x" y1="=@s1.y - 1" x2="=@s6.x" y2="=@s6.y - 1" sag="=(@s3.y + @s4.y) / 2 - (@s1.y + @s6.y) / 2" paint="$body.hi"
    blob x="=@s1.x" y="=@s1.y" circles="1,-1,3.8 -4,1,3.4 -7,-2,2.8" smooth=2 paint="$patch" texture=0.25 texture-scale=1.5
    blob x="=@s4.x" y="=@s4.y" circles="2,-1,3.6 -2,1,3.2 -5,-1,2.2" smooth=2 paint="$patch" texture=0.25 texture-scale=1.5
    blob x="=@s6.x" y="=@s6.y" circles="0,0,1.8 -2,-1,1.4" smooth=1 paint="$patch"
    blob x="=@s0.x" y="=@s0.y" circles="0,-1,2 -1,1,1.6" smooth=1 paint="$patch"
    rect x="=@s2.x + 1" y="=@s2.y - 3" width=2 height=1 paint="$spots" visible="=$spotted"
    rect x="=@s3.x" y="=@s3.y + 2" width=2 height=2 paint="$spots" visible="=$spotted"
    rect x="=@s5.x" y="=@s5.y - 3" width=1 height=2 paint="$spots" visible="=$spotted"
    rect x="=@s6.x - 1" y="=@s6.y + 1" width=2 height=1 paint="$spots" visible="=$spotted"
    rect x="=@s3.x + 2" y="=@s3.y - 2" width=1 height=1 paint="$body.hi"
    rect x="=@s5.x + 2" y="=@s5.y - 2" width=1 height=1 paint="$body.hi"

    // A shimmer that runs down the body
    rect x="=-4 - mod(t * 28, 26)" y="=-1 + 0.8 * sin(tau * t - 1.2)" width=2 height=1 paint="$body.hi" visible="=$metallic"
    rect x="=-7 - mod(t * 28 + 13, 26)" y="=1 + 0.8 * sin(tau * t - 1.8)" width=1 height=1 paint="$body.hi" visible="=$metallic"

    // Head: gill lines, eyes with a catchlight, nostrils and barbels
    line x1="=@s1.x + 1" y1="=@s1.y - 4" x2="=@s1.x + 2" y2="=@s1.y - 1" paint="$body.shade"
    line x1="=@s1.x + 1" y1="=@s1.y + 4" x2="=@s1.x + 2" y2="=@s1.y + 1" paint="$body.shade"
    rect x="=@s0.x" y="=@s0.y - 4" width=2 height=1 paint="ink"
    rect x="=@s0.x" y="=@s0.y + 3" width=2 height=1 paint="ink"
    rect x="=@s0.x + 1" y="=@s0.y - 4" width=1 height=1 paint="koi-white.hi"
    rect x="=@s0.x + 1" y="=@s0.y + 3" width=1 height=1 paint="koi-white.hi"
    rect x="=@s0.x + 3" y="=@s0.y - 2" width=1 height=1 paint="$body.shade"
    rect x="=@s0.x + 3" y="=@s0.y + 1" width=1 height=1 paint="$body.shade"
    line x1="=@s0.x + 4" y1="=@s0.y - 1" x2="=@s0.x + 6" y2="=@s0.y - 2 + round(osc(1s, 0, 1))" paint="$body.shade"
    line x1="=@s0.x + 4" y1="=@s0.y + 1" x2="=@s0.x + 6" y2="=@s0.y + 2 - round(osc(1s, 0, 1))" paint="$body.shade"
}

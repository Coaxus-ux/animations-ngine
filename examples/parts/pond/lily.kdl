// A lily pad floating on the pond, its center at (0, 0), with a notch and veins. With
// `flower` it carries a lotus. It drifts and turns its shine a little every 4 s; anything can
// sit on it with `attach`.

use "pond-palette.kdl"

scene "lily" palette="pond" width=28 height=28 fps=12 duration="4s" loop=#true background="water.base" {
    param flower #false
    camera x=-14 y=-14

    group "drift" x="=osc(4s, -0.6, 0.6)" y="=osc(4s, 0.4, -0.4)"
    shade x="=@drift.x - 7" y="=@drift.y - 5" width=19 height=18 steps=-1 round=#true
    polygon "pad" x="=@drift.x" y="=@drift.y" points="0.0,0.0 9.0,0.0 5.3,7.3 2.8,8.6 0.0,9.0 -2.8,8.6 -5.3,7.3 -7.3,5.3 -8.6,2.8 -9.0,0.0 -8.6,-2.8 -7.3,-5.3 -5.3,-7.3 -2.8,-8.6 -0.0,-9.0 2.8,-8.6 5.3,-7.3 7.3,-5.3 8.6,-2.8" paint="pad" shading="dome" outline="selective"
    line x1="=@drift.x" y1="=@drift.y" x2="=@drift.x + 3.0" y2="=@drift.y + 5.2" paint="pad.lit"
    line x1="=@drift.x" y1="=@drift.y" x2="=@drift.x + -3.4" y2="=@drift.y + 4.9" paint="pad.lit"
    line x1="=@drift.x" y1="=@drift.y" x2="=@drift.x + -5.9" y2="=@drift.y + -1.0" paint="pad.lit"
    line x1="=@drift.x" y1="=@drift.y" x2="=@drift.x + -1.6" y2="=@drift.y + -5.8" paint="pad.lit"
    line x1="=@drift.x" y1="=@drift.y" x2="=@drift.x + 4.6" y2="=@drift.y + -3.9" paint="pad.lit"
    rect x="=@drift.x - 4" y="=@drift.y - 5" width=2 height=1 paint="pad.hi" tone-shift="=-round(osc(4s, 0, 1))"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 0.5,2.6 4.4,2.9 7.9,1.4 5.1,-1.2 1.3,-2.2" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -1.4,2.2 1.1,5.1 4.6,6.6 4.5,2.7 2.5,-0.6" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -2.6,0.5 -2.9,4.4 -1.4,7.9 1.2,5.1 2.2,1.3" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -2.2,-1.4 -5.1,1.1 -6.6,4.6 -2.7,4.5 0.6,2.5" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -0.5,-2.6 -4.4,-2.9 -7.9,-1.4 -5.1,1.2 -1.3,2.2" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 1.4,-2.2 -1.1,-5.1 -4.6,-6.6 -4.5,-2.7 -2.5,0.6" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 2.6,-0.5 2.9,-4.4 1.4,-7.9 -1.2,-5.1 -2.2,-1.3" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 2.2,1.4 5.1,-1.1 6.6,-4.6 2.7,-4.5 -0.6,-2.5" paint="lotus" shading="dome" outline="selective" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -0.5,2.1 1.7,3.3 4.5,3.2 3.7,0.5 1.8,-1.2" paint="lotus.lit" shading="dome" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -2.1,0.6 -2.0,3.1 -0.5,5.5 1.5,3.4 2.0,1.0" paint="lotus.lit" shading="dome" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -1.6,-1.5 -3.7,-0.2 -5.0,2.3 -2.2,3.0 0.1,2.2" paint="lotus.lit" shading="dome" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 0.5,-2.1 -1.7,-3.3 -4.5,-3.2 -3.7,-0.5 -1.8,1.2" paint="lotus.lit" shading="dome" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 2.1,-0.6 2.0,-3.1 0.5,-5.5 -1.5,-3.4 -2.0,-1.0" paint="lotus.lit" shading="dome" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 1.6,1.5 3.7,0.2 5.0,-2.3 2.2,-3.0 -0.1,-2.2" paint="lotus.lit" shading="dome" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -1.0,1.2 -0.1,2.5 1.8,3.0 2.2,1.2 1.6,-0.2" paint="lotus.hi" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 -1.2,-1.0 -2.5,-0.1 -3.0,1.7 -1.2,2.2 0.2,1.6" paint="lotus.hi" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 1.0,-1.2 0.1,-2.5 -1.8,-3.0 -2.2,-1.2 -1.6,0.2" paint="lotus.hi" visible="=$flower"
    polygon x="=@drift.x" y="=@drift.y" points="0.0,0.0 1.2,1.0 2.5,0.1 3.0,-1.8 1.2,-2.2 -0.2,-1.6" paint="lotus.hi" visible="=$flower"
    ellipse x="=@drift.x - 1.5" y="=@drift.y - 1.5" width=4 height=4 paint="heart.base" shading="dome" visible="=$flower"
    rect x="=@drift.x" y="=@drift.y - 1" width=1 height=1 paint="heart.hi" visible="=$flower"
}

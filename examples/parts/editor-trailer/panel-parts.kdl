// The small pieces the trailer's editor is built from: a panel title bar, a button, the tool
// bar, row icons, the timeline ruler with its frame ticks, a key diamond and the pointer.

use "editor-palette.kdl"

scene "panel-title" palette="editor" width=352 height=10 fps=12 duration="1s" loop=#true background="ui-title" {
    param width 125
    param title "Panel"

    rect x=0 y=0 width="=$width" height=10 paint="ui-title"
    text "$title" x=5 y=1 paint="ui-ink-hi"
    rect x="=$width - 21" y=2 width=6 height=6 paint="ui-ink-hi"
    rect x="=$width - 20" y=3 width=4 height=4 paint="ui-title"
    line x1="=$width - 18" y1=5 x2="=$width - 14" y2=1 paint="ui-ink-hi"
    rect x="=$width - 9" y=4 width=6 height=2 paint="ui-ink-hi"
}

scene "button" palette="editor" width=64 height=11 fps=12 duration="1s" loop=#true background="ui-panel" {
    param width 40
    param label "Button"
    param enabled #true

    rect x=0 y=0 width="=$width" height=11 paint="ui-raised" visible="=$enabled"
    rect x="=$width - 1" y=0 width=1 height=11 paint="ui-bar" visible="=$enabled"
    rect x=0 y=0 width="=$width" height=11 paint="ui-bar" visible="=1 - $enabled"
    text "$label" x=5 y=1 paint="ui-ink-hi" visible="=$enabled"
    text "$label" x=5 y=1 paint="ui-disabled" visible="=1 - $enabled"
}

scene "tool-bar" palette="editor" width=18 height=228 fps=12 duration="1s" loop=#true background="ui-title" {
    param tool 0

    use-scene "tool-cell" count=11 y="=21 * i"
    rect x=0 y="=21 * $tool" width=18 height=18 paint="ui-accent"

    capsule x1=5 y1=13 x2=13 y2=5 radius=1.5 paint="ui-ink-hi"
    line x1=12 y1=4 x2=14 y2=6 paint="ui-accent-hi"
    line x1=3 y1=15 x2=4 y2=14 paint="ui-warning"

    polygon x=3 y=24 points="7,0 12,5 6,11 1,6" paint="ui-accent-hi"
    polygon x=3 y=24 points="1,6 4,3 9,8 6,11" paint="ui-ink-hi"

    polygon x=3 y=46 points="6,0 12,6 7,11 1,6" paint="ui-ink-hi"
    polygon x=3 y=46 points="1,6 12,6 7,11" paint="ui-accent-hi"
    rect x=14 y=53 width=2 height=3 paint="ui-accent-hi"

    line x1=3 y1=78 x2=14 y2=67 paint="ui-ink-hi"

    rect x=3 y=88 width=12 height=10 paint="ui-ink-hi"
    rect x=4 y=89 width=10 height=8 paint="ui-panel"

    ellipse x=3 y=108 width=12 height=11 paint="ui-ink-hi"
    ellipse x=4 y=109 width=10 height=9 paint="ui-panel"

    capsule x1=4 y1=140 x2=11 y2=133 radius=1 paint="ui-accent-hi"
    capsule x1=11 y1=133 x2=13 y2=131 radius=1.5 paint="ui-ink-hi"

    rect x=3 y=151 width=12 height=10 paint="ui-ink-hi"
    rect x=4 y=152 width=10 height=8 paint="ui-panel"
    rect x=6 y=151 width=2 height=10 paint="ui-panel"
    rect x=11 y=151 width=2 height=10 paint="ui-panel"
    rect x=3 y=154 width=12 height=2 paint="ui-panel"

    ellipse x=3 y=171 width=12 height=8 paint="ui-ink-hi"
    ellipse x=4 y=172 width=10 height=6 paint="ui-panel"
    line x1=6 y1=179 x2=8 y2=183 paint="ui-ink-hi"

    rect x=8 y=192 width=2 height=12 paint="ui-ink-hi"
    rect x=3 y=197 width=12 height=2 paint="ui-ink-hi"
    polygon x=6 y=191 points="3,0 6,3 0,3" paint="ui-ink-hi"
    polygon x=6 y=203 points="0,0 6,0 3,3" paint="ui-ink-hi"

    polygon x=5 y=212 points="0,0 0,11 3,8 5,12 7,11 5,7 9,7" paint="ui-accent-hi" outline="full" outline-paint="ui-ink-hi"
}

scene "tool-cell" palette="editor" width=18 height=18 fps=12 duration="1s" loop=#true background="ui-panel" {
    rect x=0 y=0 width=18 height=18 paint="ui-panel"
}

scene "inspector-field" palette="editor" width=63 height=11 fps=12 duration="1s" loop=#true background="ui-panel" {
    rect x=0 y=0 width=63 height=11 paint="ui-field"
}

scene "eye" palette="editor" width=8 height=8 fps=12 duration="1s" loop=#true background="ui-panel" {
    pixels "eye-icon" {
        legend { i "ui-ink-hi"; a "ui-accent" }
        cel """
        ........
        ..iiii..
        .i....i.
        i..aa..i
        i..aa..i
        .i....i.
        ..iiii..
        ........
        """
    }
}

scene "file-icon" palette="editor" width=8 height=8 fps=12 duration="1s" loop=#true background="ui-panel" {
    pixels "file-icon" {
        legend { i "ui-ink-hi" }
        cel """
        iiii....
        i..ii...
        i...i...
        i...i...
        i...i...
        i...i...
        iiiii...
        ........
        """
    }
}

scene "ruler" palette="editor" width=350 height=10 fps=12 duration="1s" loop=#true background="ui-bar" {
    param from "0.0s"
    param l0 "|0s"
    param l1 "|1s"
    param l2 "|2s"
    param l3 "|3s"
    param l4 "|4s"
    param l5 "|5s"
    param l6 "|6s"

    rect x=0 y=0 width=350 height=10 paint="ui-bar"
    use-scene "tick" count=72 x="=46 + i * 4"
    text "$from" x=5 y=1 paint="ui-ink"
    text "$l0" x=45 y=1 paint="ui-ink"
    text "$l1" x=93 y=1 paint="ui-ink"
    text "$l2" x=141 y=1 paint="ui-ink"
    text "$l3" x=189 y=1 paint="ui-ink"
    text "$l4" x=237 y=1 paint="ui-ink"
    text "$l5" x=285 y=1 paint="ui-ink"
    text "$l6" x=333 y=1 paint="ui-ink"
}

scene "tick" palette="editor" width=1 height=10 fps=12 duration="1s" loop=#true background="ui-bar" {
    rect x=0 y=8 width=1 height=1 paint="ui-ink"
}

scene "key" palette="editor" width=5 height=5 fps=12 duration="1s" loop=#true background="ui-panel" {
    polygon x=-2 y=0 points="2,0 4,2 2,4 0,2" paint="ui-ink-hi"
}

scene "pointer" palette="editor" width=10 height=14 fps=12 duration="1s" loop=#true background="ui-window" {
    polygon x=0 y=0 points="0,0 0,12 3,9 5,14 7,13 5,8 9,8" paint="ui-ink-hi" outline="full" outline-paint="ui-backdrop"
}

scene "click" palette="editor" width=1 height=1 fps=12 duration="0.25s" background="ui-window" {
    group "spread" x="=2 + 32 * t"
    rect x="=-1 - @spread.x" y=0 width=2 height=1 paint="ui-accent-hi"
    rect x="=@spread.x" y=0 width=2 height=1 paint="ui-accent-hi"
    rect x=0 y="=-1 - @spread.x" width=1 height=2 paint="ui-accent-hi"
    rect x=0 y="=@spread.x" width=1 height=2 paint="ui-accent-hi"
}

scene "selection" palette="editor" width=256 height=256 fps=12 duration="1s" loop=#true background="ui-window" {
    param width 32
    param height 32

    rect x=-1 y=-1 width="=$width + 2" height=1 paint="ui-accent-hi"
    rect x=-1 y="=$height" width="=$width + 2" height=1 paint="ui-accent-hi"
    rect x=-1 y=0 width=1 height="=$height" paint="ui-accent-hi"
    rect x="=$width" y=0 width=1 height="=$height" paint="ui-accent-hi"
}

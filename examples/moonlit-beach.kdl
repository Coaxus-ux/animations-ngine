// Two lovers by a campfire on the beach, watching the sea under a full moon. She rests her head
// on his shoulder, his arm around her; the fire warms them while the moon silvers the water,
// a dolphin leaps across the face of the moon, and the waves lap the shore.
// Shows: two light colors at once (warm fire, silver moon), a dolphin whose body follows the
// tangent of its arc through reference helpers, a rippling moon path, timed splashes,
// hair and palm fronds moved by the wind. Loops every 4 seconds.

palette "moonlit" {
    ramp "sky"          "#0d0f2e" "#181b4a" "#262a66" "#383c82" "#5052a0"
    ramp "sky-moon"     "#1a1c42" "#2a2c62" "#3e4082" "#5658a2" "#7476c2"
    ramp "moon"         "#b8c4dc" "#e2e8f4" "#ffffff"
    ramp "sea"          "#020c14" "#041724" "#082436" "#0e344c" "#164866"
    ramp "sea-moon"     "#06141e" "#0c2232" "#163448" "#244a62" "#38667e"
    ramp "foam"         "#6a86a8" "#a8c0d8" "#e0ecf8"
    ramp "sand"         "#2a2430" "#3e3440" "#564856" "#70606c" "#8c7a84"
    ramp "sand-warm"    "#3a2420" "#583428" "#7a4a34" "#a06642" "#c88a56"
    ramp "sand-moon"    "#2e3040" "#444858" "#5e6474" "#7c8494" "#a0a8b8"
    ramp "wood"         "#140e0c" "#22180f" "#342414" "#48321c" "#5e4426"
    ramp "wood-warm"    "#2a1206" "#4a210a" "#6e3410" "#964c17" "#c06a20"
    ramp "palm"         "#06100e" "#0c1a16" "#132620" "#1c342c" "#284438"
    ramp "dolphin"      "#1a2a40" "#2a405e" "#3e5a80" "#5678a0" "#7698c0"
    ramp "dolphin-moon" "#2a3a52" "#3e5474" "#58749a" "#7896bc" "#9cbadc"
    ramp "shirt"        "#3a3a48" "#5a5a6c" "#82828e" "#aaaab4" "#d0d0d8"
    ramp "shirt-warm"   "#4a3226" "#70503a" "#9a7252" "#c49a70" "#ecc496"
    ramp "dress"        "#3a1020" "#5e1a30" "#8a2a44" "#b83e58" "#e05a70"
    ramp "dress-warm"   "#4a1418" "#742424" "#a23a30" "#cc5640" "#f27a52"
    ramp "hair"         "#0e0a0e" "#1c1418" "#2c2026" "#3e2e34" "#524048"
    ramp "hair-warm"    "#1e0e08" "#341a0e" "#4e2a16" "#6c3c20" "#8c522c"
    ramp "brunette"     "#0e0806" "#170e0a" "#22150f" "#2f1d15" "#3d271c"
    ramp "brunette-warm" "#170c08" "#22130c" "#311c12" "#432719" "#573322"
    ramp "skin"         "#4a2c22" "#6e4433" "#946049" "#b87e60" "#d9a07c"
    ramp "skin-warm"    "#5a2c18" "#844126" "#ad5c36" "#d27c48" "#f0a060"
    ramp "blanket"      "#1e1a34" "#2c264c" "#3c3466" "#4e4482" "#64589e"
    ramp "blanket-warm" "#3a1e22" "#5a2c2c" "#7c3e38" "#a25446" "#c86e56"
    ramp "fire"         "#7a2e0e" "#c8521a" "#f08a24" "#ffc65a" "#fff1b8"
    ramp "rose"         "#a83a5a" "#e05a80" "#ff9ab8"
    twin "sky" moon="sky-moon"
    twin "sea" moon="sea-moon"
    twin "sand" warm="sand-warm" moon="sand-moon"
    twin "dolphin" moon="dolphin-moon"
    twin "wood" warm="wood-warm"
    twin "shirt" warm="shirt-warm"
    twin "dress" warm="dress-warm"
    twin "hair" warm="hair-warm"
    twin "brunette" warm="brunette-warm"
    twin "skin" warm="skin-warm"
    twin "blanket" warm="blanket-warm"
}

motif star x y tone odds salt { rect $x $y 1 1 paint=moon.$tone emissive=#true visible="=chance($odds, mod(floor(t * 3), 12) + $salt)" }
motif glint x y w tone salt { rect $x $y $w 1 paint=foam.$tone emissive=#true visible="=chance(0.6, mod(floor(t * 6), 24) + $salt)" }
motif moon-dash x period swing y w tone { rect "=$x + osc($period, $swing, -$swing)" $y $w 1 paint=moon.$tone emissive=#true }
motif splash name x from until left right {
    ellipse "splash-$name" "=$x - @self.width / 2" 64 "=4 + (t - $from) * 40" 3 paint=foam.lit visible="=between($from, $until)"
    rect "=$x-4" "=62 - sin(pi * (t - $from) / 0.4) * $left" 1 1 paint=foam.hi visible="=between($from, $until)"
    rect "=$x+4" "=62 - sin(pi * (t - $from) / 0.4) * $right" 1 1 paint=foam.hi visible="=between($from, $until)"
}

scene "moonlit-beach" palette=moonlit width=192 height=128 fps=12 duration="4s" loop=#true seed=14 background=sky.base {
    ambient darkness=1 occlusion=1 key-light=300
    wind strength=1 gust=0.5 speed=4

    // Sky: a deep gradient, a glowing full moon, thin clouds and twinkling stars
    layer "sky" parallax=0 {
        rect 0 0 "100%" 60 paint=sky.deep gradient=down gradient-steps=3
        ellipse 125 27 24 24 paint=sky.lit emissive=#true
        ellipse "moon" 128 30 18 18 paint=moon.lit emissive=#true
        ellipse 131 33 4 3 paint=moon.base emissive=#true
        ellipse 138 39 3 3 paint=moon.base emissive=#true
        rect 136 33 1 1 paint=moon.base emissive=#true
        rect 131 40 2 1 paint=moon.base emissive=#true
        blob "=40 + osc(4s, -3, 3)" 22 circles="0,0,3 8,-1,4 18,0,3 26,1,2" smooth=4 paint=sky.lit shading=dome
        blob "=160 + osc(4s, 2, -2)" 14 circles="0,0,2 6,-1,3 13,0,2" paint=sky.lit shading=dome
        star 14 8 hi 0.85 0
        star 36 36 base 0.8 1
        star 66 12 hi 0.9 2
        star 88 30 base 0.8 3
        rect 100 6 1 1 paint=moon.hi emissive=#true
        star 172 34 base 0.85 4
        star 184 10 hi 0.8 5
        rect 6 44 1 1 paint=moon.base emissive=#true
    }
    light-rect 0 0 192 128 reach=1 intensity=1.2 color=moon

    // The sea, with a path of glints under the moon and its reflection
    rect "sea" 0 60 "100%" 40 paint=sea.lit gradient=down gradient-steps=-2
    rect 0 59 "100%" 1 paint=sky.hi emissive=#true
    rect 0 60 "100%" 1 paint=sea.deep
    glint 126 64 6 hi 0
    glint 138 66 5 hi 1
    glint 130 70 7 lit 2
    glint 142 74 6 hi 3
    glint 124 78 8 lit 4
    glint 136 82 9 hi 5
    glint 122 86 7 lit 6
    glint 146 88 8 lit 7
    rect "=40 + osc(4s, -4, 4)" 68 14 1 paint=sea.lit
    rect "=80 + osc(2s, 3, -3)" 76 18 1 paint=sea.lit
    rect "=20 + osc(4s, 3, -3)" 84 22 1 paint=sea.lit
    rect "=170 + osc(2s, -3, 3)" 80 16 1 paint=sea.lit

    // A dolphin leaps across the moon once per loop. `jump` holds the arc's progress (x)
    // and the angle of its tangent (y); the body is drawn along that angle.
    rect "jump" "=clamp((t - 0.8) / 1.6, 0, 1)" "=atan2(-30 * pi * cos(pi * @self.x), 60)" 1 1 paint=sea.base visible=0
    rect "arc" "=108 + 60 * @jump.x" "=66 - 30 * sin(pi * @jump.x)" 1 1 paint=sea.base visible=0
    group "dolphin" {
        capsule "=@arc.x" "=@arc.y" "=@arc.x + cos(@jump.y) * 6" "=@arc.y + sin(@jump.y) * 6" radius=4 paint=dolphin.shade shading=dome outline=selective visible="=between(0.8s, 2.4s)"
        capsule "=@arc.x" "=@arc.y" "=@arc.x - cos(@jump.y) * 10" "=@arc.y - sin(@jump.y) * 10" radius=2.5 paint=dolphin.shade shading=dome outline=selective visible="=between(0.8s, 2.4s)"
        capsule "=@arc.x + cos(@jump.y) * 6" "=@arc.y + sin(@jump.y) * 6" "=@arc.x + cos(@jump.y) * 12" "=@arc.y + sin(@jump.y) * 12" radius=1.5 paint=dolphin.base visible="=between(0.8s, 2.4s)"
        polygon "=@arc.x + sin(@jump.y) * 3" "=@arc.y - cos(@jump.y) * 3" points="-3,0 1,-7 4,0" paint=dolphin.deep visible="=between(0.8s, 2.4s)"
        blob "=@arc.x - cos(@jump.y) * 13" "=@arc.y - sin(@jump.y) * 13" circles="0,-3,2 0,3,2" smooth=1.5 paint=dolphin.deep visible="=between(0.8s, 2.4s)"
    }
    splash in 108 "0.7s" "1.1s" 6 8
    splash out 168 "2.3s" "2.7s" 7 5

    // The moon's path on the water: rippling silver dashes, wider near the shore
    moon-dash 131 "2s" -1 62 12 lit
    moon-dash 129 "2s" 1 64 16 base
    moon-dash 133 "1s" -1 66 9 lit
    moon-dash 128 "2s" -2 69 18 base
    moon-dash 132 "1s" 1 72 11 lit
    moon-dash 126 "2s" 2 75 22 base
    moon-dash 131 "1s" -2 79 13 lit
    moon-dash 124 "2s" -2 83 26 base
    moon-dash 130 "1s" 2 87 15 base

    // The shore: lapping foam over wet sand, then the dry beach
    rect 0 92 "100%" 36 paint=sand.base texture=0.2 texture-scale=3 gradient=down gradient-steps=-1
    rect 0 92 "100%" 4 paint=sand.shade
    rect "wave" 0 "=91 + osc(4s, -1.5, 1.5)" "100%" 1 paint=foam.lit
    rect 20 "=@wave.y + 1" 40 1 paint=foam.base visible="=osc(4s) > 0"
    rect 120 "=@wave.y + 1" 56 1 paint=foam.base visible="=osc(4s) > 0"
    blob 0 118 circles="0,0,14 20,4,12 40,2,10" smooth=6 paint=sand.lit texture=0.25 texture-scale=3

    // A palm leaning over the beach, fronds stirring in the breeze
    rope "trunk" 184 118 164 50 sag=-6 width=4 paint=palm.shade casts-shadow=#true
    polygon "=@trunk.x2 + osc(4s, -1, 1)" 48 points="0,0 -14,4 -26,12 -12,6" paint=palm.base shading=dome casts-shadow=#true
    polygon "=@trunk.x2 + osc(4s, 1, -1)" 48 points="0,0 12,2 24,10 10,6" paint=palm.base shading=dome casts-shadow=#true
    polygon 164 "=46 + osc(2s, -1, 1)" points="0,0 -8,-8 -18,-10 -6,-4" paint=palm.lit shading=dome
    polygon 164 "=46 + osc(2s, 1, -1)" points="0,0 8,-8 18,-8 6,-3" paint=palm.lit shading=dome

    // The campfire in front of the couple
    blob 108 106 circles="0,0,3 6,1,3 12,0,3 18,1,3" smooth=2 paint=sand.deep shading=dome outline=selective contact-shadow=1
    capsule 110 104 124 100 radius=1.5 paint=wood.base shading=dome
    capsule 110 100 124 104 radius=1.5 paint=wood.lit shading=dome
    blob "flame" "=117 + wiggle(1, 3)" 99 circles="0,0,4 -2,-4,3 1,-7,2" smooth=2 paint=fire.lit emissive=#true
    blob "=117 + wiggle(1, 4)" 100 circles="0,0,2.5 0,-4,1.5" smooth=1 paint=fire.hi emissive=#true tone-shift="=round(wiggle(0.6, 5))"
    light-point 117 96 reach=80 intensity="=3 + wiggle(0.4, 4)" color=warm shadows=#true
    particles 113 86 8 6 count=8 vy=-16 life="1s" wind=2 streak="0.05s" paint=fire.hi emissive=#true fade=#true

    // The lovers, seen from behind, sitting close on a blanket
    polygon 50 108 points="0,6 52,0 58,13 4,18" paint=blanket.base texture=0.25 texture-scale=2 shading=dome outline=selective
    rounded-rect "his-back" 58 92 17 20 radius=6 paint=shirt.base shading=dome outline=selective casts-shadow=#true
    rect 64 89 5 4 paint=skin.shade
    ellipse "his-head" 60 79 12 13 paint=hair.base shading=dome outline=selective casts-shadow=#true
    rounded-rect "her-back" 77 97 13 16 radius=5 paint=dress.base shading=dome outline=selective casts-shadow=#true
    blob "her-hair" 82 94 circles="0,0,5 1,6,5 0,11,4" paint=brunette.base shading=dome outline=selective casts-shadow=#true
    rope 84 96 "=86 + wind(86) * 2" 108 sway="=osc(4s, -1, 1)" paint=brunette.lit
    rope 80 96 "=81 + wind(81) * 2" 107 sway="=osc(4s, 1, -1)" paint=brunette.shade
    ellipse "her-head" 72 85 10 11 paint=brunette.base shading=dome outline=selective casts-shadow=#true
    blob 79 87 circles="0,0,1.5 2,1,1.5 0,2,1.5" smooth=1 paint=rose.base
    capsule 72 96 89 99 paint=shirt.lit shading=dome outline=selective
    ellipse 87 97 4 4 paint=skin.base shading=dome

    // One small heart drifting up from them
    group "heart" {
        blob "heart-top" 73 "=78 - fract(t / 4) * 22" circles="0,0,1.6 3,0,1.6" smooth=1 paint=rose.lit emissive=#true visible="=fract(t / 4) < 0.8"
        polygon "=@heart-top.x - 1.6" "=@heart-top.y" points="0,0 6.2,0 3.1,3.5" paint=rose.lit emissive=#true visible="=fract(t / 4) < 0.8"
    }
}

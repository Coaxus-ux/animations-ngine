// A passenger carriage seen from the side, its front coupling at (0, 0) and its body
// stretching back to x = -58. Four lit windows, each a clip group holding a passenger (a
// placed scene), so people show only through the glass. The window light spills on whatever
// is near. Wheels turn twice a second. `color` sets the livery.

use "train-palette.kdl"
use "passenger.kdl"
use "wheel.kdl"

motif train-window x offset hair=hair coat=coat reading=#true {
    rect "=$x-1" -20 12 11 paint=ink
    rect $x -19 10 9 paint=window.lit emissive=#true gradient=down gradient-steps=-1
    group $x -19 10 9 clip=#true {
        use-scene "passenger" "=$x+4" -6 scale=0.7 offset=$offset hair=$hair coat=$coat reading=$reading
    }
    rect $x -19 10 1 paint=window.hi emissive=#true
}

scene "carriage" palette=night-train width=72 height=36 fps=12 duration="12s" loop=#true background=sky.base {
    param color "car"
    param sleepers #false
    camera -66 -30

    // Underframe and bogies
    rect -56 -6 54 2 paint=iron.base
    rect -54 -5 14 2 paint=iron.shade
    train-wheel -51 -2
    train-wheel -43 -2
    rect -18 -5 14 2 paint=iron.shade
    train-wheel -15 -2
    train-wheel -7 -2

    // Body, roof and the window band
    rounded-rect "body" -58 -25 58 20 paint=$color shading=dome outline=selective casts-shadow=#true
    rounded-rect -59 -28 60 4 paint=iron.lit shading=dome outline=selective
    rect -50 -30 4 2 paint=iron.base
    rect -20 -30 4 2 paint=iron.base
    rect -58 -21 58 1 paint=brass.shade
    rect -58 -9 58 1 paint=brass.shade
    rect -4 -21 3 12 paint=$color.shade outline=full outline-paint=ink
    rect -1 -20 3 10 paint=iron.shade
    rect -30 -8 6 2 paint=brass.lit
    train-window -54 "0.0s"
    train-window -42 "0.7s" coat=car reading=#false
    train-window -30 "1.4s" hair=brass
    train-window -18 "2.1s" coat=train
    light-rect -56 -19 52 9 reach=36 intensity=1.8 color=lamp
}

// A five-storey pagoda in red lacquer on a stone plinth, its base centered at (0, 0). Each
// storey is lit on its west (right) side and shaded under its eaves; bells hang from the
// roof corners, lanterns from the lowest eaves, and its windows glow after `lights-on`
// (host seconds).

use "fuji-palette.kdl"

motif fuji-storey y half height {
    rect "=-$half" $y "=$half*2" $height paint=lacquer.3 casts-shadow=#true
    rect "=-$half" $y 2 $height paint=lacquer.1
    rect "=$half-2" $y 2 $height paint=lacquer.4
    rect "=$half-1" "=$y+1" 1 "=$height-1" paint=lacquer.5
    rect "=2-$half" $y "=$half*2-4" 2 paint=lacquer.1
    rect "=3-$half" "=$y+3" "=$half*2-6" "=$height-5" paint=lacquer.2
}
motif fuji-window y height glow bright {
    rect -2 $y 4 $height paint=lamp.2 emissive=#true visible="=t > $lights-on + $glow"
    rect -1 "=$y+1" 2 "=$height-2" paint=lamp.4 emissive=#true visible="=t > $lights-on + $bright"
}
motif fuji-roof y eave mid inner {
    polygon 0 $y points="-$eave,-1 -$mid,1 $mid,1 $eave,-1 $inner,-3 -$inner,-3" paint=tile.2 casts-shadow=#true
    polygon 0 $y points="$eave,-1 $mid,1 2,1 2,-3 $inner,-3" paint=tile.3
    rect "=-$inner" "=$y-3" "=$inner*2" 1 paint=tile.4
    line $inner "=$y-3" $eave "=$y-1" paint=tile.4
    rect "=-$mid" "=$y+1" "=$mid*2" 1 paint=tile.0
    rect "=-$eave" $y 1 2 paint=lamp.1
    rect $eave $y 1 2 paint=lamp.1
}

scene "pagoda" palette=fuji width=48 height=80 fps=12 duration="16s" background=sky-day.5 {
    param lights-on 10
    camera -24 -72

    rect -17 -2 34 4 paint=plaster.1 texture=0.4 texture-scale=1.5 shading=soft contact-shadow=1
    rect -15 -4 30 2 paint=plaster.2 texture=0.3 texture-scale=1.5
    rect -12 -5 24 1 paint=plaster.3
    rect -3 -2 6 4 paint=plaster.3 texture=0.3 texture-scale=1
    rect -3 0 6 1 paint=plaster.1
    fuji-storey -15 9 10
    rect -5 -12 1 5 paint=lacquer.3
    rect -2 -12 1 5 paint=lacquer.3
    rect 1 -12 1 5 paint=lacquer.4
    rect 4 -12 1 5 paint=lacquer.4
    rect -8 -6 16 1 paint=tile.4
    fuji-window -12 5 0.0 0.4
    fuji-storey -24 8 9
    rect -4 -21 1 4 paint=lacquer.3
    rect -1 -21 1 4 paint=lacquer.3
    rect 2 -21 1 4 paint=lacquer.4
    rect -7 -16 14 1 paint=tile.4
    fuji-storey -33 7 9
    rect -3 -30 1 4 paint=lacquer.3
    rect 0 -30 1 4 paint=lacquer.3
    rect -6 -25 12 1 paint=tile.4
    fuji-window -30 4 1.2 1.6
    fuji-storey -41 6 8
    rect -2 -38 1 3 paint=lacquer.3
    rect 1 -38 1 3 paint=lacquer.4
    rect -5 -34 10 1 paint=tile.4
    fuji-window -38 3 1.8 2.2
    fuji-storey -49 5 8
    rect -1 -46 1 3 paint=lacquer.3
    rect -4 -42 8 1 paint=tile.4
    fuji-roof -15 17 14 12
    fuji-roof -24 15 12 10
    fuji-roof -33 13 10 8
    fuji-roof -41 11 8 6
    fuji-roof -49 9 6 4
    rect 0 -67 1 15 paint=tile.1
    rect 1 -67 1 15 paint=tile.3
    rect -1 -55 4 1 paint=lamp.1
    rect -1 -57 4 1 paint=lamp.0
    rect -1 -59 4 1 paint=lamp.1
    rect -1 -61 4 1 paint=lamp.0
    rect -1 -63 4 1 paint=lamp.1
    rect -1 -65 4 1 paint=lamp.0
    ellipse -1 -70 4 4 paint=lamp.2 shading=dome
    line -16 -15 -16 -12 paint=ink
    rounded-rect -17 -12 3 4 radius=1 paint=lamp.3 emissive=#true visible="=t > $lights-on"
    rounded-rect -17 -12 3 4 radius=1 paint=lacquer.2 visible="=t <= $lights-on"
    line 16 -15 16 -12 paint=ink
    rounded-rect 15 -12 3 4 radius=1 paint=lamp.3 emissive=#true visible="=t > $lights-on"
    rounded-rect 15 -12 3 4 radius=1 paint=lacquer.2 visible="=t <= $lights-on"
}

// A harbor at nightfall. The lighthouse beam sweeps the sky and sea once per loop, boats bob
// at anchor with their lanterns lit, ropes sag between the dock posts and gulls circle.
// Shows: a keyframed rotating cone light with a twin color, reflections on the sea ramp,
// textured cliffs, polygons, ropes, bobbing with expressions, parallax clouds. Loops every 4 seconds.

palette "harbor" {
    ramp "sky"        "#121a2e" "#1c2742" "#2a3858" "#3d4e72" "#566a8e"
    ramp "sky-beam"   "#3a3a3c" "#5a5650" "#857c66" "#b8a67c" "#e6d29a"
    ramp "dusk"       "#3a2a48" "#5e3a5a" "#8a4e62" "#c06a64" "#e89a72"
    ramp "dusk-beam"  "#5a4a54" "#7e5e62" "#a8806e" "#d0a07a" "#f4c48e"
    ramp "cloud"      "#1e2840" "#2c3858" "#3e4c70" "#56648a" "#7480a6"
    ramp "cloud-beam" "#4a4644" "#6c6458" "#988a6c" "#c6b284" "#f0dca4"
    ramp "sea"        "#0b1424" "#122036" "#1a2d4a" "#253d60" "#335078"
    ramp "sea-beam"   "#222428" "#363634" "#545044" "#7c7458" "#a89a70"
    ramp "rock"       "#141619" "#1f2226" "#2c3036" "#3c4249" "#50575f"
    ramp "rock-beam"  "#2e2c24" "#444030" "#605840" "#827654" "#a8986a"
    ramp "wall"       "#4a4c58" "#6e7080" "#9496a6" "#babccc" "#e0e2ee"
    ramp "red"        "#3a1418" "#5e1c22" "#8a2a2e" "#b43c3a" "#d85a4c"
    ramp "wood"       "#1a120c" "#2a1c12" "#3c2a1a" "#523a24" "#6a4e30"
    ramp "sail"       "#5a5a64" "#7c7c86" "#a2a2aa" "#c8c8cc" "#ececee"
    ramp "lamp"       "#a8702c" "#f0b450" "#ffe08a" "#fff8e0"
    ramp "ink"        "#080a10"
    twin "sky" beam="sky-beam"
    twin "dusk" beam="dusk-beam"
    twin "cloud" beam="cloud-beam"
    twin "sea" beam="sea-beam"
    twin "rock" beam="rock-beam"
}

scene "lighthouse-harbor" palette=harbor width=192 height=128 fps=12 duration="4s" loop=#true seed=8 background=sky.base {
    ambient darkness=1 occlusion=1 key-light=200
    wind strength=1 gust=0.5 speed=4

    // Sky: a dusk band low on the horizon, the moon and stars
    layer "sky" parallax=0 {
        rect 0 0 "100%" 60 paint=sky.deep gradient=down gradient-steps=3
        rect 0 58 "100%" 14 paint=dusk.shade gradient=down gradient-steps=2
        ellipse 150 12 10 10 paint=sail.hi emissive=#true
        rect 20 8 1 1 paint=sail.lit emissive=#true
        rect 62 18 1 1 paint=sail.lit emissive=#true
        rect 88 6 1 1 paint=sail.hi emissive=#true visible="=1 - pulse(1s, 0.2)"
        rect 112 24 1 1 paint=sail.lit emissive=#true
        rect 176 30 1 1 paint=sail.lit emissive=#true
        rect 134 4 1 1 paint=sail.hi emissive=#true visible="=1 - pulse(1.33s, 0.15)"
    }

    // Clouds drift back and forth at their own depth
    layer "clouds" parallax=0.2 {
        blob "=60 + osc(4s, -4, 4)" 26 circles="0,0,6 8,-3,7 17,0,6 25,2,4" smooth=4 paint=cloud.base shading=dome
        blob "=124 + osc(4s, 3, -3)" 40 circles="0,0,4 7,-2,5 14,1,4" paint=cloud.shade shading=dome
        blob "=170 + osc(4s, -2, 2)" 18 circles="0,0,3 6,-1,4 11,1,3" paint=cloud.lit shading=dome
    }

    // The sea with drifting wave highlights
    rect "sea" 0 72 "100%" 56 paint=sea.base gradient=down gradient-steps=-2
    rect "=96 + osc(4s, -3, 3)" 78 10 1 paint=sea.hi
    rect "=140 + osc(4s, 2, -2)" 84 14 1 paint=sea.lit
    rect "=70 + osc(2s, -2, 2)" 92 8 1 paint=sea.lit
    rect "=118 + osc(2s, 3, -3)" 104 16 1 paint=sea.hi
    rect "=160 + osc(4s, -3, 3)" 116 12 1 paint=sea.lit
    rect "=84 + osc(4s, 2, -2)" 120 18 1 paint=sea.lit

    // Cliff, keeper's house and the lighthouse
    polygon "cliff" 0 48 points="0,6 14,0 30,4 46,12 58,26 64,40 60,80 0,80" paint=rock.base texture=0.35 texture-scale=3 shading=dome outline=selective casts-shadow=#true
    polygon 0 78 points="0,0 40,0 62,8 70,20 0,50" paint=rock.shade texture=0.3 texture-scale=4
    rect 40 46 16 12 paint=wall.base shading=dome outline=selective casts-shadow=#true
    polygon 38 38 points="10,0 20,8 0,8" paint=red.base shading=dome outline=selective
    rect 45 50 4 4 paint=lamp.lit emissive=#true
    polygon "tower" 16 14 points="6,0 18,0 22,40 2,40" paint=wall.lit shading=dome outline=selective casts-shadow=#true
    polygon 16 14 points="6,0 18,0 18.6,6 5.4,6" paint=red.base shading=dome
    polygon 16 14 points="4.2,18 19.8,18 20.4,24 3.6,24" paint=red.base shading=dome
    polygon 16 14 points="2.6,34 21.4,34 22,40 2,40" paint=red.base shading=dome
    rect 21 30 3 5 paint=lamp.base emissive=#true
    rect 19 6 10 8 paint=lamp.hi emissive=#true
    rect 18 4 12 2 paint=ink
    polygon 17 -2 points="7,0 14,6 0,6" paint=red.shade outline=selective
    light-point 24 10 reach=18 intensity=2
    light-cone "beam" 24 10 spread="26deg" reach=220 intensity=3.4 color=beam {
        anim angle loop="repeat" { k "0s" "-90deg"; k "4s" "270deg" }
    }

    // The dock: planks on posts, ropes sagging between them, a lamp at the end
    rect 112 88 80 4 paint=wood.lit shading=dome outline=selective casts-shadow=#true
    rect "=116 + $k*24" 92 3 14 paint=wood.shade casts-shadow=#true repeat=4
    rect "=116 + $k*24" 80 2 8 paint=wood.base repeat=3
    rope 117 81 141 81 sag=3 sway="=osc(4s, -0.5, 0.5)" paint=wood.hi
    rope 141 81 165 81 sag=3 sway="=osc(4s, 0.5, -0.5)" paint=wood.hi
    capsule 185 66 185 88 radius=1 paint=ink
    ellipse 182 63 7 5 paint=lamp.lit emissive=#true
    light-point 185 66 reach=34 intensity=2.2

    // Boats bobbing at anchor
    group "sailboat" {
        polygon "hull" 72 "=96 + osc(2s, -1, 1)" points="0,0 30,0 26,7 4,7" paint=red.base shading=dome outline=selective casts-shadow=#true
        line 87 "=@hull.y - 26" 87 "=@hull.y" paint=wood.shade
        polygon 88 "=@hull.y - 25" points="0,0 13,22 0,22" paint=sail.lit shading=dome outline=selective
        polygon 73 "=@hull.y - 20" points="13,0 13,18 0,18" paint=sail.base shading=dome outline=selective
        ellipse 97 "=@hull.y - 4" 3 3 paint=lamp.hi emissive=#true
        light-point 98 "=@hull.y - 3" reach=16 intensity=1.6
    }
    group "rowboat" {
        polygon "dinghy" 138 "=108 + osc(2s, 1, -1)" points="0,0 20,0 17,5 3,5" paint=wood.lit shading=dome outline=selective casts-shadow=#true
        rope 141 "=@dinghy.y" 141 106 sag=-2 paint=wood.hi
        line "=@dinghy.x + 4" "=@dinghy.y - 1" "=@dinghy.x + 16" "=@dinghy.y - 1" paint=wood.hi
    }

    // Gulls circling over the water
    line "gull" "=120 + osc(4s, -24, 24)" "=30 + osc(2s, -3, 3)" "=@self.x1 + 3" "=@self.y1 + 1 + on2(square(t * 3))" paint=sail.hi
    line "=@gull.x2" "=@gull.y2" "=@gull.x1 + 6" "=@gull.y1" paint=sail.hi
    line "gull2" "=80 + osc(4s, 18, -18)" "=40 + osc(2s, 2, -2)" "=@self.x1 + 2" "=@self.y1 + 1 + on2(square(t * 3 + 0.5))" paint=sail.lit
    line "=@gull2.x2" "=@gull2.y2" "=@gull2.x1 + 4" "=@gull2.y1" paint=sail.lit

    reflection 0 72 192 56 axis=72 on=sea
}

        ......dbbbbbbd..
        .....diibbbbd...
        ....diiiibbd....
        ...diiiiiid.....
        ..diiiiiid......
        ..diiiiid.......
        ...diiid........
        ....ddd..iiiii..
        ................
        ................
        ................
        """
    }
}


// A dragonfly seen from above: it hovers, darts to a new spot, hovers again and darts back.
// Its wings blur between two positions; its shadow falls on the water below. Every 3 s.

use "pond-palette.kdl"

scene "dragonfly" palette=pond width=64 height=40 fps=12 duration="3s" loop=#true background=water.base {
    camera -20 -20

    group "body" {
        anim x { k "0s" 0; k "0.8s" 1; k "1s" 28 interp="ease-out"; k "2.2s" 27; k "2.4s" 0 interp="ease-out"; k "3s" 0 }
        anim y { k "0s" 0; k "0.8s" -1; k "1s" -6 interp="ease-out"; k "2.2s" -5; k "2.4s" 0 interp="ease-out"; k "3s" 0 }
    }
    shade "=@body.x - 2" "=@body.y + 10" 12 3 round=#true

    ellipse "=@body.x - 1" "=@body.y - 7" 6 7 paint=dragonfly.hi opacity=0.55 visible="=square(t * 12)"
    ellipse "=@body.x - 1" "=@body.y + 1" 6 7 paint=dragonfly.hi opacity=0.55 visible="=square(t * 12)"
    ellipse "=@body.x + 1" "=@body.y - 6" 4 6 paint=dragonfly.lit opacity=0.5 visible="=1 - square(t * 12)"
    ellipse "=@body.x + 1" "=@body.y + 1" 4 6 paint=dragonfly.lit opacity=0.5 visible="=1 - square(t * 12)"
    capsule "=@body.x - 9" "=@body.y" "=@body.x + 3" "=@body.y" radius=0.8 paint=dragonfly.base
    ellipse "=@body.x + 3" "=@body.y - 1" 3 3 paint=dragonfly.lit outline=full outline-paint=ink
}

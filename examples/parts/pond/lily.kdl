// A lily pad floating on the pond, its center at (0, 0), with a notch and veins.

use "pond-palette.kdl"

motif pond-vein dx dy { line "=@drift.x" "=@drift.y" "=@drift.x + $dx" "=@drift.y + $dy" paint=pad.lit }
motif pond-petal points { polygon "=@drift.x" "=@drift.y" points="0.0,0.0 $points" paint=lotus shading=dome outline=selective visible="=$flower" }
motif pond-petal-lit points { polygon "=@drift.x" "=@drift.y" points="0.0,0.0 $points" paint=lotus.lit shading=dome visible="=$flower" }
motif pond-bud points { polygon "=@drift.x" "=@drift.y" points="0.0,0.0 $points" paint=lotus.hi visible="=$flower" }

scene lily palette=pond width=28 height=28 fps=12 duration="4s" loop=#true background=water.base {
    param flower #false
    camera -14 -14

    group drift "=osc(4s, -0.6, 0.6)" "=osc(4s, 0.4, -0.4)"
    shade "=@drift.x - 7" "=@drift.y - 5" 19 18 round=#true
    polygon "pad" "=@drift.x" "=@drift.y" points="0.0,0.0 9.0,0.0 5.3,7.3 2.8,8.6 0.0,9.0 -2.8,8.6 -5.3,7.3 -7.3,5.3 -8.6,2.8 -9.0,0.0 -8.6,-2.8 -7.3,-5.3 -5.3,-7.3 -2.8,-8.6 -0.0,-9.0 2.8,-8.6 5.3,-7.3 7.3,-5.3 8.6,-2.8" paint=pad shading=dome outline=selective
    pond-vein 3.0 5.2
    pond-vein -3.4 4.9
    pond-vein -5.9 -1.0
    pond-vein -1.6 -5.8
    pond-vein 4.6 -3.9
    rect "=@drift.x - 4" "=@drift.y - 5" 2 1 paint=pad.hi tone-shift="=-round(osc(4s, 0, 1))"
    pond-petal "0.5,2.6 4.4,2.9 7.9,1.4 5.1,-1.2 1.3,-2.2"
    pond-petal "-1.4,2.2 1.1,5.1 4.6,6.6 4.5,2.7 2.5,-0.6"
    pond-petal "-2.6,0.5 -2.9,4.4 -1.4,7.9 1.2,5.1 2.2,1.3"
    pond-petal "-2.2,-1.4 -5.1,1.1 -6.6,4.6 -2.7,4.5 0.6,2.5"
    pond-petal "-0.5,-2.6 -4.4,-2.9 -7.9,-1.4 -5.1,1.2 -1.3,2.2"
    pond-petal "1.4,-2.2 -1.1,-5.1 -4.6,-6.6 -4.5,-2.7 -2.5,0.6"
    pond-petal "2.6,-0.5 2.9,-4.4 1.4,-7.9 -1.2,-5.1 -2.2,-1.3"
    pond-petal "2.2,1.4 5.1,-1.1 6.6,-4.6 2.7,-4.5 -0.6,-2.5"
    pond-petal-lit "-0.5,2.1 1.7,3.3 4.5,3.2 3.7,0.5 1.8,-1.2"
    pond-petal-lit "-2.1,0.6 -2.0,3.1 -0.5,5.5 1.5,3.4 2.0,1.0"
    pond-petal-lit "-1.6,-1.5 -3.7,-0.2 -5.0,2.3 -2.2,3.0 0.1,2.2"
    pond-petal-lit "0.5,-2.1 -1.7,-3.3 -4.5,-3.2 -3.7,-0.5 -1.8,1.2"
    pond-petal-lit "2.1,-0.6 2.0,-3.1 0.5,-5.5 -1.5,-3.4 -2.0,-1.0"
    pond-petal-lit "1.6,1.5 3.7,0.2 5.0,-2.3 2.2,-3.0 -0.1,-2.2"
    pond-bud "-1.0,1.2 -0.1,2.5 1.8,3.0 2.2,1.2 1.6,-0.2"
    pond-bud "-1.2,-1.0 -2.5,-0.1 -3.0,1.7 -1.2,2.2 0.2,1.6"
    pond-bud "1.0,-1.2 0.1,-2.5 -1.8,-3.0 -2.2,-1.2 -1.6,0.2"
    pond-bud "1.2,1.0 2.5,0.1 3.0,-1.8 1.2,-2.2 -0.2,-1.6"
    ellipse "=@drift.x - 1.5" "=@drift.y - 1.5" 4 4 paint=heart.base shading=dome visible="=$flower"
    rect "=@drift.x" "=@drift.y - 1" 1 1 paint=heart.hi visible="=$flower"
}

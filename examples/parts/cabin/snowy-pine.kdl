// A pine weighed down with snow, its foot at (0, 0).

use "cabin-palette.kdl"

scene snowy-pine palette=aurora width=40 height=56 fps=12 duration="6s" loop=#true background=sky.base {
    camera -20 -52

    rect -2 -8 4 8 paint=log.shade
    polygon -16 -24 points="16,0 32,16 0,16" paint=pine shading=dome outline=selective
    polygon -13 -34 points="13,0 26,14 0,14" paint=pine shading=dome outline=selective
    polygon -10 -43 points="10,0 20,12 0,12" paint=pine shading=dome outline=selective
    polygon "=-7 + round(osc(6s, -0.6, 0.6))" -51 points="7,0 14,10 0,10" paint=pine shading=dome outline=selective
    polygon -15 -10 points="0,0 10,-4 20,-3 30,0 22,1 8,1" paint=snow.lit shading=dome
    polygon -12 -21 points="0,0 8,-4 16,-3 24,0 17,1 6,1" paint=snow.lit shading=dome
    polygon -9 -32 points="0,0 6,-3 12,-3 18,0 12,1 5,1" paint=snow.hi shading=dome
    polygon "=-6 + round(osc(6s, -0.6, 0.6))" -42 points="0,0 4,-3 8,-3 12,0 8,1 3,1" paint=snow.hi
}
